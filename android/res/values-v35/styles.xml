<resources>
    <style name="StudioTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101010</item>
        <item name="android:statusBarColor">#101010</item>
        <item name="android:navigationBarColor">#101010</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
