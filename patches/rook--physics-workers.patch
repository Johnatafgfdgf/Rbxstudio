@@ -82,3 +82,17 @@ fn unchosen() -> Platform {
 fn unchosen() -> Platform {
     panic!("no platform: the app installs one, or turns on rook-platform's `native` feature")
 }
+
+/// A physics host can supply workers without installing unrelated desktop
+/// clipboard, credential or networking services.
+static WORKERS: OnceLock<Box<dyn Workers>> = OnceLock::new();
+
+pub fn install_workers(workers: Box<dyn Workers>) -> Result<(), Box<dyn Workers>> {
+    WORKERS.set(workers)
+}
+
+pub fn workers() -> &'static dyn Workers {
+    WORKERS
+        .get()
+        .map_or_else(|| get().workers.as_ref(), |w| w.as_ref())
+}
