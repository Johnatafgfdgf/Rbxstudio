+    /// Android/native embedding: keep the original streaming renderer and
+    /// editing APIs, but present directly to a surface without CPU readback.
+    pub fn for_surface(
+        dom: &WeakDom,
+        instance: &wgpu::Instance,
+        surface: &wgpu::Surface<'_>,
+        width: u32,
+        height: u32,
+        quality: QualityLevel,
+    ) -> Result<(Self, wgpu::Device, wgpu::Queue, wgpu::SurfaceConfiguration), String> {
+        let adapter = crate::gpu::adapter(instance, Some(surface))?;
+        let (device, queue) = crate::gpu::device(&adapter)?;
+        let mut config = surface
+            .get_default_config(&adapter, width.max(1), height.max(1))
+            .ok_or_else(|| "surface has no compatible configuration".to_owned())?;
+        let caps = surface.get_capabilities(&adapter);
+        if let Some(format) = caps.formats.iter().find(|f| f.is_srgb()) {
+            config.format = *format;
+        }
+        config.view_formats = vec![];
+        config.present_mode = wgpu::PresentMode::Fifo;
+        config.desired_maximum_frame_latency = 2;
+        surface.configure(&device, &config);
+        let toggles = Toggles {
+            textures: true,
+            materials: true,
+            lights: true,
+            clock_time: None,
+            show_development_gui: false,
+        };
+        let headless = Self::build_on(
+            dom,
+            toggles,
+            ReflectionDatabase::embedded(),
+            View::default(),
+            Some((
+                device.clone(),
+                queue.clone(),
+                wgpu::TextureFormat::Rgba8UnormSrgb,
+                quality,
+            )),
+        )?;
+        Ok((headless, device, queue, config))
+    }
+
+    /// The texture must be Rgba8UnormSrgb with a Rgba8Unorm view for GUI compositing.
+    pub fn draw_to_surface_texture(&mut self, texture: &wgpu::Texture, width: u32, height: u32) {
+        self.offscreen.set_elapsed(self.start.elapsed());
+        let from = self.from;
+        self.offscreen.with_renderer(|renderer, device, queue| {
+            renderer.draw(device, queue, texture, (width.max(1), height.max(1)), from);
+        });
+    }
