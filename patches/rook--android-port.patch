+//! Opt-in, touch-only evidence from the actual Rook GUI signal emission.
+//! This is NOT a synthetic tap or a proof that a user's Luau callback ran.
+use std::sync::{Arc, Mutex};
+
+type Listener = Arc<dyn Fn(&str, u32, u32, u32, u32, u32, u32) + Send + Sync + 'static>;
+static LISTENER: Mutex<Option<Listener>> = Mutex::new(None);
+
+/// The isolated Android player process installs this listener only with
+/// explicit one-shot consent. No other host starts diagnostics.
+pub fn install(listener: Option<Arc<dyn Fn(&str, u32, u32, u32, u32, u32, u32) + Send + Sync + 'static>>) {
+    if let Ok(mut current) = LISTENER.lock() {
+        *current = listener;
+    }
+}
+
+pub(crate) fn enabled() -> bool {
+    LISTENER.lock().is_ok_and(|current| current.is_some())
+}
+
+/// Reports only *after* GUI touch handling fires the Activated event.
+pub(crate) fn activated(path: &str, queued: u32, attempted: u32,
+        completed: u32, unresolved: u32, failed: u32, errors: u32) {
+    let listener = LISTENER.lock().ok().and_then(|current| current.clone());
+    if let Some(listener) = listener {
+        listener(path, queued, attempted, completed, unresolved, failed, errors);
+    }
+}
