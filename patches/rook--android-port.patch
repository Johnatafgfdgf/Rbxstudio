diff --git a/crates/rook-lua/src/signal_probe.rs b/crates/rook-lua/src/signal_probe.rs
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/crates/rook-lua/src/signal_probe.rs
@@ -0,0 +1,94 @@
+//! Opt-in, single-touch GUI Luau handler dispatch diagnostics on Android.
+//! No source collection, no hook injection, and no claim of script completion.
+use std::{cell::RefCell, collections::HashSet};
+use crate::signal::{ConnectionId, SignalKey, SignalKind};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DispatchStats {
+    pub queued: u32,
+    pub attempted: u32,
+    pub errors: u32,
+    pub completed: u32,
+    pub unresolved: u32,
+    pub failed: u32,
+}
+
+#[derive(Default)]
+struct Capture {
+    stats: DispatchStats,
+    pending: HashSet<ConnectionId>,
+}
+
+thread_local! {
+    static ACTIVE: RefCell<Option<Capture>> = const { RefCell::new(None) };
+}
+
+/// The caller surrounds only its real touch-originated Activated firing.
+pub fn capture<T>(execute: impl FnOnce() -> T) -> (T, DispatchStats) {
+    struct Restore(Option<Capture>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            ACTIVE.with(|active| {
+                *active.borrow_mut() = self.0.take();
+            });
+        }
+    }
+    let previous = ACTIVE.with(|a| a.borrow_mut().replace(Capture::default()));
+    let restore = Restore(previous);
+    let result = execute();
+    let stats = ACTIVE.with(|a| {
+        a.borrow().as_ref().map(|c| c.stats).unwrap_or_default()
+    });
+    drop(restore);
+    (result, stats)
+}
+
+pub(crate) fn observes(key: &SignalKey) -> bool {
+    matches!(key.kind, SignalKind::Event("Activated"))
+        && ACTIVE.with(|a| a.borrow().is_some())
+}
+
+pub(crate) fn queued(connection: ConnectionId) {
+    ACTIVE.with(|a| {
+        if let Some(c) = a.borrow_mut().as_mut() {
+            if c.pending.insert(connection) {
+                c.stats.queued = c.stats.queued.saturating_add(1);
+            }
+        }
+    });
+}
+
+/// Deferred handlers execute later and cannot be confirmed here.
+pub(crate) fn attempted(connection: ConnectionId) -> bool {
+    ACTIVE.with(|a| {
+        if let Some(c) = a.borrow_mut().as_mut() {
+            if c.pending.remove(&connection) {
+                c.stats.attempted = c.stats.attempted.saturating_add(1);
+                return true;
+            }
+        }
+        false
+    })
+}
+
+/// First synchronous resumption: completed / unresolved / failed.
+pub(crate) fn finished(outcome: Option<bool>) {
+    ACTIVE.with(|a| {
+        if let Some(c) = a.borrow_mut().as_mut() {
+            let item = match outcome {
+                Some(true) => &mut c.stats.completed,
+                Some(false) => &mut c.stats.unresolved,
+                None => &mut c.stats.failed,
+            };
+            *item = item.saturating_add(1);
+        }
+    });
+}
+
+pub(crate) fn error() {
+    ACTIVE.with(|a| {
+        if let Some(c) = a.borrow_mut().as_mut() {
+            c.stats.errors = c.stats.errors.saturating_add(1);
+        }
+    });
+}
