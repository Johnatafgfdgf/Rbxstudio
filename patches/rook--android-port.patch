diff --git a/apps/rook-player/src/android.rs b/apps/rook-player/src/android.rs
new file mode 100644
index 0000000..8de275a
--- /dev/null
+++ b/apps/rook-player/src/android.rs
@@ -0,0 +1,153 @@
+//! Android lifecycle host for the original player. The original Game, server
+//! thread, SceneCache, Renderer, audio mixer and frame loop are reused directly.
+use crate::*;
+use std::sync::mpsc::{self, Receiver, TryRecvError};
+use winit::platform::android::{activity::AndroidApp, EventLoopBuilderExtAndroid};
+
+pub struct Resources {
+    pub content: Arc<Resolver>,
+    pub core_scripts: Arc<rook_engine::core_scripts::CorePatch>,
+    install: Installed,
+}
+
+impl Resources {
+    /// The host calls this on its resource worker; font/material discovery may
+    /// fetch official packages and must not block Android lifecycle events.
+    pub fn new(content: Arc<Resolver>, core_scripts: Arc<rook_engine::core_scripts::CorePatch>) -> Self {
+        let install = Installed::find(&content);
+        Self { content, core_scripts, install }
+    }
+}
+
+struct AndroidLaunch {
+    args: Option<Args>,
+    resources: Receiver<anyhow::Result<Resources>>,
+    launch: Option<Launch>,
+    active: bool,
+    failed: Option<anyhow::Error>,
+    presented: bool,
+    on_presented: Box<dyn Fn() + Send>,
+    // Counts only winit events from the opt-in native session; no coordinates.
+    native_touch_down: u32,
+    native_touch_up: u32,
+    native_touch_cancel: u32,
+    on_native_touch: Option<Box<dyn Fn(u32, u32, u32) + Send>>,
+}
+
+impl AndroidLaunch {
+    fn prepare(&mut self, event_loop: &ActiveEventLoop) {
+        if self.launch.is_some() || self.failed.is_some() { return; }
+        let resources = match self.resources.try_recv() {
+            Ok(resources) => resources,
+            Err(TryRecvError::Empty) => return,
+            Err(TryRecvError::Disconnected) => Err(anyhow::anyhow!("O preparo dos recursos foi interrompido")),
+        };
+        let result = resources.and_then(|resources| {
+            let args = self.args.take().expect("one Android launch");
+            let setup = game::Setup {
+                play: true, content: resources.content.clone(), script: None,
+                wait_for_sounds: false, core_scripts: Some(resources.core_scripts),
+                user_settings: rook_engine::data_folder::DataDir::locate().map(|d| d.user_settings()),
+            };
+            let install = resources.install;
+            let loading = game::Loading::begin(&args.place, &setup)?;
+            let player = PlayerSettings::load(setup.user_settings.as_deref());
+            let mut launch = Launch::new(args, setup, install, loading, player);
+            if self.active { launch.resumed(event_loop); }
+            Ok(launch)
+        });
+        match result {
+            Ok(launch) => self.launch = Some(launch),
+            Err(error) => { self.failed = Some(error); event_loop.exit(); }
+        }
+    }
+}
+
+impl ApplicationHandler for AndroidLaunch {
+    fn resumed(&mut self, event_loop: &ActiveEventLoop) {
+        self.active = true;
+        if let Some(launch) = &mut self.launch { launch.resumed(event_loop); }
+    }
+    fn suspended(&mut self, event_loop: &ActiveEventLoop) {
+        self.active = false;
+        if let Some(launch) = &mut self.launch { launch.suspended(event_loop); }
+    }
+    fn window_event(&mut self, event_loop: &ActiveEventLoop, id: WindowId, event: WindowEvent) {
+        // winit's Android NativeActivity backend receives AInputQueue touch
+        // events. Observe phases ONLY after the first frame and ONLY for a
+        // one-use, user-authorized session; never consume or synthesize input.
+        if self.presented && self.on_native_touch.is_some() {
+            if let WindowEvent::Touch(touch) = &event {
+                let changed = match touch.phase {
+                    winit::event::TouchPhase::Started => {
+                        self.native_touch_down = self.native_touch_down.saturating_add(1).min(100000);
+                        true
+                    }
+                    winit::event::TouchPhase::Ended => {
+                        self.native_touch_up = self.native_touch_up.saturating_add(1).min(100000);
+                        true
+                    }
+                    winit::event::TouchPhase::Cancelled => {
+                        self.native_touch_cancel = self.native_touch_cancel.saturating_add(1).min(100000);
+                        true
+                    }
+                    winit::event::TouchPhase::Moved => false,
+                };
+                if changed {
+                    if let Some(report) = &self.on_native_touch {
+                        report(self.native_touch_down, self.native_touch_up, self.native_touch_cancel);
+                    }
+                }
+            }
+        }
+        if let Some(launch) = &mut self.launch { launch.window_event(event_loop, id, event); }
+    }
+    fn device_event(&mut self, event_loop: &ActiveEventLoop, id: DeviceId, event: DeviceEvent) {
+        if let Some(launch) = &mut self.launch { launch.device_event(event_loop, id, event); }
+    }
+    fn about_to_wait(&mut self, event_loop: &ActiveEventLoop) {
+        self.prepare(event_loop);
+        if let Some(launch) = &mut self.launch {
+            launch.about_to_wait(event_loop);
+            if !self.presented && launch.has_presented() {
+                self.presented = true;
+                (self.on_presented)();
+            }
+        }
+        // Poll workers without a busy loop while Android has no surface.
+        if !self.active || self.launch.is_none() {
+            event_loop.set_control_flow(ControlFlow::WaitUntil(Instant::now() + Duration::from_millis(16)));
+        }
+    }
+}
+
+/// Resource IO runs on a worker after the native event loop starts, keeping
+/// NativeActivity's lifecycle callbacks responsive while packages are prepared.
+pub fn run(
+    app: AndroidApp,
+    place: PathBuf,
+    prepare: impl FnOnce() -> anyhow::Result<Resources> + Send + 'static,
+    on_presented: impl Fn() + Send + 'static,
+    observe_native_touch: bool,
+    on_native_touch: impl Fn(u32, u32, u32) + Send + 'static,
+) -> anyhow::Result<()> {
+    let (send, resources) = mpsc::channel();
+    std::thread::Builder::new().name("rook-android-resources".into()).spawn(move || {
+        let _ = send.send(prepare());
+    })?;
+    let args = Args::parse_from([std::ffi::OsString::from("rook-player"), place.into_os_string()]);
+    let event_loop = EventLoop::builder().with_android_app(app).build()?;
+    event_loop.set_control_flow(ControlFlow::Poll);
+    let mut host = AndroidLaunch {
+        args: Some(args), resources, launch: None, active: false, failed: None,
+        presented: false, on_presented: Box::new(on_presented),
+        native_touch_down: 0, native_touch_up: 0, native_touch_cancel: 0,
+        on_native_touch: observe_native_touch.then(|| Box::new(on_native_touch)
+            as Box<dyn Fn(u32, u32, u32) + Send>),
+    };
+    event_loop.run_app(&mut host)?;
+    if let Some(error) = host.failed { return Err(error); }
+    if let Some(launch) = host.launch { launch.finish()?; }
+    anyhow::ensure!(host.presented, "O player não conseguiu apresentar um quadro");
+    Ok(())
+}
