--- /dev/null
+++ b/crates/rook-engine/src/session/host/prompt_ui.luau
@@ -0,0 +1,95 @@
+-- Standard prompts for packages without the original prompt UI.
+local service = game:GetService("ProximityPromptService")
+local player = game:GetService("Players").LocalPlayer
+local tweenService = game:GetService("TweenService")
+local shown = {}
+
+local function hide(prompt)
+    local panel = shown[prompt]
+    if not panel then return end
+    shown[prompt] = nil
+    for _, connection in panel.connections do
+        connection:Disconnect()
+    end
+    panel.gui:Destroy()
+end
+
+service.PromptHidden:Connect(hide)
+service.PromptShown:Connect(function(prompt, inputType)
+    hide(prompt)
+    if prompt.Style ~= Enum.ProximityPromptStyle.Default then return end
+    local parent = prompt.Parent
+    local adornee = parent and (parent:IsA("Model") and parent.PrimaryPart or parent)
+    local playerGui = player:FindFirstChildOfClass("PlayerGui")
+    if not adornee or not playerGui then return end
+
+    local gui = Instance.new("BillboardGui")
+    gui.Name = "RbxMobilePrompt"
+    gui.Adornee = adornee
+    gui.Active = true
+    gui.AlwaysOnTop = true
+    gui.Size = UDim2.fromOffset(168, 64)
+    local button = Instance.new("TextButton")
+    button.Name = "PromptButton"
+    button.Size = UDim2.fromScale(1, 1)
+    button.Active = true
+    button.BackgroundColor3 = Color3.fromRGB(29, 30, 36)
+    button.BackgroundTransparency = 0.12
+    button.TextColor3 = Color3.fromRGB(250, 250, 255)
+    button.TextSize = 16
+    button.TextWrapped = true
+    button.Font = Enum.Font.SourceSansSemibold
+    button.Parent = gui
+    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)
+
+    local progress = Instance.new("Frame")
+    progress.AnchorPoint = Vector2.new(0, 1)
+    progress.Position = UDim2.fromScale(0, 1)
+    progress.Size = UDim2.fromOffset(0, 3)
+    progress.BorderSizePixel = 0
+    progress.BackgroundColor3 = Color3.fromRGB(165, 171, 255)
+    progress.Parent = button
+
+    local function update()
+        local prefix = if inputType == Enum.ProximityPromptInputType.Keyboard
+            then "[" .. prompt.KeyboardKeyCode.Name .. "] " else ""
+        local caption = prompt.ObjectText
+        button.Text = prefix .. prompt.ActionText .. (if caption ~= "" then "\n" .. caption else "")
+    end
+    local contact
+    local tween
+    button.InputBegan:Connect(function(input)
+        local kind = input.UserInputType
+        if contact or (kind ~= Enum.UserInputType.Touch and
+            (kind ~= Enum.UserInputType.MouseButton1 or not prompt.ClickablePrompt)) then
+            return
+        end
+        contact = input
+        prompt:InputHoldBegin()
+        if prompt.HoldDuration > 0 then
+            tween = tweenService:Create(progress, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear),
+                {Size = UDim2.new(1, 0, 0, 3)})
+            tween:Play()
+        end
+    end)
+    button.InputEnded:Connect(function(input)
+        if contact ~= input then return end
+        contact = nil
+        if tween then
+            tween:Cancel()
+            tween = nil
+        end
+        progress.Size = UDim2.fromOffset(0, 3)
+        prompt:InputHoldEnd()
+    end)
+    shown[prompt] = {
+        gui = gui,
+        connections = {
+            prompt:GetPropertyChangedSignal("ActionText"):Connect(update),
+            prompt:GetPropertyChangedSignal("ObjectText"):Connect(update),
+            prompt:GetPropertyChangedSignal("KeyboardKeyCode"):Connect(update),
+        },
+    }
+    update()
+    gui.Parent = playerGui
+end)
diff --git a/crates/rook-engine/src/session/host/prompts.rs b/crates/rook-engine/src/session/host/prompts.rs
new file mode 100644
index 0000000..2dadf6f
--- /dev/null
+++ b/crates/rook-engine/src/session/host/prompts.rs
@@ -0,0 +1,335 @@
+//! Proximity prompt visibility and hold lifecycles. The server owns its
+//! timer and validates the real character's range independently.
+use std::collections::HashSet;
+
+use glam::Vec3;
+use rook_dom::{Change, Dom, InstanceId};
+use rook_lua::{Lens, Runtime};
+use rook_physics::Filter;
+use rook_types::UserInputType;
+
+use crate::{DataModel, bridges::journal_watch::JournalWatch};
+
+struct Target {
+    owner: InstanceId,
+    position: Vec3,
+    distance_squared: f32,
+    duration: f64,
+}
+
+fn target(dom: &Dom, prompt: InstanceId, player: InstanceId) -> Option<Target> {
+    let workspace = dom.find_service("Workspace")?;
+    let character = dom.ref_property(player, "Character")?;
+    let humanoid = dom.find_first_child_of_class(character, "Humanoid")?;
+    if !dom.is_a(prompt, "ProximityPrompt")
+        || !dom.is_ancestor_of(workspace, prompt)
+        || dom.bool_property(prompt, "Enabled") == Some(false)
+        || dom.float_property(humanoid, "Health").is_some_and(|hp| hp <= 0.0)
+        || dom.find_service("ProximityPromptService")
+            .is_some_and(|id| dom.bool_property(id, "Enabled") == Some(false))
+    {
+        return None;
+    }
+    let root = rook_lua::humanoid_root(dom, humanoid)?;
+    let from = dom.cframe_property(root, "CFrame")?.position;
+    let parent = dom.parent(prompt)?;
+    let (owner, position) = if dom.is_a(parent, "Attachment") {
+        let (part, local) = dom.attachment_placement(parent)?;
+        (part, (dom.cframe_property(part, "CFrame")? * local).position)
+    } else {
+        let part = if dom.is_a(parent, "Model") {
+            dom.ref_property(parent, "PrimaryPart")?
+        } else {
+            parent
+        };
+        if !dom.is_a(part, "BasePart") {
+            return None;
+        }
+        (parent, dom.cframe_property(part, "CFrame")?.position)
+    };
+    let distance_squared = from.distance_squared(position);
+    let max = dom.float_property(prompt, "MaxActivationDistance").unwrap_or(10.0);
+    if !distance_squared.is_finite() || !max.is_finite() || max < 0.0
+        || distance_squared > max * max
+    {
+        return None;
+    }
+    Some(Target {
+        owner,
+        position,
+        distance_squared,
+        duration: dom.float_property(prompt, "HoldDuration")
+            .filter(|v| v.is_finite() && *v >= 0.0).unwrap_or(0.0).into(),
+    })
+}
+
+fn fire(rt: &Runtime, id: InstanceId, player: InstanceId, event: &'static str, global: &'static str) {
+    let service = rt.world().dom.find_service("ProximityPromptService");
+    let Ok(player) = rt.push_instance(player) else { return };
+    rt.fire_event(id, event, player.clone());
+    if let Some(service) = service && let Ok(prompt) = rt.push_instance(id) {
+        rt.fire_event(service, global, (prompt, player));
+    }
+}
+
+#[derive(Debug)]
+struct ActiveHold {
+    prompt: InstanceId,
+    player: InstanceId,
+    started: f64,
+    duration: f64,
+    triggered: bool,
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Hold(Option<ActiveHold>);
+
+impl Hold {
+    pub(super) fn input(&mut self, dm: &DataModel, player: InstanceId, prompt: InstanceId, down: bool) -> bool {
+        let rt = dm.runtime();
+        if !down {
+            if self.0.as_ref().is_some_and(|h| h.prompt == prompt) {
+                self.advance(dm);
+                self.end(rt);
+                return true;
+            }
+            return false;
+        }
+        if self.0.is_some() {
+            return false;
+        }
+        let Some(t) = target(&rt.world().dom, prompt, player) else { return false };
+        self.0 = Some(ActiveHold {
+            prompt, player, started: dm.now(), duration: t.duration, triggered: false,
+        });
+        if t.duration > 0.0 {
+            fire(rt, prompt, player, "PromptButtonHoldBegan", "PromptButtonHoldBegan");
+        }
+        self.advance(dm);
+        true
+    }
+
+    pub(super) fn advance(&mut self, dm: &DataModel) {
+        let Some(hold) = &mut self.0 else { return };
+        let rt = dm.runtime();
+        if target(&rt.world().dom, hold.prompt, hold.player).is_none() {
+            self.end(rt);
+        } else if !hold.triggered && dm.now() + 1e-9 >= hold.started + hold.duration {
+            hold.triggered = true;
+            fire(rt, hold.prompt, hold.player, "Triggered", "PromptTriggered");
+        }
+    }
+
+    fn end(&mut self, rt: &Runtime) {
+        let Some(hold) = self.0.take() else { return };
+        if hold.duration > 0.0 {
+            fire(rt, hold.prompt, hold.player, "PromptButtonHoldEnded", "PromptButtonHoldEnded");
+        }
+        if hold.triggered {
+            fire(rt, hold.prompt, hold.player, "TriggerEnded", "PromptTriggerEnded");
+        }
+    }
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct Index {
+    watch: JournalWatch,
+    known: HashSet<InstanceId>,
+    drags: HashSet<InstanceId>,
+}
+
+impl Index {
+    pub(crate) fn reset(&mut self, cursor: u64) {
+        self.watch.rescan(cursor);
+        self.known.clear();
+        self.drags.clear();
+    }
+
+    pub(crate) fn has_drags(&self) -> bool {
+        !self.drags.is_empty()
+    }
+
+    pub(crate) fn update(&mut self, dom: &Dom) {
+        let (first, changes) = self.watch.look(dom);
+        if first {
+            for id in dom.descendants(dom.root()) {
+                if dom.is_a(id, "ProximityPrompt") {
+                    self.known.insert(id);
+                } else if dom.is_a(id, "DragDetector") {
+                    self.drags.insert(id);
+                }
+            }
+        }
+        for change in changes {
+            match *change {
+                Change::Created(id) if dom.is_a(id, "ProximityPrompt") => {
+                    self.known.insert(id);
+                }
+                Change::Created(id) if dom.is_a(id, "DragDetector") => {
+                    self.drags.insert(id);
+                }
+                Change::Destroyed(id) | Change::Collected(id) => {
+                    self.known.remove(&id);
+                    self.drags.remove(&id);
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Prompts {
+    shown: Vec<InstanceId>,
+    input_type: Option<&'static str>,
+    next_update: f64,
+    hold: Hold,
+    key: Option<String>,
+}
+
+impl Prompts {
+    pub(super) fn update(&mut self, dm: &DataModel) -> Option<InstanceId> {
+        if dm.runtime().menu_is_open() {
+            return self.cancel(dm);
+        }
+        if dm.now() + 1e-9 < self.next_update {
+            self.hold.advance(dm);
+            return None;
+        }
+        self.next_update = dm.now() + 0.05;
+        let (shown, kind) = self.visible(dm);
+        let rt = dm.runtime();
+        let previous = std::mem::replace(&mut self.shown, shown);
+        let input_changed = self.input_type.replace(kind) != Some(kind);
+        let service = rt.world().dom.find_service("ProximityPromptService");
+        for id in &previous {
+            if input_changed || !self.shown.contains(id) {
+                rt.fire_event(*id, "PromptHidden", ());
+                if let Some(service) = service && let Ok(prompt) = rt.push_instance(*id) {
+                    rt.fire_event(service, "PromptHidden", prompt);
+                }
+            }
+        }
+        for id in &self.shown {
+            if input_changed || !previous.contains(id) {
+                rt.show_proximity_prompt(*id, kind);
+            }
+        }
+        let hidden = self.hold.0.as_ref().filter(|h| !self.shown.contains(&h.prompt)).map(|h| h.prompt);
+        if hidden.is_some() {
+            self.key = None;
+            self.hold.end(rt);
+        } else {
+            self.hold.advance(dm);
+        }
+        rt.drain_deferred();
+        hidden
+    }
+
+    fn visible(&self, dm: &DataModel) -> (Vec<InstanceId>, &'static str) {
+        let camera = dm.current_camera();
+        let mut world = dm.runtime().world_mut();
+        let w = &mut *world;
+        let dom = &mut w.dom;
+        let kind = match w.input.last_type {
+            Some(UserInputType::Touch) => "Touch",
+            Some(_) => "Keyboard",
+            None if dom.find_service("UserInputService")
+                .is_some_and(|id| dom.bool_property(id, "TouchEnabled") == Some(true)) => "Touch",
+            None => "Keyboard",
+        };
+        let Some((player, camera)) = dom.local_player().zip(camera) else {
+            return (Vec::new(), kind);
+        };
+        if dm.prompt_index.known.is_empty() {
+            return (Vec::new(), kind);
+        }
+        let lens = Lens::of(dom, camera);
+        let max = dom.find_service("ProximityPromptService")
+            .and_then(|id| dom.number_property(id, "MaxPromptsVisible")).unwrap_or(16.0) as usize;
+        let filter = Filter {
+            ignore_water: true,
+            ..Filter::legacy_ray(dom.ref_property(player, "Character").into_iter().collect(), false)
+        };
+        let mut candidates = Vec::new();
+        for &id in &dm.prompt_index.known {
+            let Some(t) = target(dom, id, player) else { continue };
+            let (screen, on_screen) = rook_lua::project_point(&lens, t.position);
+            if !on_screen {
+                continue;
+            }
+            if dom.bool_property(id, "RequiresLineOfSight") != Some(false)
+                && w.physics.raycast(dom, lens.cframe.position, t.position - lens.cframe.position, &filter)
+                    .is_some_and(|hit| hit.part != t.owner && !dom.is_ancestor_of(t.owner, hit.part))
+            {
+                continue;
+            }
+            let center = (screen.truncate() / lens.viewport - glam::Vec2::splat(0.5)).length_squared();
+            candidates.push((center, t.distance_squared, id));
+        }
+        candidates.sort_unstable_by(|a, b| a.0.total_cmp(&b.0)
+            .then(a.1.total_cmp(&b.1)).then(a.2.cmp(&b.2)));
+        let mut keys = HashSet::new();
+        let mut global = false;
+        let mut shown = Vec::new();
+        for (_, _, id) in candidates {
+            if shown.len() >= max { break }
+            match dom.enum_item_property(id, "Exclusivity") {
+                Some("AlwaysShow") => {}
+                Some("OneGlobally") => {
+                    if std::mem::replace(&mut global, true) { continue }
+                }
+                _ => {
+                    let key = dom.enum_item_property(id, "KeyboardKeyCode").unwrap_or("E");
+                    if !keys.insert(key) { continue }
+                }
+            }
+            shown.push(id);
+        }
+        (shown, kind)
+    }
+
+    pub(super) fn input(&mut self, dm: &DataModel, prompt: InstanceId, down: bool) -> bool {
+        if down && (!self.shown.contains(&prompt) || dm.runtime().menu_is_open()) {
+            return false;
+        }
+        let Some(player) = dm.runtime().world().dom.local_player() else { return false };
+        let accepted = self.hold.input(dm, player, prompt, down);
+        if accepted && !down {
+            self.key = None;
+        }
+        dm.runtime().drain_deferred();
+        accepted
+    }
+
+    pub(super) fn cancel(&mut self, dm: &DataModel) -> Option<InstanceId> {
+        let id = self.hold.0.as_ref()?.prompt;
+        self.hold.end(dm.runtime());
+        self.key = None;
+        Some(id)
+    }
+
+    pub(super) fn key(&mut self, dm: &DataModel, code: &str, down: bool) -> Option<InstanceId> {
+        let prompt = if down {
+            if dm.input_processed() || dm.runtime().menu_is_open() {
+                return None;
+            }
+            let w = dm.runtime().world();
+            self.shown.iter().copied().find(|&id| {
+                w.dom.enum_item_property(id, "KeyboardKeyCode").unwrap_or("E") == code
+            })?
+        } else {
+            if self.key.as_deref() != Some(code) {
+                return None;
+            }
+            self.hold.0.as_ref()?.prompt
+        };
+        if !self.input(dm, prompt, down) {
+            return None;
+        }
+        if down {
+            self.key = Some(code.to_owned());
+        }
+        Some(prompt)
+    }
+}
