+//! Authored clips share the content loader and drive Motor6D.Transform
+//! before physics. Old poses are restored after the final layer fades.
+use std::collections::{HashMap, HashSet};
+
+use rook_content::{ContentRef, Failure, Fetched, Loader, Ticket};
+use rook_dom::InstanceId;
+use rook_lua::Runtime;
+use rook_types::{CFrame, Value};
+
+use crate::locomotion::clips::Clip;
+
+#[derive(Debug, Default)]
+pub(crate) struct Animations {
+    pending: HashMap<Ticket, ContentRef>,
+    clips: HashMap<ContentRef, Option<Clip>>,
+    applied: HashMap<InstanceId, (CFrame, CFrame)>,
+}
+
+enum Event {
+    Named(InstanceId, &'static str),
+    Marker(InstanceId, String, String),
+}
+
+impl Animations {
+    pub(crate) fn pending(&self) -> bool {
+        !self.pending.is_empty()
+    }
+
+    pub(crate) fn requests(&mut self, rt: &Runtime) -> Vec<ContentRef> {
+        let mut w = rt.world_mut();
+        let w = &mut *w;
+        w.animations.retain(|&id, t| !w.dom.is_destroyed(id) && !w.dom.is_destroyed(t.animator));
+        let assets: HashSet<_> = w.animations.values().map(|track| &track.asset).collect();
+        self.clips.retain(|r, _| assets.contains(r));
+        assets.into_iter().filter(|r| {
+            !self.clips.contains_key(r) && !self.pending.values().any(|pending| pending == *r)
+        }).cloned().collect()
+    }
+
+    pub(crate) fn request(&mut self, loader: &mut Loader, reference: ContentRef) {
+        let ticket = loader.request(reference.clone());
+        self.pending.insert(ticket, reference);
+    }
+
+    pub(crate) fn finish(&mut self, ticket: Ticket, outcome: Result<Fetched, Failure>) {
+        if let Some(reference) = self.pending.remove(&ticket) {
+            let clip = outcome.ok().and_then(|f| Clip::decode(&f.bytes, None));
+            self.clips.insert(reference, clip);
+        }
+    }
+
+    pub(crate) fn step(&mut self, rt: &Runtime, dt: f64) {
+        let mut events = Vec::new();
+        {
+            let mut w = rt.world_mut();
+            let w = &mut *w;
+            if w.animations.is_empty() && self.applied.is_empty() {
+                return;
+            }
+            let dom = &mut w.dom;
+            let dt = dt.clamp(0.0, 0.25) as f32;
+            let mut samples = HashMap::<InstanceId, Vec<(i32, f32, CFrame)>>::new();
+            let mut rigs = HashMap::new();
+            let mut tracks: Vec<_> = w.animations.iter_mut().collect();
+            tracks.sort_unstable_by_key(|&(id, _)| *id);
+            for (&id, t) in tracks {
+                let Some(loaded) = self.clips.get(&t.asset) else { continue };
+                let Some(clip) = loaded else {
+                    if !t.loaded || t.playing {
+                        if !t.loaded {
+                            tracing::warn!(reference=?t.asset, "Animation clip unavailable or unsupported");
+                        }
+                        t.loaded = true;
+                        t.playing = false;
+                        t.ending = false;
+                        let _ = dom.set_property_by_name(id, "IsPlaying", Value::Bool(false));
+                    }
+                    continue;
+                };
+                if !t.loaded {
+                    t.loaded = true;
+                    let _ = dom.set_property_by_name(id, "Length", Value::Float32(clip.duration));
+                    if !t.loop_override {
+                        let _ = dom.set_property_by_name(id, "Looped", Value::Bool(clip.looped));
+                    }
+                    if let Some(priority) = clip.priority.filter(|_| !t.priority_override) {
+                        let _ = dom.set_property_by_name(id, "Priority", Value::Enum(priority));
+                    }
+                }
+                if !t.playing && !t.ending {
+                    continue;
+                }
+                let elapsed = if t.fade > 0.0 { (dt / t.fade).min(1.0) } else { 1.0 };
+                t.weight += (t.target - t.weight) * elapsed;
+                t.fade = (t.fade - dt).max(0.0);
+                let _ = dom.set_property_by_name(id, "WeightCurrent", Value::Float32(t.weight));
+                let mut time = dom.float_property(id, "TimePosition")
+                    .filter(|value| value.is_finite()).unwrap_or(0.0).clamp(0.0, clip.duration);
+                if t.playing && t.speed != 0.0 {
+                    let previous = time;
+                    let next = time + dt * t.speed;
+                    let looped = dom.bool_property(id, "Looped") == Some(true);
+                    let wrapped = looped && !(0.0..clip.duration).contains(&next);
+                    time = if looped { next.rem_euclid(clip.duration) } else { next.clamp(0.0, clip.duration) };
+                    if wrapped {
+                        events.push(Event::Named(id, "DidLoop"));
+                    }
+                    for (at, name, value) in &clip.markers {
+                        let crossed = if t.speed > 0.0 {
+                            if wrapped { *at > previous || *at <= time } else { *at > previous && *at <= time }
+                        } else if wrapped {
+                            *at < previous || *at >= time
+                        } else {
+                            *at < previous && *at >= time
+                        };
+                        if crossed {
+                            events.push(Event::Marker(id, name.clone(), value.clone()));
+                        }
+                    }
+                    let _ = dom.set_property_by_name(id, "TimePosition", Value::Float32(time));
+                    if !looped && (next >= clip.duration || next < 0.0) {
+                        t.playing = false;
+                        t.ending = true;
+                        t.target = 0.0;
+                        t.fade = 0.1;
+                        let _ = dom.set_property_by_name(id, "IsPlaying", Value::Bool(false));
+                        let _ = dom.set_property_by_name(id, "WeightTarget", Value::Float32(0.0));
+                        events.push(Event::Named(id, "Stopped"));
+                    }
+                }
+                if t.ending && t.weight <= 1e-5 {
+                    t.ending = false;
+                    events.push(Event::Named(id, "Ended"));
+                }
+                if t.weight <= 1e-5 {
+                    continue;
+                }
+                let joints = rigs.entry(t.animator).or_insert_with(|| {
+                    dom.parent(t.animator).and_then(|controller| dom.parent(controller))
+                        .map_or_else(Vec::new, |model| {
+                            dom.descendants(model).into_iter().filter_map(|joint| {
+                                if !dom.is_a(joint, "Motor6D")
+                                    || dom.bool_property(joint, "Enabled") == Some(false)
+                                {
+                                    return None;
+                                }
+                                let part = dom.ref_property(joint, "Part1")?;
+                                Some((joint, dom.name(part).to_owned()))
+                            }).collect()
+                        })
+                });
+                let priority = dom.enum_item_property(id, "Priority").filter(|&name| name != "Core")
+                    .and_then(|_| dom.enum_property(id, "Priority")).map_or(-1, |p| p as i32);
+                for (joint, name) in joints {
+                    if let Some(pose) = clip.transform(name, time) {
+                        samples.entry(*joint).or_default().push((priority, t.weight, pose));
+                    }
+                }
+            }
+            let mut previous = std::mem::take(&mut self.applied);
+            for (joint, mut layers) in samples {
+                let current = dom.cframe_property(joint, "Transform").unwrap_or(CFrame::IDENTITY);
+                let base = previous.remove(&joint)
+                    .filter(|&(_, last)| last == current).map_or(current, |(base, _)| base);
+                layers.sort_by_key(|layer| std::cmp::Reverse(layer.0));
+                let mut pose = base;
+                let mut total: f32 = 0.0;
+                for (_, weight, next) in layers {
+                    let weight = weight.min(1.0 - total);
+                    total += weight;
+                    pose = pose.lerp(next, weight / total);
+                    if total >= 1.0 {
+                        break;
+                    }
+                }
+                let pose = base.lerp(pose, total);
+                let _ = dom.set_property_by_name(joint, "Transform", Value::CFrame(pose));
+                self.applied.insert(joint, (base, pose));
+            }
+            for (joint, (base, last)) in previous {
+                if dom.cframe_property(joint, "Transform") == Some(last) {
+                    let _ = dom.set_property_by_name(joint, "Transform", Value::CFrame(base));
+                }
+            }
+        }
+        for event in events {
+            match event {
+                Event::Named(id, name) => rt.fire_event(id, name, ()),
+                Event::Marker(id, name, value) => rt.fire_animation_marker(id, name, &value),
+            }
+        }
+        rt.drain_deferred();
+    }
+}
