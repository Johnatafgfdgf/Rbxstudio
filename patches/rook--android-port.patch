diff --git a/crates/rook-lua/src/api/methods/animation.rs b/crates/rook-lua/src/api/methods/animation.rs
new file mode 100644
index 0000000..2cae5e1
--- /dev/null
+++ b/crates/rook-lua/src/api/methods/animation.rs
@@ -0,0 +1,185 @@
+//! Script-facing animation state. The engine loads the clips through its
+//! content loader and samples them in the pre-simulation phase.
+use mlua::Lua;
+use rook_content::ContentRef;
+use rook_dom::{Dom, InstanceId};
+use rook_types::Value;
+
+use super::RawMethod;
+use crate::api::{instance::push_instance, signal::LSignal};
+use crate::ctx::{ApiResult, Outcome, ScriptError, args::Args, with_world};
+use crate::signal::{SignalKey, SignalKind};
+
+#[derive(Debug)]
+pub struct Track {
+    pub animator: InstanceId,
+    pub asset: ContentRef,
+    pub loaded: bool,
+    pub playing: bool,
+    pub ending: bool,
+    pub weight: f32,
+    pub target: f32,
+    pub fade: f32,
+    pub speed: f32,
+    pub loop_override: bool,
+    pub priority_override: bool,
+}
+
+pub(crate) fn native(owner: &str, name: &str) -> Option<RawMethod> {
+    Some(match (owner, name) {
+        ("Animator" | "Humanoid" | "AnimationController", "LoadAnimation") => load,
+        ("Animator" | "Humanoid" | "AnimationController", "GetPlayingAnimationTracks") => playing,
+        ("Animator", "GetPlayingAnimationTracksCoreScript") => playing,
+        ("AnimationTrack", "Play") => play,
+        ("AnimationTrack", "Stop") => stop,
+        ("AnimationTrack", "AdjustSpeed") => speed,
+        ("AnimationTrack", "AdjustWeight") => weight,
+        ("AnimationTrack", "GetMarkerReachedSignal") => marker,
+        _ => return None,
+    })
+}
+
+pub fn reference(dom: &Dom, animation: InstanceId) -> Option<ContentRef> {
+    ["AnimationContent", "AnimationId"].into_iter()
+        .filter_map(|property| dom.content_property(animation, property))
+        .find_map(|url| ContentRef::parse(&url))
+}
+
+fn animator(lua: &Lua, owner: InstanceId, create: bool) -> ApiResult<Option<InstanceId>> {
+    with_world(lua, |w| {
+        let dom = &mut w.dom;
+        if dom.is_a(owner, "Animator") {
+            return Ok(Some(owner));
+        }
+        if let Some(id) = dom.find_first_child_of_class(owner, "Animator") {
+            return Ok(Some(id));
+        }
+        if !create {
+            return Ok(None);
+        }
+        let id = dom.create_by_name("Animator")?;
+        dom.set_parent(id, Some(owner))?;
+        Ok(Some(id))
+    })
+}
+
+fn load(lua: &Lua, owner: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let animation = a.instance(0)?;
+    let asset = with_world(lua, |w| {
+        if !w.dom.is_a(animation, "Animation") {
+            return Err(ScriptError("LoadAnimation expects an Animation".into()));
+        }
+        reference(&w.dom, animation)
+            .ok_or_else(|| ScriptError("AnimationId is missing or unsupported".into()))
+    })?;
+    let start = with_world(lua, |w| w.dom.journal().end());
+    let animator = animator(lua, owner, true)?.expect("created Animator");
+    let id = with_world(lua, |w| -> ApiResult<InstanceId> {
+        if w.animations.len() >= 256 {
+            return Err(ScriptError("Too many animation tracks in this session".into()));
+        }
+        let id = w.dom.create_by_name("AnimationTrack")?;
+        w.dom.set_property_by_name(id, "Animation", Value::Ref(Some(animation.to_ref())))?;
+        w.animations.insert(id, Track {
+            animator, asset, loaded: false, playing: false, ending: false,
+            weight: 0.0, target: 0.0, fade: 0.0, speed: 1.0,
+            loop_override: false, priority_override: false,
+        });
+        Ok(id)
+    })?;
+    crate::threads::dispatch(lua, start);
+    Outcome::ret(lua, push_instance(lua, id)?)
+}
+
+fn playing(lua: &Lua, owner: InstanceId, _: &Args) -> ApiResult<Outcome> {
+    let animator = animator(lua, owner, false)?;
+    let ids = with_world(lua, |w| {
+        w.animations.iter().filter_map(|(&id, t)| {
+            (Some(t.animator) == animator && t.playing && !w.dom.is_destroyed(id)).then_some(id)
+        }).collect::<Vec<_>>()
+    });
+    let values = ids.into_iter().map(|id| push_instance(lua, id)).collect::<Result<Vec<_>, _>>()?;
+    Outcome::ret(lua, lua.create_sequence_from(values)?)
+}
+
+fn number(a: &Args, index: usize, default: f64, min: f32, max: f32) -> ApiResult<f32> {
+    let value = a.number_or(index, default)? as f32;
+    if !value.is_finite() {
+        return Err(ScriptError("Expected a finite animation argument".into()));
+    }
+    Ok(value.clamp(min, max))
+}
+
+fn play(lua: &Lua, id: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let fade = number(a, 0, 0.1, 0.0, 60.0)?;
+    let weight = number(a, 1, 1.0, 0.0, 100.0)?;
+    let speed = number(a, 2, 1.0, -100.0, 100.0)?;
+    let animator = with_world(lua, |w| -> ApiResult<_> {
+        let Some(track) = w.animations.get_mut(&id) else { return Ok(None) };
+        track.playing = true;
+        track.ending = false;
+        track.target = weight;
+        track.fade = fade;
+        track.speed = speed;
+        w.dom.set_property_by_name(id, "IsPlaying", Value::Bool(true))?;
+        w.dom.set_property_by_name(id, "TimePosition", Value::Float32(0.0))?;
+        w.dom.set_property_by_name(id, "WeightTarget", Value::Float32(weight))?;
+        w.dom.set_property_by_name(id, "Speed", Value::Float32(speed))?;
+        Ok(Some(track.animator))
+    })?;
+    if let Some(animator) = animator && let Ok(track) = push_instance(lua, id) {
+        crate::threads::fire(lua, &SignalKey::event(animator, "AnimationPlayed"), &[mlua::Value::UserData(track)]);
+    }
+    Outcome::ret(lua, ())
+}
+
+fn stop(lua: &Lua, id: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let fade = number(a, 0, 0.1, 0.0, 60.0)?;
+    let stopped = with_world(lua, |w| -> ApiResult<_> {
+        let Some(track) = w.animations.get_mut(&id) else { return Ok(false) };
+        if !track.playing {
+            return Ok(false);
+        }
+        track.playing = false;
+        track.ending = true;
+        track.fade = fade;
+        track.target = 0.0;
+        w.dom.set_property_by_name(id, "IsPlaying", Value::Bool(false))?;
+        w.dom.set_property_by_name(id, "WeightTarget", Value::Float32(0.0))?;
+        Ok(true)
+    })?;
+    if stopped {
+        crate::threads::fire(lua, &SignalKey::event(id, "Stopped"), &[]);
+    }
+    Outcome::ret(lua, ())
+}
+
+fn speed(lua: &Lua, id: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let speed = number(a, 0, 1.0, -100.0, 100.0)?;
+    with_world(lua, |w| -> ApiResult<()> {
+        if let Some(track) = w.animations.get_mut(&id) {
+            track.speed = speed;
+            w.dom.set_property_by_name(id, "Speed", Value::Float32(speed))?;
+        }
+        Ok(())
+    })?;
+    Outcome::ret(lua, ())
+}
+
+fn weight(lua: &Lua, id: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let weight = number(a, 0, 1.0, 0.0, 100.0)?;
+    let fade = number(a, 1, 0.1, 0.0, 60.0)?;
+    with_world(lua, |w| -> ApiResult<()> {
+        if let Some(track) = w.animations.get_mut(&id) {
+            track.target = weight;
+            track.fade = fade;
+            w.dom.set_property_by_name(id, "WeightTarget", Value::Float32(weight))?;
+        }
+        Ok(())
+    })?;
+    Outcome::ret(lua, ())
+}
+
+fn marker(lua: &Lua, id: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    Outcome::ret(lua, LSignal { instance: id, kind: SignalKind::Marker(a.string(0)?) })
+}
