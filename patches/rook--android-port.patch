new file mode 100644
index 0000000..ec16628
--- /dev/null
+++ b/crates/rook-engine/src/bridges/input/drag.rs
@@ -0,0 +1,353 @@
+//! A captured world contact belongs to its DragDetector until release.
+//! Replicated drags are raycast and simulated on the server.
+
+use glam::{Mat3, Quat, Vec3};
+use rook_dom::{Dom, InstanceId};
+use rook_physics::{Filter, Hit, MAX_RAY_LENGTH, assembly::Assembly};
+use rook_types::{CFrame, Value, Vector3};
+
+use super::TouchPhase;
+use crate::DataModel;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct DragPointer {
+    pub origin: Vec3,
+    pub direction: Vec3,
+    pub view: CFrame,
+}
+
+impl DragPointer {
+    fn valid(self) -> bool {
+        self.origin.is_finite() && self.direction.is_normalized()
+            && self.view.position.is_finite() && self.view.rotation.is_finite()
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum DragMessage {
+    Begin { detector: InstanceId, pointer: DragPointer },
+    Move(DragPointer),
+    End,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum Style {
+    Plane,
+    Line,
+    ViewPlane,
+    AxisRotation,
+}
+
+fn style(dom: &Dom, detector: InstanceId) -> Option<Style> {
+    Some(match dom.enum_item_property(detector, "DragStyle") {
+        Some("TranslateViewPlane") => Style::ViewPlane,
+        Some("TranslateLine" | "TranslateLineOrPlane") => Style::Line,
+        Some("RotateAxis") => Style::AxisRotation,
+        Some("RotateTrackball" | "Scriptable") => return None,
+        _ => Style::Plane,
+    })
+}
+
+fn enabled(dom: &Dom, detector: InstanceId) -> bool {
+    dom.is_a(detector, "DragDetector")
+        && dom.bool_property(detector, "Enabled") != Some(false)
+        && !matches!(dom.enum_item_property(detector, "PermissionPolicy"), Some("Nobody" | "Scriptable"))
+        && style(dom, detector).is_some()
+}
+
+fn hit_world(dm: &DataModel, player: InstanceId, pointer: DragPointer) -> Option<Hit> {
+    if !pointer.valid() {
+        return None;
+    }
+    let mut w = dm.runtime().world_mut();
+    let w = &mut *w;
+    let character = w.dom.ref_property(player, "Character")?;
+    let filter = Filter {
+        skip_invisible_ghosts: true,
+        ..Filter::legacy_ray(vec![character], false)
+    };
+    w.physics.raycast(&mut w.dom, pointer.origin, pointer.direction * MAX_RAY_LENGTH, &filter)
+}
+
+fn reachable(dom: &Dom, player: InstanceId, detector: InstanceId, at: Vec3) -> bool {
+    let Some(root) = rook_lua::character_root(dom, player) else { return false };
+    let Some(frame) = dom.cframe_property(root, "CFrame") else { return false };
+    let limit = dom.float_property(detector, "MaxActivationDistance").unwrap_or(32.0);
+    limit.is_finite() && limit >= 0.0 && frame.position.distance_squared(at) <= limit * limit
+}
+
+fn choose(dom: &Dom, part: InstanceId) -> Option<InstanceId> {
+    std::iter::once(part).chain(dom.ancestors(part))
+        .filter(|&id| id == part || dom.is_a(id, "Model"))
+        .find_map(|id| dom.children(id).iter().copied().find(|&child| enabled(dom, child)))
+}
+
+#[derive(Debug)]
+pub(crate) struct Drag {
+    detector: InstanceId,
+    owner: InstanceId,
+    player: InstanceId,
+    part: InstanceId,
+    pivot: CFrame,
+    initial_frame: CFrame,
+    initial_part: CFrame,
+    reference: CFrame,
+    grab: Vec3,
+    axis: Vec3,
+    style: Style,
+    response: Response,
+}
+
+#[derive(Debug)]
+enum Response {
+    Custom,
+    Geometric,
+    Physical(InstanceId),
+}
+
+impl Drag {
+    pub(crate) fn detector(&self) -> InstanceId {
+        self.detector
+    }
+
+    pub(crate) fn begin(
+        dm: &DataModel, player: InstanceId, detector: InstanceId, pointer: DragPointer,
+    ) -> Option<Self> {
+        let hit = hit_world(dm, player, pointer)?;
+        let rt = dm.runtime();
+        let (owner, initial_frame, initial_part, reference, axis, style, response) = {
+            let w = rt.world();
+            let dom = &w.dom;
+            if choose(dom, hit.part) != Some(detector)
+                || !reachable(dom, player, detector, hit.position)
+                || (dom.bool_property(detector, "RunLocally") == Some(true)) != w.is_client
+            {
+                return None;
+            }
+            let owner = dom.parent(detector)?;
+            let frame = dom.cframe_property(detector, "DragFrame").unwrap_or(CFrame::IDENTITY);
+            let part = dom.cframe_property(hit.part, "CFrame")?;
+            let reference = dom.ref_property(detector, "ReferenceInstance")
+                .filter(|&id| dom.is_a(id, "PVInstance"));
+            let axis = dom.vector3_property(detector, "Axis").unwrap_or(Vec3::Y);
+            (owner, frame, part, reference, axis, style(dom, detector)?,
+                dom.enum_item_property(detector, "ResponseStyle"))
+        };
+        let reference = reference.map_or(CFrame::IDENTITY, |id| rt.instance_pivot(id));
+        let axis = (reference.rotation * axis).try_normalize().unwrap_or(Vec3::Y);
+        let pivot = rt.instance_pivot(owner);
+        let response = match response {
+            Some("Custom") => Response::Custom,
+            Some("Geometric") => Response::Geometric,
+            _ if Assembly::of(&rt.world().dom, hit.part)
+                .is_some_and(|assembly| assembly.anchored) => Response::Geometric,
+            _ => Response::Physical(make_mover(dm, detector, hit.part, initial_part, style)?),
+        };
+        rt.fire_drag_start(detector, player, pointer.origin, pointer.direction, pointer.view,
+            CFrame { position: hit.position, rotation: initial_part.rotation }, hit.part);
+        Some(Self {
+            detector, owner, player, part: hit.part, pivot, initial_frame, initial_part,
+            reference, grab: hit.position, axis, style, response,
+        })
+    }
+
+    pub(crate) fn valid(&self, dm: &DataModel) -> bool {
+        let w = dm.runtime().world();
+        let dom = &w.dom;
+        enabled(dom, self.detector)
+            && (dom.bool_property(self.detector, "RunLocally") == Some(true)) == w.is_client
+            && dom.parent(self.detector) == Some(self.owner)
+            && dom.find_service("Workspace").is_some_and(|id| dom.is_ancestor_of(id, self.owner))
+            && rook_lua::character_root(dom, self.player).is_some()
+            && dom.is_a(self.part, "BasePart")
+    }
+
+    fn translation(&self, pointer: DragPointer) -> Option<Vec3> {
+        match self.style {
+            Style::Line => {
+                let dot = pointer.direction.dot(self.axis);
+                let denominator = 1.0 - dot * dot;
+                if denominator < 1e-4 {
+                    return None;
+                }
+                let offset = pointer.origin - self.grab;
+                Some(self.axis * (offset.dot(self.axis) - dot * offset.dot(pointer.direction)) / denominator)
+            }
+            _ => {
+                let normal = if matches!(self.style, Style::ViewPlane) {
+                    pointer.view.rotation.z_axis
+                } else {
+                    self.axis
+                };
+                Some(intersect(pointer, self.grab, normal)? - self.grab)
+            }
+        }
+    }
+
+    fn frames(&self, dom: &Dom, pointer: DragPointer) -> Option<(CFrame, CFrame)> {
+        if matches!(self.style, Style::AxisRotation) {
+            let point = intersect(pointer, self.grab, self.axis)?;
+            let flat = |v: Vec3| (v - self.axis * v.dot(self.axis)).try_normalize();
+            let (a, b) = flat(self.grab - self.pivot.position).zip(flat(point - self.pivot.position))?;
+            let mut angle = self.axis.dot(a.cross(b)).atan2(a.dot(b)).to_degrees();
+            let min = dom.float_property(self.detector, "MinDragAngle").unwrap_or(0.0);
+            let max = dom.float_property(self.detector, "MaxDragAngle").unwrap_or(0.0);
+            if max > min {
+                angle = angle.clamp(min, max);
+            }
+            let rotation = Mat3::from_quat(Quat::from_axis_angle(self.axis, angle.to_radians()));
+            let relative = self.reference.rotation.transpose() * rotation * self.reference.rotation;
+            return Some((
+                CFrame { rotation: relative * self.initial_frame.rotation, ..self.initial_frame },
+                CFrame { rotation, position: self.pivot.position - rotation * self.pivot.position },
+            ));
+        }
+        let delta = self.translation(pointer)?;
+        if !delta.is_finite() || delta.length_squared() > 512.0 * 512.0 {
+            return None;
+        }
+        let rotation = self.reference.rotation;
+        let pos = self.initial_frame.position + rotation.transpose() * delta;
+        let min = dom.vector3_property(self.detector, "MinDragTranslation").unwrap_or(Vec3::ZERO);
+        let max = dom.vector3_property(self.detector, "MaxDragTranslation").unwrap_or(Vec3::ZERO);
+        let clamp = |v: f32, low: f32, high: f32| if high > low { v.clamp(low, high) } else { v };
+        let position = Vec3::new(clamp(pos.x, min.x, max.x), clamp(pos.y, min.y, max.y),
+            clamp(pos.z, min.z, max.z));
+        Some((
+            CFrame { position, ..self.initial_frame },
+            CFrame::from_position(rotation * (position - self.initial_frame.position)),
+        ))
+    }
+
+    pub(crate) fn move_to(&self, dm: &DataModel, pointer: DragPointer) {
+        if !pointer.valid() {
+            return;
+        }
+        let rt = dm.runtime();
+        let Some((frame, delta)) = self.frames(&rt.world().dom, pointer) else { return };
+        dm.set_property(self.detector, "DragFrame", Value::CFrame(frame));
+        match self.response {
+            Response::Custom => {}
+            Response::Geometric => rt.move_instance_pivot(self.owner, delta * self.pivot),
+            Response::Physical(mover) if matches!(self.style, Style::AxisRotation) => {
+                dm.set_property(mover, "CFrame", Value::CFrame(delta * self.initial_part));
+            }
+            Response::Physical(mover) => {
+                dm.set_property(mover, "Position", Value::Vector3(Vector3((delta * self.initial_part).position)));
+            }
+        }
+        rt.fire_drag_continue(self.detector, self.player, pointer.origin, pointer.direction, pointer.view);
+    }
+
+    pub(crate) fn end(self, dm: &DataModel) {
+        let rt = dm.runtime();
+        if let Response::Physical(mover) = self.response {
+            rt.destroy(mover);
+        }
+        if let Ok(player) = rt.push_instance(self.player) {
+            rt.fire_event(self.detector, "DragEnd", player);
+        }
+        rt.drain_deferred();
+    }
+}
+
+fn intersect(pointer: DragPointer, at: Vec3, normal: Vec3) -> Option<Vec3> {
+    let denominator = normal.dot(pointer.direction);
+    if denominator.abs() < 1e-4 {
+        return None;
+    }
+    let distance = normal.dot(at - pointer.origin) / denominator;
+    (0.0..=MAX_RAY_LENGTH).contains(&distance).then_some(pointer.origin + pointer.direction * distance)
+}
+
+fn make_mover(dm: &DataModel, detector: InstanceId, part: InstanceId, frame: CFrame, style: Style) -> Option<InstanceId> {
+    let mut w = dm.runtime().world_mut();
+    let dom = &mut w.dom;
+    let rotating = matches!(style, Style::AxisRotation);
+    let mover = dom.create_by_name(if rotating { "BodyGyro" } else { "BodyPosition" }).ok()?;
+    let _ = dom.set_name(mover, "DragDetectorActuator".into());
+    let cap = dom.float_property(detector, if rotating { "MaxTorque" } else { "MaxForce" })
+        .unwrap_or(10000.0).clamp(0.0, 1e9);
+    let response = dom.float_property(detector, "Responsiveness").unwrap_or(10.0).clamp(1.0, 100.0);
+    let _ = dom.set_property_by_name(mover, "P", Value::Float32(response * 500.0));
+    let _ = dom.set_property_by_name(mover, "D", Value::Float32(response * 100.0));
+    let force = Value::Vector3(Vector3(Vec3::splat(cap)));
+    if rotating {
+        let _ = dom.set_property_by_name(mover, "MaxTorque", force);
+        let _ = dom.set_property_by_name(mover, "CFrame", Value::CFrame(frame));
+    } else {
+        let _ = dom.set_property_by_name(mover, "MaxForce", force);
+        let _ = dom.set_property_by_name(mover, "Position", Value::Vector3(Vector3(frame.position)));
+    }
+    dom.set_parent(mover, Some(part)).ok()?;
+    Some(mover)
+}
+
+#[derive(Debug)]
+pub(super) struct TouchDrag {
+    finger: u64,
+    local: Option<Drag>,
+}
+
+impl DataModel {
+    pub(crate) fn take_drag_messages(&mut self) -> Vec<DragMessage> {
+        std::mem::take(&mut self.input.drag_out)
+    }
+
+    pub(super) fn drag_touch(
+        &mut self, finger: u64, phase: TouchPhase, position: (f32, f32), gui: bool,
+    ) -> bool {
+        let captured = self.input.drag.as_ref().is_some_and(|d| d.finger == finger);
+        if !captured && (gui || phase != TouchPhase::Begin || self.input.drag.is_some()
+            || !self.prompt_index.has_drags())
+        {
+            return false;
+        }
+        let pointer = self.input_ray(position).map(|(origin, direction, view)| DragPointer {
+            origin, direction, view,
+        });
+        if captured {
+            let active = self.input.drag.take().expect("matching touch drag");
+            let valid = active.local.as_ref().is_none_or(|drag| drag.valid(self));
+            if !valid || self.runtime.menu_is_open() || matches!(phase, TouchPhase::End | TouchPhase::Cancel) {
+                if let Some(drag) = active.local {
+                    drag.end(self);
+                } else {
+                    self.input.drag_out.push(DragMessage::End);
+                }
+            } else {
+                if let Some(pointer) = pointer {
+                    if let Some(drag) = &active.local {
+                        drag.move_to(self, pointer);
+                    } else if let Some(DragMessage::Move(previous)) = self.input.drag_out.last_mut() {
+                        *previous = pointer;
+                    } else {
+                        self.input.drag_out.push(DragMessage::Move(pointer));
+                    }
+                }
+                self.input.drag = Some(active);
+            }
+            return true;
+        }
+        let Some(pointer) = pointer else { return false };
+        let Some(player) = self.runtime.world().dom.local_player() else { return false };
+        let Some(hit) = hit_world(self, player, pointer) else { return false };
+        let (detector, run_locally) = {
+            let w = self.runtime.world();
+            let Some(detector) = choose(&w.dom, hit.part) else { return false };
+            if !reachable(&w.dom, player, detector, hit.position) {
+                return false;
+            }
+            (detector, w.dom.bool_property(detector, "RunLocally") == Some(true))
+        };
+        let local = if run_locally {
+            let Some(drag) = Drag::begin(self, player, detector, pointer) else { return false };
+            Some(drag)
+        } else {
+            self.input.drag_out.push(DragMessage::Begin { detector, pointer });
+            None
+        };
+        self.input.drag = Some(TouchDrag { finger, local });
+        true
+    }
+}
