 pub(crate) fn native(owner: &str, name: &str) -> Option<RawMethod> {
     Some(match (owner, name) {
         ("TextService", "GetTextSize") => get_text_size,
+        ("TextService", "GetTextBoundsAsync") => get_text_bounds_async,
         ("TextService", "GetTextSizeOffsetAsync") => get_text_size_offset,
         _ => return None,
     })
 }
 
+/// Measure the actual requested font. Asset fonts use the existing content
+/// request bridge and scheduler, so a pending download cannot block a frame.
+fn get_text_bounds_async(lua: &Lua, _: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let params = a.instance(0)?;
+    let (text, font, size, width, rich, deadline) = with_world(lua, |w| {
+        if !w.dom.is_a(params, "GetTextBoundsParams") {
+            return Err(a.wrong(0, "GetTextBoundsParams"));
+        }
+        Ok((w.dom.string_property(params, "Text").unwrap_or_default(),
+            w.dom.font_property(params, "Font").unwrap_or_default(),
+            w.dom.float_property(params, "Size").unwrap_or(14.0),
+            w.dom.float_property(params, "Width").unwrap_or(0.0),
+            w.dom.bool_property(params, "RichText").unwrap_or(false),
+            w.scheduler.now() + 15.0))
+    })?;
+    if !size.is_finite() || size < 0.0 || width.is_nan() {
+        return Err(ScriptError(format!("Invalid text bounds: size={size}, width={width}")));
+    }
+    // Original UI packages use math.huge for an unconstrained line and can
+    // pass a negative padded width during their first, zero-size layout.
+    let width = if width.is_infinite() { 0.0 } else { width.max(0.0) };
+    if size == 0.0 { return Outcome::ret(lua, LVector2(Vector2::new(0.0, 0.0))); }
+    let measure = crate::ctx::api_fn(lua, move |lua, _| {
+        let bounds = with_world(lua, |w| {
+            if w.scheduler.now() >= deadline { return Err("Font measurement timed out".to_owned()); }
+            w.gui.text_bounds(&text, font.clone(), size, width, rich)
+        }).map_err(ScriptError)?;
+        Outcome::ret(lua, bounds.map(|v| LVector2(Vector2::new(v.x, v.y))))
+    })?;
+    let std: Table = lua.named_registry_value("rook.std")?;
+    let wait: Function = std.get::<Table>("task")?.get("wait")?;
+    let helper: Function = lua.load(r#"
+        local measure,wait=...
+        return function()
+            while true do
+                local bounds=measure()
+                if bounds~=nil then return bounds end
+                wait()
+            end
+        end
+    "#).set_name("TextService.GetTextBoundsAsync").call((measure, wait))?;
+    Ok(Outcome::Call(helper, MultiValue::new()))
+}
+
