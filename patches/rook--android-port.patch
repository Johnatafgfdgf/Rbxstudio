+fn shutdown(lua: &Lua, _: InstanceId, _: &Args) -> ApiResult<Outcome> {
+    if !crate::api::scripts::caller_is_core(lua) {
+        return Err(ScriptError("Shutdown is reserved for CoreScripts".into()));
+    }
+    with_world(lua, |w| w.shutdown_requested = w.is_client);
+    Outcome::ret(lua, ())
+}
+
+fn set_menu_open(lua: &Lua, gui: InstanceId, args: &Args) -> ApiResult<Outcome> {
+    if !crate::api::scripts::caller_is_core(lua) {
+        return Err(ScriptError(
+            "SetMenuIsOpen is reserved for CoreScripts".into(),
+        ));
+    }
+    let open = args.truthy(0);
+    let name = if args.get(1).is_nil() {
+        String::new()
+    } else {
+        args.string(1)?
+    };
+    let changed = mutate(lua, |w| {
+        let was_open = !w.open_menus.is_empty();
+        if open {
+            w.open_menus.insert(name);
+        } else {
+            w.open_menus.remove(&name);
+        }
+        let is_open = !w.open_menus.is_empty();
+        if is_open && !was_open {
+            scale_touch_menu(w)?;
+        }
+        Ok((was_open != is_open).then_some(is_open))
+    })?;
+    if let Some(open) = changed {
+        let event = if open { "MenuOpened" } else { "MenuClosed" };
+        crate::threads::fire(lua, &crate::signal::SignalKey::event(gui, event), &[]);
+    }
+    Outcome::ret(lua, ())
+}
+
+/// The original pause panel shares its scale with the renderer's hit testing.
+fn scale_touch_menu(w: &mut crate::World) -> Result<(), rook_dom::DomError> {
+    use rook_types::Value;
+
+    if !w
+        .dom
+        .find_service("UserInputService")
+        .is_some_and(|input| w.dom.bool_property(input, "TouchEnabled") == Some(true))
+    {
+        return Ok(());
+    }
+    let Some(container) = w
+        .dom
+        .find_service("CoreGui")
+        .and_then(|core| w.dom.find_first_child(core, "RobloxGui", false))
+        .and_then(|gui| w.dom.find_first_child(gui, "SettingsClippingShield", false))
+        .and_then(|clip| w.dom.find_first_child(clip, "SettingsShield", false))
+        .and_then(|shield| w.dom.find_first_child(shield, "MenuContainer", false))
+    else {
+        return Ok(());
+    };
+    let Some(viewport) = w
+        .dom
+        .find_service("Workspace")
+        .and_then(|ws| w.dom.ref_property(ws, "CurrentCamera"))
+        .and_then(|camera| w.dom.vector2_property(camera, "ViewportSize"))
+    else {
+        return Ok(());
+    };
+    let existing = w.dom.find_first_child_of_class(container, "UIScale");
+    if existing.is_some_and(|scale| w.dom.name(scale) != "RbxMobileTouchScale") {
+        return Ok(());
+    }
+    w.gui.sync(&mut w.dom);
+    let Some(size) = w.dom.vector2_property(container, "AbsoluteSize") else {
+        return Ok(());
+    };
+    if size.x() <= 0.0 || size.y() <= 0.0 {
+        return Ok(());
+    }
+    let previous = existing
+        .and_then(|id| w.dom.float_property(id, "Scale"))
+        .unwrap_or(1.0);
+    let fit = ((viewport.x() - 40.0) / size.x()).min((viewport.y() - 116.0) / size.y());
+    let factor = (fit * previous).clamp(1.0, 1.15);
+    let scale = match existing {
+        Some(scale) => scale,
+        None if factor > 1.001 => {
+            let scale = w.dom.create_by_name("UIScale")?;
+            w.dom.set_name(scale, "RbxMobileTouchScale".into())?;
+            w.dom.set_parent(scale, Some(container))?;
+            scale
+        }
+        None => return Ok(()),
+    };
+    w.dom
+        .set_property_by_name(scale, "Scale", Value::Float32(factor))
+}
