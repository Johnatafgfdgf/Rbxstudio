+            for name in ["ColorMapContent", "TextureContent", "ColorMap", "Texture"] {
+                let uri = match instance.properties.get(&name.into()) {
+                    Some(rbx_types::Variant::Content(value)) => value.as_uri(),
+                    Some(rbx_types::Variant::ContentId(value)) => Some(value.as_str()),
+                    Some(rbx_types::Variant::String(value)) => Some(value.as_str()),
+                    _ => None,
+                };
+                if let Some(reference) = uri.and_then(ContentRef::parse) {
+                    return Some(reference);
+                }
+            }
+        }
+        refs.extend(instance.children());
+    }
+    None
+}
