new file mode 100644
index 0000000..fa9adca
--- /dev/null
+++ b/crates/rook-physics/src/joints/movers/modern.rs
@@ -0,0 +1,530 @@
+//! Public mover constraints, solved as bounded forces each physics substep.
+//! Targets are read from live attachment frames, including nested attachments.
+//! This is an independent servo, not Roblox's proprietary constraint solver.
+use super::*;
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum Limit {
+    Unlimited,
+    Magnitude(f32),
+    Axes(Vec3),
+}
+
+impl Limit {
+    fn apply(&self, force: Vec3, axes: Mat3) -> Vec3 {
+        match self {
+            Self::Unlimited => force,
+            Self::Magnitude(n) => force.clamp_length_max(*n),
+            Self::Axes(n) => axes * clamp_axes(axes.transpose() * force, *n),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum VelocityAxes {
+    Vector,
+    Line(Vec3),
+    Plane(Vec3, Vec3),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum Alignment {
+    All,
+    Parallel,
+    Perpendicular,
+    LookAt(Vec3),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum Actuator {
+    Linear {
+        relative: Option<Frame>,
+        reference: Option<Frame>,
+        target: Vec3,
+        axes: VelocityAxes,
+        limit: Limit,
+        reaction: bool,
+    },
+    Angular {
+        relative: Option<Frame>,
+        reference: Option<Frame>,
+        target: Vec3,
+        max_torque: f32,
+        reaction: bool,
+    },
+    Position {
+        other: Option<Frame>,
+        target: Vec3,
+        rate: f32,
+        max_speed: f32,
+        limit: Limit,
+        force_relative: Option<Frame>,
+        at_com: bool,
+        reaction: bool,
+    },
+    Orientation {
+        other: Option<Frame>,
+        target: Mat3,
+        alignment: Alignment,
+        rate: f32,
+        max_speed: f32,
+        max_torque: f32,
+        reaction: bool,
+    },
+}
+
+impl Actuator {
+    pub(super) fn other_body(&self) -> Option<RigidBodyHandle> {
+        match self {
+            Self::Linear { relative, .. } | Self::Angular { relative, .. } => relative.map(|f| f.0),
+            Self::Position {
+                other,
+                force_relative,
+                ..
+            } => other.or(*force_relative).map(|f| f.0),
+            Self::Orientation { other, .. } => other.map(|f| f.0),
+        }
+    }
+}
+
+pub(super) fn is_modern(class: &str) -> bool {
+    matches!(
+        class,
+        "LinearVelocity" | "AngularVelocity" | "AlignPosition" | "AlignOrientation"
+    )
+}
+
+fn positive(dom: &Dom, id: InstanceId, name: &str, default: f32) -> f32 {
+    let n = dom.float_property(id, name).unwrap_or(default);
+    if n.is_nan() { default } else { n.max(0.0) }
+}
+
+pub(super) fn read(
+    dom: &Dom,
+    id: InstanceId,
+    frame_of: &impl Fn(InstanceId) -> Option<Frame>,
+) -> Option<Mover> {
+    if dom.is_destroyed(id) || dom.bool_property(id, "Enabled") == Some(false) {
+        return None;
+    }
+    let in_frame = |att| {
+        let (part, cf) = attachment(dom, att)?;
+        let (body, offset) = frame_of(part)?;
+        Some((body, offset * cf))
+    };
+    let at = in_frame(dom.ref_property(id, "Attachment0")?)?;
+    let other = dom.ref_property(id, "Attachment1").and_then(in_frame);
+    let relative = |name| match dom.enum_item_property(id, name) {
+        Some("Attachment0") => Some(at),
+        Some("Attachment1") => other,
+        _ => None,
+    };
+    let max_force = positive(dom, id, "MaxForce", 10000.0);
+    let force_limit = |unlimited| {
+        if unlimited {
+            Limit::Unlimited
+        } else if dom.enum_item_property(id, "ForceLimitMode") == Some("PerAxis") {
+            Limit::Axes(
+                dom.vector3_property(id, "MaxAxesForce")
+                    .unwrap_or(Vec3::splat(max_force))
+                    .abs(),
+            )
+        } else {
+            Limit::Magnitude(max_force)
+        }
+    };
+    let rate = positive(dom, id, "Responsiveness", 10.0).clamp(5.0, 200.0);
+    let rigid = dom.bool_property(id, "RigidityEnabled") == Some(true);
+    let actuator = match dom.class_name(id) {
+        "LinearVelocity" => {
+            let relative = relative("RelativeTo");
+            // Attachment1 defines a moving reference as well as directional axes.
+            let reference = (dom.enum_item_property(id, "RelativeTo") == Some("Attachment1"))
+                .then_some(other)
+                .flatten();
+            if dom.enum_item_property(id, "RelativeTo") == Some("Attachment1")
+                && reference.is_none()
+            {
+                return None;
+            }
+            let mut limit = force_limit(dom.bool_property(id, "ForceLimitsEnabled") == Some(false));
+            let (target, axes) = match dom.enum_item_property(id, "VelocityConstraintMode") {
+                Some("Line") => {
+                    let direction = dom
+                        .vector3_property(id, "LineDirection")
+                        .unwrap_or(Vec3::X)
+                        .normalize_or_zero();
+                    limit = if matches!(limit, Limit::Unlimited) {
+                        limit
+                    } else {
+                        Limit::Magnitude(max_force)
+                    };
+                    (
+                        direction * dom.float_property(id, "LineVelocity").unwrap_or(0.0),
+                        VelocityAxes::Line(direction),
+                    )
+                }
+                Some("Plane") => {
+                    let x = dom
+                        .vector3_property(id, "PrimaryTangentAxis")
+                        .unwrap_or(Vec3::X)
+                        .normalize_or_zero();
+                    let y = dom
+                        .vector3_property(id, "SecondaryTangentAxis")
+                        .unwrap_or(Vec3::Y);
+                    let y = (y - x * y.dot(x)).normalize_or_zero();
+                    let v = dom
+                        .vector2_property(id, "PlaneVelocity")
+                        .unwrap_or_default();
+                    // Store plane components in the tangent basis, not world XYZ.
+                    if matches!(limit, Limit::Axes(_)) {
+                        let n = dom
+                            .vector2_property(id, "MaxPlanarAxesForce")
+                            .unwrap_or_default();
+                        limit = Limit::Axes(Vec3::new(n.x().abs(), n.y().abs(), 0.0));
+                    }
+                    (x * v.x() + y * v.y(), VelocityAxes::Plane(x, y))
+                }
+                _ => (
+                    dom.vector3_property(id, "VectorVelocity")
+                        .unwrap_or(Vec3::ZERO),
+                    VelocityAxes::Vector,
+                ),
+            };
+            Actuator::Linear {
+                relative,
+                reference,
+                target,
+                axes,
+                limit,
+                reaction: dom.bool_property(id, "ReactionForceEnabled") != Some(false),
+            }
+        }
+        "AngularVelocity" => {
+            let reference = (dom.enum_item_property(id, "RelativeTo") == Some("Attachment1"))
+                .then_some(other)
+                .flatten();
+            if dom.enum_item_property(id, "RelativeTo") == Some("Attachment1")
+                && reference.is_none()
+            {
+                return None;
+            }
+            Actuator::Angular {
+                relative: relative("RelativeTo"),
+                reference,
+                target: dom
+                    .vector3_property(id, "AngularVelocity")
+                    .unwrap_or(Vec3::ZERO),
+                max_torque: positive(dom, id, "MaxTorque", 0.0),
+                reaction: dom.bool_property(id, "ReactionTorqueEnabled") == Some(true),
+            }
+        }
+        "AlignPosition" => {
+            let two = dom.enum_item_property(id, "Mode") != Some("OneAttachment");
+            if two && other.is_none() {
+                return None;
+            }
+            Actuator::Position {
+                other: two.then_some(other).flatten(),
+                target: dom.vector3_property(id, "Position").unwrap_or(Vec3::ZERO),
+                rate: if rigid { f32::INFINITY } else { rate },
+                max_speed: if rigid {
+                    f32::INFINITY
+                } else {
+                    positive(dom, id, "MaxVelocity", f32::INFINITY)
+                },
+                limit: force_limit(rigid),
+                force_relative: relative("ForceRelativeTo"),
+                at_com: dom.bool_property(id, "ApplyAtCenterOfMass") == Some(true),
+                reaction: dom.bool_property(id, "ReactionForceEnabled") == Some(true),
+            }
+        }
+        "AlignOrientation" => {
+            let two = dom.enum_item_property(id, "Mode") != Some("OneAttachment");
+            if two && other.is_none() {
+                return None;
+            }
+            let alignment = match dom.enum_item_property(id, "AlignType") {
+                Some("PrimaryAxisParallel" | "Parallel") => Alignment::Parallel,
+                Some("PrimaryAxisPerpendicular" | "Perpendicular") => Alignment::Perpendicular,
+                Some("PrimaryAxisLookAt") => Alignment::LookAt(
+                    dom.vector3_property(id, "LookAtPosition")
+                        .unwrap_or(Vec3::ZERO),
+                ),
+                _ if dom.bool_property(id, "PrimaryAxisOnly") == Some(true) => Alignment::Parallel,
+                _ => Alignment::All,
+            };
+            let mut target = dom
+                .cframe_property(id, "CFrame")
+                .unwrap_or(CFrame::IDENTITY)
+                .rotation;
+            // These public properties also provide a goal frame when a
+            // script sets the axes individually instead of setting CFrame.
+            let explicit = |name| dom.property_id(id, name).is_some_and(|p| dom.is_set(id, p));
+            if !two && (explicit("PrimaryAxis") || explicit("SecondaryAxis")) {
+                let x = dom
+                    .vector3_property(id, "PrimaryAxis")
+                    .unwrap_or(target.x_axis)
+                    .normalize_or(target.x_axis);
+                let y = dom
+                    .vector3_property(id, "SecondaryAxis")
+                    .unwrap_or(target.y_axis);
+                let y = (y - x * x.dot(y)).normalize_or(target.y_axis);
+                target = Mat3::from_cols(x, y, x.cross(y));
+            }
+            Actuator::Orientation {
+                other: two.then_some(other).flatten(),
+                target,
+                alignment,
+                rate: if rigid { f32::INFINITY } else { rate },
+                max_speed: if rigid {
+                    f32::INFINITY
+                } else {
+                    positive(dom, id, "MaxAngularVelocity", f32::INFINITY)
+                },
+                max_torque: if rigid {
+                    f32::INFINITY
+                } else {
+                    positive(dom, id, "MaxTorque", 10000.0)
+                },
+                reaction: dom.bool_property(id, "ReactionTorqueEnabled") == Some(true),
+            }
+        }
+        _ => return None,
+    };
+    Some(Mover {
+        id,
+        at,
+        kind: Kind::Modern(actuator),
+    })
+}
+
+pub(super) fn apply(
+    a: &Actuator,
+    body: RigidBodyHandle,
+    frame: CFrame,
+    states: &HashMap<RigidBodyHandle, State>,
+    pushes: &mut HashMap<RigidBodyHandle, Push>,
+    h: f32,
+    gravity: Vec3,
+) {
+    let s = &states[&body];
+    let gravity0 = gravity * s.gravity_scale;
+    let world_frame = s.pose * frame;
+    let state_frame = |f: Frame| states.get(&f.0).map(|o| (o, o.pose * f.1));
+    let rotation = |f: Option<Frame>| {
+        f.and_then(state_frame)
+            .map_or(Mat3::IDENTITY, |(_, cf)| cf.rotation)
+    };
+    let mass = |other: Option<Frame>, reaction: bool| {
+        let inverse_other = if reaction {
+            other
+                .and_then(|f| states.get(&f.0))
+                .filter(|o| o.dynamic && o.mass > 0.0)
+                .map_or(0.0, |o| 1.0 / o.mass)
+        } else {
+            0.0
+        };
+        let inverse_self = if s.dynamic && s.mass > 0.0 {
+            1.0 / s.mass
+        } else {
+            0.0
+        };
+        let inverse = inverse_self + inverse_other;
+        if inverse > 0.0 { 1.0 / inverse } else { 0.0 }
+    };
+    let torque_for = |alpha: Vec3, other: Option<Frame>, reaction: bool| match other
+        .and_then(|f| states.get(&f.0))
+        .filter(|o| reaction && o.dynamic)
+    {
+        Some(o) => {
+            (s.inv_inertia + o.inv_inertia)
+                .add_diagonal(1e-9)
+                .inverse_unchecked()
+                * alpha
+        }
+        None => s.torque_for(alpha),
+    };
+    let mut force = Vec3::ZERO;
+    let mut torque = Vec3::ZERO;
+    let other;
+    let reaction;
+    let mut at_com = true;
+    match a {
+        Actuator::Linear {
+            relative,
+            reference,
+            target,
+            axes,
+            limit,
+            reaction: reacts,
+        } => {
+            let r = rotation(*relative);
+            let reference_velocity = reference
+                .and_then(state_frame)
+                .map_or(Vec3::ZERO, |(o, cf)| o.velocity_at(cf.position));
+            let reference_gravity = reference
+                .and_then(|f| states.get(&f.0))
+                .filter(|o| o.dynamic)
+                .map_or(Vec3::ZERO, |o| gravity * o.gravity_scale);
+            let mut accel =
+                (r * *target + reference_velocity - s.v) / h - (gravity0 - reference_gravity);
+            let mut limit_axes = r;
+            match axes {
+                VelocityAxes::Vector => {}
+                VelocityAxes::Line(x) => {
+                    let x = r * *x;
+                    accel = x * accel.dot(x);
+                }
+                VelocityAxes::Plane(x, y) => {
+                    let (x, y) = (r * *x, r * *y);
+                    accel = x * accel.dot(x) + y * accel.dot(y);
+                    limit_axes = Mat3::from_cols(x, y, x.cross(y));
+                }
+            }
+            force = limit.apply(mass(*reference, *reacts) * accel, limit_axes);
+            other = *reference;
+            reaction = *reacts;
+        }
+        Actuator::Angular {
+            relative,
+            reference,
+            target,
+            max_torque,
+            reaction: reacts,
+        } => {
+            let reference_w = reference
+                .and_then(|f| states.get(&f.0))
+                .map_or(Vec3::ZERO, |o| o.w);
+            torque = torque_for(
+                (rotation(*relative) * *target + reference_w - s.w) / h,
+                *reference,
+                *reacts,
+            )
+            .clamp_length_max(*max_torque);
+            other = *reference;
+            reaction = *reacts;
+        }
+        Actuator::Position {
+            other: goal,
+            target,
+            rate,
+            max_speed,
+            limit,
+            force_relative,
+            at_com: com,
+            reaction: reacts,
+        } => {
+            let (target, goal_v, goal_g) =
+                goal.and_then(state_frame)
+                    .map_or((*target, Vec3::ZERO, Vec3::ZERO), |(o, cf)| {
+                        (
+                            cf.position,
+                            o.velocity_at(cf.position),
+                            if o.dynamic {
+                                gravity * o.gravity_scale
+                            } else {
+                                Vec3::ZERO
+                            },
+                        )
+                    });
+            let gain = if rate.is_infinite() {
+                1.0 / h
+            } else {
+                (1.0 - (-rate * h).exp()) / h
+            };
+            let want =
+                ((target - world_frame.position) * gain).clamp_length_max(*max_speed) + goal_v;
+            let velocity = if *com {
+                s.v
+            } else {
+                s.velocity_at(world_frame.position)
+            };
+            force = limit.apply(
+                mass(*goal, *reacts) * ((want - velocity) / h - (gravity0 - goal_g)),
+                rotation(*force_relative),
+            );
+            other = *goal;
+            reaction = *reacts;
+            at_com = *com;
+        }
+        Actuator::Orientation {
+            other: goal,
+            target,
+            alignment,
+            rate,
+            max_speed,
+            max_torque,
+            reaction: reacts,
+        } => {
+            let (target, goal_w) = goal
+                .and_then(state_frame)
+                .map_or((*target, Vec3::ZERO), |(o, cf)| (cf.rotation, o.w));
+            // Quaternion shortest arc works at 180 degrees, where a cross-product servo has zero error.
+            let axis = world_frame.rotation.x_axis;
+            let delta = match alignment {
+                Alignment::All => {
+                    glam::Quat::from_mat3(&(target * world_frame.rotation.transpose())).normalize()
+                }
+                Alignment::Parallel => glam::Quat::from_rotation_arc(axis, target.x_axis),
+                Alignment::Perpendicular => {
+                    let projection = axis - target.x_axis * axis.dot(target.x_axis);
+                    let fallback = if target.x_axis.dot(world_frame.rotation.y_axis).abs() < 0.9 {
+                        world_frame.rotation.y_axis
+                    } else {
+                        world_frame.rotation.z_axis
+                    };
+                    let fallback = (fallback - target.x_axis * fallback.dot(target.x_axis))
+                        .normalize_or_zero();
+                    glam::Quat::from_rotation_arc(axis, projection.normalize_or(fallback))
+                }
+                Alignment::LookAt(point) => {
+                    let point = goal
+                        .and_then(state_frame)
+                        .map_or(*point, |(_, cf)| cf.position);
+                    glam::Quat::from_rotation_arc(
+                        axis,
+                        (point - world_frame.position).normalize_or(axis),
+                    )
+                }
+            };
+            let delta = if delta.w < 0.0 { -delta } else { delta };
+            let gain = if rate.is_infinite() {
+                1.0 / h
+            } else {
+                (1.0 - (-rate * h).exp()) / h
+            };
+            let want = (delta.to_scaled_axis() * gain).clamp_length_max(*max_speed) + goal_w;
+            let mut alpha = (want - s.w) / h;
+            if !matches!(alignment, Alignment::All) {
+                alpha -= axis * alpha.dot(axis);
+            }
+            torque = torque_for(alpha, *goal, *reacts).clamp_length_max(*max_torque);
+            other = *goal;
+            reaction = *reacts;
+        }
+    }
+    if !force.is_finite() || !torque.is_finite() {
+        return;
+    }
+    let push = pushes.entry(body).or_default();
+    if at_com {
+        push.force += force;
+    } else {
+        push.at.push((force, world_frame.position));
+    }
+    push.torque += torque;
+    if reaction
+        && let Some((id, f)) = other
+        && id != body
+    {
+        let push = pushes.entry(id).or_default();
+        push.wake = true;
+        if at_com {
+            push.force -= force;
+        } else if let Some((_, cf)) = state_frame((id, f)) {
+            push.at.push((-force, cf.position));
+        }
+        push.torque -= torque;
+    }
+}
