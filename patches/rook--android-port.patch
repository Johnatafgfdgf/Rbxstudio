+/// Local Tools need a grip too. A predicted grip is retired once the
+/// server's joint arrives; a client's local Tool never needs replication.
+pub(crate) fn sync_grip(w: &mut World, tool: InstanceId) {
+    if !w.dom.is_a(tool, "Tool") {
+        return;
+    }
+    let dom = &mut w.dom;
+    let parts = dom.parent(tool).filter(|&c| dom.find_first_child_of_class(c, "Humanoid").is_some())
+        .filter(|&c| !w.is_client || dom.local_player().and_then(|p| dom.ref_property(p, "Character")) == Some(c))
+        .and_then(|character| {
+            let hand = dom.find_first_child(character, "RightHand", false)
+                .or_else(|| dom.find_first_child(character, "Right Arm", false))?;
+            let handle = dom.find_first_child(tool, "Handle", false)?;
+            (dom.is_a(hand, "BasePart") && dom.is_a(handle, "BasePart")).then_some((hand, handle))
+        });
+    let existing = w.tool_grips.remove(&tool);
+    if let Some(joint) = existing && parts.is_none_or(|(hand, handle)| {
+        dom.ref_property(joint, "Part0") != Some(hand)
+            || dom.ref_property(joint, "Part1") != Some(handle)
+            || dom.parent(joint) != Some(hand)
+    }) {
+        let _ = dom.destroy(joint);
+    }
+    let Some((hand, handle)) = parts else { return };
+    let grip = dom.cframe_property(tool, "Grip").unwrap_or(CFrame::IDENTITY);
+    // Replication adds the authoritative server joint after a local equip.
+    // Never retain two rigid joints joining the same hand and handle.
+    let authoritative = dom.children(hand).iter().copied().find(|&id| {
+        Some(id) != existing && dom.name(id) == "RightGrip" && dom.is_a(id, "JointInstance")
+            && dom.ref_property(id, "Part0") == Some(hand)
+            && dom.ref_property(id, "Part1") == Some(handle)
+    });
+    if w.is_client && let Some(joint) = authoritative {
+        if let Some(predicted) = existing { let _ = dom.destroy(predicted); }
+        let _ = dom.set_property_by_name(joint, "C1", Value::CFrame(grip));
+        w.tool_grips.insert(tool, joint);
+        return;
+    }
+    if let Some(joint) = existing.filter(|&id| dom.ref_property(id, "Part1") == Some(handle)
+        && dom.parent(id) == Some(hand))
+    {
+        let _ = dom.set_property_by_name(joint, "C1", Value::CFrame(grip));
+        w.tool_grips.insert(tool, joint);
+        return;
+    }
+    let local = dom.find_first_child(hand, "RightGripAttachment", false)
+        .and_then(|id| dom.cframe_property(id, "CFrame"))
+        .unwrap_or_else(|| if dom.name(hand) == "Right Arm" {
+            CFrame::from_position(glam::Vec3::new(0.0, -1.0, 0.0))
+        } else { CFrame::IDENTITY });
+    if let Some(hand_frame) = dom.cframe_property(hand, "CFrame") {
+        let _ = rook_physics::assembly::move_part(dom, handle, hand_frame * local * grip.inverse());
+    }
+    let Ok(joint) = dom.create_by_name("Weld") else { return };
+    let _ = dom.set_name(joint, "RightGrip".into());
+    for (key, value) in [
+        ("Part0", Value::Ref(Some(hand.to_ref()))),
+        ("Part1", Value::Ref(Some(handle.to_ref()))),
+        ("C0", Value::CFrame(local)),
+        ("C1", Value::CFrame(grip)),
+    ] {
+        let _ = dom.set_property_by_name(joint, key, value);
+    }
+    if dom.set_parent(joint, Some(hand)).is_ok() {
+        w.tool_grips.insert(tool, joint);
+    }
+}
