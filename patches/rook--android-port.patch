+//! Each contact keeps one Roblox InputObject through Begin/Change/End.
+use super::*;
+
+#[derive(Debug, Clone, Copy)]
+pub(super) struct Contact {
+    pub object: InstanceId,
+    pub position: (f32, f32),
+    start: (f32, f32),
+    began: f64,
+    possible_tap: bool,
+    processed: bool,
+}
+
+pub(super) fn tap_slop(viewport: (u32, u32)) -> f32 {
+    (viewport.0.min(viewport.1) as f32 * 0.018).clamp(8.0, 22.0)
+}
+
+const TAP_TIME: f64 = 0.5;
+const TOOL_HOLD_DELAY: f64 = 0.16;
+
+#[derive(Debug)]
+pub(super) struct ToolContact {
+    finger: u64,
+    tool: InstanceId,
+    attempted: bool,
+    active: bool,
+}
+
+impl DataModel {
+    pub(crate) fn update_touch_tool(&mut self) {
+        let Some(tool) = self.input.touch_tool.as_ref() else { return };
+        if self.runtime.local_equipped_tool() != Some(tool.tool) || self.runtime.menu_is_open() {
+            self.finish_touch_tool(false);
+            return;
+        }
+        let ready = self.input.touches.get(&tool.finger)
+            .is_some_and(|finger| self.now() - finger.began >= TOOL_HOLD_DELAY);
+        if let Some(tool) = self.input.touch_tool.as_mut() && ready && !tool.attempted {
+            tool.attempted = true;
+            tool.active = self.runtime.use_local_tool(tool.tool, true);
+        }
+    }
+
+    fn finish_touch_tool(&mut self, tap: bool) {
+        if let Some(tool) = self.input.touch_tool.take()
+            && (tool.active || (tap && !tool.attempted && self.runtime.use_local_tool(tool.tool, true)))
+        {
+            self.runtime.use_local_tool(tool.tool, false);
+        }
+    }
+
+    pub(super) fn note_input_type(&self, kind: UserInputType) {
+        let changed = {
+            let mut world = self.runtime.world_mut();
+            let previous = world.input.last_type.replace(kind);
+            previous != Some(kind)
+        };
+        if changed {
+            let uis = self
+                .runtime
+                .world_mut()
+                .dom
+                .get_service("UserInputService")
+                .ok();
+            if let Some(uis) = uis {
+                if let Some(preferred) = preferred_input(kind) {
+                    self.set_property(uis, "PreferredInput", preferred);
+                }
+                if let Ok(item) = rook_lua::input_type(self.runtime.lua(), kind) {
+                    self.fire(uis, "LastInputTypeChanged", item);
+                }
+            }
+        }
+    }
+
+    pub(super) fn cancel_touches(&mut self) {
+        let contacts: Vec<_> = self
+            .input
+            .touches
+            .iter()
+            .map(|(&id, c)| (id, c.position))
+            .collect();
+        for (id, position) in contacts {
+            self.touch(id, TouchPhase::Cancel, position);
+        }
+    }
+
+    pub(super) fn touch(
+        &mut self,
+        id: u64,
+        phase: TouchPhase,
+        position: (f32, f32),
+    ) -> (bool, Option<ClickEvent>) {
+        if !position.0.is_finite() || !position.1.is_finite() {
+            return (false, None);
+        }
+        if phase == TouchPhase::Begin {
+            if let Some(previous) = self.input.touches.get(&id).copied() {
+                self.touch(id, TouchPhase::Cancel, previous.position);
+            }
+            let Some(object) = self.new_input_object(
+                0,
+                UserInputType::Touch,
+                UserInputState::Begin,
+                gui_point(position),
+                (0.0, 0.0),
+            ) else {
+                return (false, None);
+            };
+            self.input.touches.insert(
+                id,
+                Contact {
+                    object,
+                    position,
+                    start: position,
+                    began: self.now(),
+                    possible_tap: true,
+                    processed: false,
+                },
+            );
+        }
+        let Some(contact) = self.input.touches.get(&id).copied() else {
+            return (false, None);
+        };
+        let state = match phase {
+            TouchPhase::Begin => UserInputState::Begin,
+            TouchPhase::Move => UserInputState::Change,
+            // Android cancellation releases the contact. The original camera
+            // module requires End on TouchEnded; GUI still sees Cancel below
+            // and must never turn this release into a button activation.
+            TouchPhase::End | TouchPhase::Cancel => UserInputState::End,
+        };
+        let point = gui_point(position);
+        let delta = (
+            position.0 - contact.position.0,
+            position.1 - contact.position.1,
+        );
+        self.set_property(
+            contact.object,
+            "Position",
+            Value::Vector3(Vector3::new(point.0, point.1, 0.0)),
+        );
+        self.set_property(
+            contact.object,
+            "Delta",
+            Value::Vector3(Vector3::new(delta.0, delta.1, 0.0)),
+        );
+        self.set_property(contact.object, "UserInputState", state.into());
+        let gui = self.gui_touch(id, phase, contact.object, position) || self.runtime.menu_is_open();
+        let processed = self.drag_touch(id, phase, position, gui) || gui;
+        // Tool.Activated can run before TouchTapInWorld (on End, or after
+        // a hold). Its Equipped mouse must already describe this contact,
+        // otherwise scripts using mouse.Hit/Target aim at the old cursor.
+        let tool_contact = self.input.touch_tool.as_ref().is_some_and(|tool| tool.finger == id)
+            || (phase == TouchPhase::Begin && self.runtime.local_equipped_tool().is_some());
+        if !processed && tool_contact {
+            self.runtime.world_mut().input.mouse = position;
+            self.look_for_detector();
+        }
+        let moved = (position.0 - contact.start.0).hypot(position.1 - contact.start.1);
+        let tap = contact.possible_tap && moved <= tap_slop(self.input.viewport);
+        if matches!(phase, TouchPhase::End | TouchPhase::Cancel) {
+            self.input.touches.remove(&id);
+        } else {
+            let competing_finger = phase == TouchPhase::Begin
+                && !processed
+                && self
+                    .input
+                    .touches
+                    .iter()
+                    .any(|(&other, contact)| other != id && !contact.processed);
+            if competing_finger {
+                self.finish_touch_tool(false);
+                for other in self
+                    .input
+                    .touches
+                    .values_mut()
+                    .filter(|other| !other.processed)
+                {
+                    other.possible_tap = false;
+                }
+            }
+            if phase == TouchPhase::Begin && !processed && !competing_finger
+                && let Some(tool) = self.runtime.local_equipped_tool()
+            {
+                self.input.touch_tool = Some(ToolContact { finger: id, tool, attempted: false, active: false });
+            }
+            if let Some(contact) = self.input.touches.get_mut(&id) {
+                contact.position = position;
+                contact.processed = processed;
+                contact.possible_tap = tap && !competing_finger;
+            }
+        }
+        let (input_event, touch_event) = match phase {
+            TouchPhase::Begin => ("InputBegan", "TouchStarted"),
+            TouchPhase::Move => ("InputChanged", "TouchMoved"),
+            TouchPhase::End | TouchPhase::Cancel => ("InputEnded", "TouchEnded"),
+        };
+        self.fire_input(input_event, contact.object, processed);
+        self.fire_input(touch_event, contact.object, processed);
+        self.offer_action(contact.object, processed);
+        let short_tap = phase == TouchPhase::End && tap && self.now() - contact.began <= TAP_TIME;
+        if self.input.touch_tool.as_ref().is_some_and(|tool| tool.finger == id)
+            && (processed || !tap || matches!(phase, TouchPhase::End | TouchPhase::Cancel))
+        {
+            self.finish_touch_tool(short_tap && !processed && !contact.processed);
+        }
+        let click = if short_tap {
+            self.touch_tap(position, processed || contact.processed)
+        } else {
+            None
+        };
+        (processed, click)
+    }
+
+    fn touch_tap(&mut self, position: (f32, f32), processed: bool) -> Option<ClickEvent> {
+        let uis = self
+            .runtime
+            .world_mut()
+            .dom
+            .get_service("UserInputService")
+            .ok()?;
+        let point = rook_types::Vector2::new(position.0, position.1);
+        self.runtime.fire_touch_tap(uis, point, processed);
+        if processed {
+            return None;
+        }
+        self.runtime.world_mut().input.mouse = position;
+        let detector = self.look_for_detector();
+        detector.map(|detector| ClickEvent {
+            detector,
+            kind: ClickKind::Click,
+        })
+    }
+}
