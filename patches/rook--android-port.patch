+-- Inventory for sessions whose original CoreScripts did not build a Backpack UI.
+-- Uses ordinary public Tool/Humanoid APIs. Never sends client-created objects
+-- to the server or replaces a game's custom inventory when CoreGui is disabled.
+local player = game.Players.LocalPlayer
+local starter = game:GetService("StarterGui")
+local gui = Instance.new("ScreenGui")
+gui.Name = "RbxMobileInventory"
+gui.ResetOnSpawn = false
+gui.IgnoreGuiInset = true
+gui.DisplayOrder = 2
+local row = Instance.new("ScrollingFrame", gui)
+row.Name = "Hotbar"
+row.AnchorPoint = Vector2.new(0.5, 1)
+row.Position = UDim2.new(0.5, 0, 1, -18)
+row.Size = UDim2.new(0.55, 0, 0, 66)
+row.BackgroundTransparency = 1
+row.BorderSizePixel = 0
+row.ScrollBarThickness = 3
+row.ScrollingDirection = Enum.ScrollingDirection.X
+local slots = {}
+local queued = false
+local connections = {}
+local uiScale = 1
+
+local function viewportScale()
+    local camera = workspace.CurrentCamera
+    return math.clamp((if camera then camera.ViewportSize.Y else 480) / 480, 1, 2.5)
+end
+
+local function originalInventory()
+    local core = game:GetService("CoreGui")
+    local root = core:FindFirstChild("RobloxGui")
+    return (root and root:FindFirstChild("Backpack")) or core:FindFirstChild("BackpackGui")
+end
+
+local function visible()
+    local ok, enabled = pcall(function() return starter:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) end)
+    gui.Enabled = (not ok or enabled) and not originalInventory() and #slots > 0
+end
+
+local function equip(tool)
+    local character = player.Character
+    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
+    if not humanoid or humanoid.Health <= 0 then return end
+    if tool.Parent == character then humanoid:UnequipTools() else humanoid:EquipTool(tool) end
+end
+
+local function rebuild()
+    queued = false
+    uiScale = viewportScale()
+    row.Position = UDim2.new(0.5, 0, 1, -18 * uiScale)
+    row.Size = UDim2.new(0.55, 0, 0, 66 * uiScale)
+    for _, connection in connections do connection:Disconnect() end
+    table.clear(connections)
+    for _, child in row:GetChildren() do child:Destroy() end
+    local present = {}
+    for _, container in {player:FindFirstChildOfClass("Backpack"), player.Character} do
+        if container then
+            for _, tool in container:GetChildren() do
+                if tool:IsA("Tool") then present[tool] = true end
+            end
+        end
+    end
+    local nextSlots = {}
+    for _, tool in slots do
+        if present[tool] then table.insert(nextSlots, tool); present[tool] = nil end
+    end
+    for tool in present do table.insert(nextSlots, tool) end
+    slots = nextSlots
+    row.CanvasSize = UDim2.fromOffset(#slots * 62 * uiScale, 62 * uiScale)
+    for index, tool in slots do
+        local button = Instance.new("TextButton", row)
+        button.Name = "Slot" .. index
+        button.Position = UDim2.fromOffset((index-1)*62 * uiScale, 0)
+        button.Size = UDim2.fromOffset(58 * uiScale, 60 * uiScale)
+        button.BackgroundColor3 = if tool.Parent == player.Character then Color3.fromRGB(61, 94, 135) else Color3.fromRGB(30, 36, 46)
+        button.BackgroundTransparency = 0.12
+        button.TextColor3 = Color3.new(1, 1, 1)
+        button.TextSize = 13 * uiScale
+        button.TextWrapped = true
+        button.Text = (if index <= 10 then tostring(index % 10) .. "\n" else "") .. tool.Name
+        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
+        table.insert(connections, button.Activated:Connect(function() equip(tool) end))
+        table.insert(connections, tool:GetPropertyChangedSignal("Name"):Connect(function() button.Text = tool.Name end))
+    end
+    visible()
+end
+
+local function schedule()
+    if queued then return end
+    queued = true
+    task.defer(rebuild)
+end
+
+local watching = {}
+local function watch()
+    for _, connection in watching do connection:Disconnect() end
+    table.clear(watching)
+    for _, container in {player:FindFirstChildOfClass("Backpack"), player.Character} do
+        if container then
+            table.insert(watching, container.ChildAdded:Connect(schedule))
+            table.insert(watching, container.ChildRemoved:Connect(schedule))
+        end
+    end
+    schedule()
+end
+player.CharacterAdded:Connect(watch)
+player.ChildAdded:Connect(function(child) if child:IsA("Backpack") then watch() end end)
+game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
+    if processed or not gui.Enabled then return end
+    local keys = {One=1, Two=2, Three=3, Four=4, Five=5, Six=6, Seven=7, Eight=8, Nine=9, Zero=10}
+    local index = keys[input.KeyCode.Name]
+    if index and slots[index] then equip(slots[index]) end
+end)
+local elapsed = 0
+game:GetService("RunService").Heartbeat:Connect(function(dt)
+    elapsed += dt
+    if elapsed >= 0.25 then
+        elapsed = 0
+        if math.abs(viewportScale() - uiScale) > 0.01 then schedule() end
+        visible()
+    end
+end)
+gui.Parent = game:GetService("CoreGui")
+watch()
diff --git a/crates/rook-engine/src/session/host/prompt_ui.luau b/crates/rook-engine/src/session/host/prompt_ui.luau
