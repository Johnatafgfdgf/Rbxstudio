@@ -0,0 +1,113 @@
+//! HumanoidDescription's emote collections, used by Roblox's CoreScripts.
+//! Contract: create.roblox.com/docs/reference/engine/classes/HumanoidDescription.
+//! Collections are instance data, not shared Lua tables; getters and events
+//! return fresh copies, and Instance:Clone retains an independent collection.
+use super::super::*;
+use rook_dom::Emotes;
+use mlua::Table;
+
+fn state(lua: &Lua, this: InstanceId) -> Emotes {
+    with_world(lua, |w| w.dom.get(this).and_then(|i| i.emotes.as_deref()).cloned().unwrap_or_default())
+}
+
+fn dictionary(lua: &Lua, state: &Emotes) -> mlua::Result<Table> {
+    let table = lua.create_table()?;
+    for (name, ids) in &state.entries {
+        table.raw_set(name.as_str(), lua.create_sequence_from(ids.iter().copied())?)?;
+    }
+    Ok(table)
+}
+
+fn equipped(lua: &Lua, state: &Emotes) -> mlua::Result<Table> {
+    let table = lua.create_table()?;
+    for (index, (slot, name)) in state.equipped.iter().enumerate() {
+        let entry = lua.create_table()?;
+        entry.raw_set("Slot", *slot)?;
+        entry.raw_set("Name", name.as_str())?;
+        table.raw_set(index + 1, entry)?;
+    }
+    Ok(table)
+}
+
+fn store(lua: &Lua, this: InstanceId, state: Emotes, equipped_changed: bool) -> ApiResult<Outcome> {
+    let value = if equipped_changed { equipped(lua, &state)? } else { dictionary(lua, &state)? };
+    mutate(lua, |w| {
+        if let Some(instance) = w.dom.instance_mut(this) { instance.emotes = Some(Box::new(state)); }
+        Ok(())
+    })?;
+    fire(lua, &SignalKey::event(this, if equipped_changed { "EquippedEmotesChanged" } else { "EmotesChanged" }), &[LuaValue::Table(value)]);
+    Outcome::ret(lua, ())
+}
+
+fn table_argument(a: &Args) -> ApiResult<Table> {
+    match a.get(0) { LuaValue::Table(table) => Ok(table.clone()), _ => Err(a.wrong(0, "table")) }
+}
+
+fn asset_id(value: &LuaValue) -> ApiResult<i64> {
+    let number = crate::ctx::args::number_of(value).ok_or_else(|| ScriptError("Emote asset ID must be a positive integer".into()))?;
+    if !number.is_finite() || number <= 0. || number.fract() != 0. || number >= i64::MAX as f64 {
+        return Err(ScriptError("Emote asset ID must be a positive integer".into()));
+    }
+    Ok(number as i64)
+}
+
+pub(super) fn get(lua: &Lua, this: InstanceId, _: &Args) -> ApiResult<Outcome> {
+    Outcome::ret(lua, dictionary(lua, &state(lua, this))?)
+}
+
+pub(super) fn get_equipped(lua: &Lua, this: InstanceId, _: &Args) -> ApiResult<Outcome> {
+    Outcome::ret(lua, equipped(lua, &state(lua, this))?)
+}
+
+pub(super) fn set(lua: &Lua, this: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let mut next = state(lua, this);
+    let mut entries = std::collections::BTreeMap::new();
+    for pair in table_argument(a)?.pairs::<LuaValue, LuaValue>() {
+        let (name, ids) = pair?;
+        let (LuaValue::String(name), LuaValue::Table(ids)) = (name, ids) else {
+            return Err(ScriptError("Emotes must map names to arrays of asset IDs".into()));
+        };
+        let mut values = Vec::new();
+        for id in ids.sequence_values::<LuaValue>() { values.push(asset_id(&id?)?); }
+        if values.is_empty() { return Err(ScriptError("An emote must contain at least one asset ID".into())); }
+        entries.insert(name.to_string_lossy(), values);
+    }
+    next.entries = entries;
+    store(lua, this, next, false)
+}
+
+pub(super) fn add(lua: &Lua, this: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let name = a.string(0)?;
+    let id = asset_id(a.get(1))?;
+    let mut next = state(lua, this);
+    let ids = next.entries.entry(name).or_default();
+    if !ids.contains(&id) { ids.push(id); }
+    store(lua, this, next, false)
+}
+
+pub(super) fn remove(lua: &Lua, this: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let name = a.string(0)?;
+    let mut next = state(lua, this);
+    next.entries.remove(&name);
+    store(lua, this, next, false)
+}
+
+pub(super) fn set_equipped(lua: &Lua, this: InstanceId, a: &Args) -> ApiResult<Outcome> {
+    let mut next = state(lua, this);
+    let mut values = Vec::new();
+    let mut slots = std::collections::HashSet::new();
+    for (index, value) in table_argument(a)?.sequence_values::<LuaValue>().enumerate() {
+        let (slot, name) = match value? {
+            LuaValue::String(name) => ((index + 1) as i64, name.to_string_lossy()),
+            LuaValue::Table(entry) => (entry.raw_get::<i64>("Slot")?, entry.raw_get::<String>("Name")?),
+            _ => return Err(ScriptError("Equipped emotes must be names or Slot/Name tables".into())),
+        };
+        if !(1..=8).contains(&slot) || !slots.insert(slot) {
+            return Err(ScriptError("Equipped emote slots must be unique integers from 1 to 8".into()));
+        }
+        if !next.entries.contains_key(&name) { return Err(ScriptError(format!("Emote {name} is not in this description"))); }
+        values.push((slot as u8, name));
+    }
+    next.equipped = values;
+    store(lua, this, next, true)
+}
