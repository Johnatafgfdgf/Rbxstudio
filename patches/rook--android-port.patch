+//! entries in rbx-native's shell/rig/animate.rs. Assets use the usual
+//! content resolver and cache.
+
+use std::sync::Arc;
+use std::sync::mpsc::{self, Receiver};
+
+use rook_content::{ContentRef, Resolver};
+use rook_dom::{Dom, InstanceId};
+use rook_physics::humanoid::State;
+use rook_types::CFrame;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) enum Action {
+    Walk,
+    Run,
+    Idle,
+    Jump,
+    Fall,
+    Climb,
+    Swim,
+    SwimIdle,
+    Sit,
+}
+
+impl Action {
+    const ALL: [Self; 9] = [
+        Self::Walk,
+        Self::Run,
+        Self::Idle,
+        Self::Jump,
+        Self::Fall,
+        Self::Climb,
+        Self::Swim,
+        Self::SwimIdle,
+        Self::Sit,
+    ];
+
+    pub(super) fn select(state: State, speed: f32) -> Option<Self> {
+        Some(match state {
+            State::Jumping => Self::Jump,
+            State::Freefall => Self::Fall,
+            State::Seated => Self::Sit,
+            State::Climbing => Self::Climb,
+            State::Swimming if speed > 0.4 => Self::Swim,
+            State::Swimming => Self::SwimIdle,
+            State::Running | State::Landed if speed >= 11.0 => Self::Run,
+            State::Running | State::Landed if speed > 0.4 => Self::Walk,
+            State::Running | State::Landed => Self::Idle,
+            _ => return None,
+        })
+    }
+
+    fn folder(self) -> &'static str {
+        match self {
+            Self::Walk => "walk",
+            Self::Run => "run",
+            Self::Idle => "idle",
+            Self::Jump => "jump",
+            Self::Fall => "fall",
+            Self::Climb => "climb",
+            Self::Swim => "swim",
+            Self::SwimIdle => "swimidle",
+            Self::Sit => "sit",
+        }
+    }
+
+    fn reference(self, dom: &Dom, character: InstanceId, r15: bool) -> Option<ContentRef> {
+        let configured = dom
+            .find_first_child(character, "Animate", false)
+            .and_then(|animate| dom.find_first_child(animate, self.folder(), false))
+            .and_then(|state| dom.find_first_child_of_class(state, "Animation"))
+            .and_then(|animation| rook_lua::animation_reference(dom, animation));
+        let id = match (self, r15) {
+            (Self::Walk, true) => 913402848,
+            (Self::Run, true) => 913376220,
+            (Self::Idle, true) => 507766388,
+            (Self::Jump, true) => 507765000,
+            (Self::Fall, true) => 507767968,
+            (Self::Climb, true) => 507765644,
+            (Self::Swim, true) => 913384386,
+            (Self::SwimIdle, true) => 913389285,
+            (Self::Sit, true) => 2506281703,
+            (Self::Walk | Self::Run, false) => 180426354,
+            (Self::Idle, false) => 180435571,
+            (Self::Jump, false) => 125750702,
+            (Self::Fall, false) => 180436148,
+            (Self::Climb, false) => 180436334,
+            (Self::Sit, false) => 178130996,
+            (Self::Swim | Self::SwimIdle, false) => 0,
+        };
+        configured.or_else(|| (id != 0).then_some(ContentRef::Asset { id, version: None }))
+    }
+
+    fn speed(self, r15: bool, speed: f32, vertical: f32) -> f32 {
+        match self {
+            Self::Walk if r15 => (speed / 6.4).clamp(0.15, 3.0),
+            Self::Walk | Self::Run => (speed / if r15 { 16.0 } else { 14.5 }).clamp(0.15, 3.0),
+            Self::Climb => (vertical.abs() / 5.0).min(3.0),
+            Self::Swim => (speed / 10.0).clamp(0.15, 3.0),
+            _ => 1.0,
+        }
+    }
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Player {
+    clips: FxHashMap<Action, Arc<Clip>>,
+    ready: Option<Receiver<(Action, Arc<Clip>)>>,
+    action: Option<Action>,
+    time: f32,
+    r15: bool,
+}
+
+impl Player {
+    pub(super) fn load(
+        resolver: Option<&Arc<Resolver>>,
+        dom: &Dom,
+        character: InstanceId,
+        r15: bool,
+    ) -> Self {
+        let Some(resolver) = resolver.cloned() else {
+            return Self::default();
+        };
+        let requested: Vec<_> = Action::ALL
+            .into_iter()
+            .filter_map(|action| Some((action, action.reference(dom, character, r15)?)))
+            .collect();
+        let parts: FxHashSet<_> = dom
+            .children(character)
+            .iter()
+            .copied()
+            .filter(|&part| dom.is_a(part, "BasePart"))
+            .map(|part| dom.name(part).to_owned())
+            .collect();
+        let (tx, rx) = mpsc::channel();
+        #[cfg(not(target_arch = "wasm32"))]
+        let _ = std::thread::Builder::new()
+            .name("rook-avatar-clips".into())
+            .spawn(move || {
+                let mut decoded = FxHashMap::<ContentRef, Option<Arc<Clip>>>::default();
+                for (action, reference) in requested {
+                    let result = decoded.entry(reference.clone()).or_insert_with(|| {
+                        let fetched = resolver.resolve(&reference).ok()?;
+                        Clip::decode(&fetched.bytes, Some(&parts)).map(Arc::new)
+                    });
+                    if let Some(clip) = result {
+                        if tx.send((action, clip.clone())).is_err() {
+                            return;
+                        }
+                        tracing::debug!(?reference, ?action, "Avatar animation keyframes loaded");
+                    }
+                }
+            });
+        #[cfg(target_arch = "wasm32")]
+        drop((requested, resolver, parts, tx));
+        Self {
+            ready: Some(rx),
+            r15,
+            ..Self::default()
+        }
+    }
+
+    pub(super) fn sample(
+        &mut self,
+        action: Action,
+        speed: f32,
+        vertical: f32,
+        dt: f32,
+    ) -> Option<(&Clip, f32)> {
+        if let Some(ready) = &self.ready {
+            self.clips.extend(ready.try_iter());
+        }
+        if self.action != Some(action) {
+            self.action = Some(action);
+            self.time = 0.0;
+        }
+        let clip = self.clips.get(&action)?;
+        self.time += dt * action.speed(self.r15, speed, vertical);
+        self.time = if matches!(action, Action::Jump | Action::Sit) {
+            self.time.min(clip.duration)
+        } else {
+            self.time % clip.duration
+        };
+        Some((clip.as_ref(), self.time))
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct Clip {
+    pub(crate) duration: f32,
+    pub(crate) looped: bool,
+    pub(crate) priority: Option<u32>,
+    pub(crate) markers: Vec<(f32, String, String)>,
+    tracks: FxHashMap<String, Vec<Key>>,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Key {
+    time: f32,
+    transform: CFrame,
+    style: PoseEase,
+    direction: EaseDirection,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum PoseEase {
+    Linear,
+    Constant,
+    Cubic,
+    Elastic,
+    Bounce,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum EaseDirection {
+    In,
+    Out,
+    InOut,
+}
+
+impl Key {
+    fn eased(self, t: f32) -> f32 {
+        if matches!(self.style, PoseEase::Constant) {
+            return 0.0;
+        }
+        let ease_in = |x: f32| match self.style {
+            PoseEase::Linear | PoseEase::Constant => x,
+            PoseEase::Cubic => x * x * x,
+            PoseEase::Elastic if x == 0.0 || x == 1.0 => x,
+            PoseEase::Elastic => {
+                -2.0f32.powf(10.0 * (x - 1.0))
+                    * ((x * 10.0 - 10.75) * (std::f32::consts::TAU / 3.0)).sin()
+            }
+            PoseEase::Bounce => 1.0 - bounce_out(1.0 - x),
+        };
+        match self.direction {
+            EaseDirection::In => ease_in(t),
+            EaseDirection::Out => 1.0 - ease_in(1.0 - t),
+            EaseDirection::InOut if t < 0.5 => ease_in(t * 2.0) * 0.5,
+            EaseDirection::InOut => 1.0 - ease_in(2.0 - 2.0 * t) * 0.5,
+        }
+    }
+}
+
+fn bounce_out(mut t: f32) -> f32 {
+    let (n, d) = (7.5625, 2.75);
+    if t < 1.0 / d {
+        return n * t * t;
+    }
+    if t < 2.0 / d {
+        t -= 1.5 / d;
+        return n * t * t + 0.75;
+    }
+    if t < 2.5 / d {
+        t -= 2.25 / d;
+        return n * t * t + 0.9375;
+    }
+    t -= 2.625 / d;
+    n * t * t + 0.984375
+}
+
+impl Clip {
+    pub(crate) fn decode(bytes: &[u8], parts: Option<&FxHashSet<String>>) -> Option<Self> {
+        if bytes.len() > 8 * 1024 * 1024 {
+            return None;
+        }
+        let file = rook_formats::load(bytes).ok()?;
+        let mut dom = Dom::new();
+        let root = dom.root();
+        let top = rook_formats::into_dom(file.dom, &mut dom, root).top;
+        let sequence = top
+            .into_iter()
+            .find(|&id| dom.class_name(id) == "KeyframeSequence")?;
+        let mut tracks = FxHashMap::<String, Vec<Key>>::default();
+        let mut duration = 0.0f32;
+        let mut markers = Vec::new();
+        for &frame in dom.children(sequence) {
+            if dom.class_name(frame) != "Keyframe" {
+                continue;
+            }
+            let Some(time) = dom
+                .float_property(frame, "Time")
+                .filter(|t| t.is_finite() && *t >= 0.0)
+            else {
+                continue;
+            };
+            duration = duration.max(time);
+            markers.extend(dom.children(frame).iter().copied()
+                .filter(|&id| dom.is_a(id, "KeyframeMarker"))
+                .map(|id| (time, dom.name(id).to_owned(), dom.string_property(id, "Value")
+                    .unwrap_or_default().to_owned())));
+            for pose in dom.descendants(frame) {
+                if dom.class_name(pose) != "Pose"
+                    || parts.is_some_and(|parts| !parts.contains(dom.name(pose)))
+                    || dom
+                        .float_property(pose, "Weight")
+                        .is_some_and(|weight| weight <= 0.0)
+                {
+                    continue;
+                }
+                let Some(transform) = dom.cframe_property(pose, "CFrame") else {
+                    continue;
+                };
+                if !transform.position.is_finite() || !transform.rotation.is_finite() {
+                    continue;
+                }
+                let style = match dom.enum_item_property(pose, "EasingStyle") {
+                    Some("Constant") => PoseEase::Constant,
+                    Some("Cubic" | "CubicV2") => PoseEase::Cubic,
+                    Some("Elastic") => PoseEase::Elastic,
+                    Some("Bounce") => PoseEase::Bounce,
+                    _ => PoseEase::Linear,
+                };
+                let direction = match dom.enum_item_property(pose, "EasingDirection") {
+                    Some("Out") => EaseDirection::Out,
+                    Some("InOut") => EaseDirection::InOut,
+                    _ => EaseDirection::In,
+                };
+                tracks
+                    .entry(dom.name(pose).to_owned())
+                    .or_default()
+                    .push(Key {
+                        time,
+                        transform: transform.orthonormalize(),
+                        style,
+                        direction,
+                    });
+            }
+        }
+        for keys in tracks.values_mut() {
+            keys.sort_by(|a, b| a.time.total_cmp(&b.time));
+        }
+        markers.sort_by(|a, b| a.0.total_cmp(&b.0));
+        (duration > 0.0 && !tracks.is_empty()).then_some(Self {
+            duration, tracks, markers,
+            looped: dom.bool_property(sequence, "Loop") == Some(true),
+            priority: dom.enum_property(sequence, "Priority"),
+        })
+    }
+
+    pub(crate) fn transform(&self, part: &str, time: f32) -> Option<CFrame> {
+        let keys = self.tracks.get(part)?;
+        let after = keys.partition_point(|key| key.time <= time);
+        match (
+            after.checked_sub(1).and_then(|i| keys.get(i)),
+            keys.get(after),
+        ) {
+            (Some(a), Some(b)) => {
+                let t = (time - a.time) / (b.time - a.time);
+                Some(a.transform.lerp(b.transform, a.eased(t)))
+            }
+            (Some(key), None) | (None, Some(key)) => Some(key.transform),
+            (None, None) => None,
+        }
+    }
+}
