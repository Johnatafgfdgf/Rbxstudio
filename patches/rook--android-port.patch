+/// Some asset IDs refer to a Decal model wrapping the actual image.
+fn decal_image(bytes: &[u8]) -> Option<ContentRef> {
+    if bytes.len() > 8 * 1024 * 1024 || rook_formats::Format::detect(bytes).is_none() {
+        return None;
+    }
+    let file = rook_formats::load(bytes).ok()?;
+    let mut refs = file.dom.root().children().to_vec();
