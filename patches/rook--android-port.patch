index 0000000..a86e721
--- /dev/null
+++ b/crates/rook-engine/src/locomotion.rs
@@ -0,0 +1,324 @@
+//! Mobile animation poses for the stock character. The renderer uses these
+//! poses without changing the assembly, its collisions, or script properties.
+
+pub(crate) mod clips;
+
+use std::f32::consts::TAU;
+use std::sync::Arc;
+
+use clips::{Action, Player};
+use rook_content::Resolver;
+
+use rook_dom::{Dom, InstanceId};
+use rook_physics::Physics;
+use rook_physics::humanoid::State;
+use rook_physics::joints::{Joint, JointKind, active_joint};
+use rook_types::CFrame;
+use rustc_hash::FxHashMap;
+
+#[derive(Debug, Default)]
+pub(crate) struct Locomotion {
+    character: Option<(InstanceId, Option<u64>)>,
+    resolver: Option<Arc<Resolver>>,
+    player: Player,
+    rig: Option<Rig>,
+    phase: f32,
+    idle: f32,
+}
+
+#[derive(Debug)]
+struct Rig {
+    humanoid: InstanceId,
+    grip_parent: Option<(InstanceId, Option<u64>)>,
+    parts: Vec<Part>,
+    indices: FxHashMap<InstanceId, usize>,
+    joints: Vec<Bone>,
+}
+
+#[derive(Debug)]
+struct Part {
+    id: InstanceId,
+    base: CFrame,
+    posed: CFrame,
+}
+
+#[derive(Debug)]
+struct Bone {
+    joint: Joint,
+    parent: usize,
+    child: usize,
+    pivot: &'static str,
+    motion: Motion,
+    pose: CFrame,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum Motion {
+    Torso,
+    Leg(f32),
+    Knee(f32),
+    Foot(f32),
+    Arm(f32),
+    Elbow(f32),
+    Follow,
+}
+
+impl Motion {
+    fn of(name: &str) -> Self {
+        match name {
+            "Torso" | "UpperTorso" => Self::Torso,
+            "LeftUpperLeg" | "Left Leg" => Self::Leg(1.0),
+            "RightUpperLeg" | "Right Leg" => Self::Leg(-1.0),
+            "LeftLowerLeg" => Self::Knee(1.0),
+            "RightLowerLeg" => Self::Knee(-1.0),
+            "LeftFoot" => Self::Foot(1.0),
+            "RightFoot" => Self::Foot(-1.0),
+            "LeftUpperArm" | "Left Arm" => Self::Arm(1.0),
+            "RightUpperArm" | "Right Arm" => Self::Arm(-1.0),
+            "LeftLowerArm" => Self::Elbow(1.0),
+            "RightLowerArm" => Self::Elbow(-1.0),
+            _ => Self::Follow,
+        }
+    }
+
+    fn angles(self, stride: f32, idle: f32, walk: f32, air: f32, rise: bool) -> (f32, f32) {
+        match self {
+            Self::Torso => (
+                -0.08 * walk + 0.09 * air + idle * 0.025,
+                stride * walk * 0.035,
+            ),
+            Self::Leg(side) => (
+                stride * side * walk * 0.66 + air * (0.32 + 0.15 * side),
+                0.0,
+            ),
+            Self::Knee(side) => (-(stride * side).max(0.0) * walk * 0.52 - air * 0.58, 0.0),
+            Self::Foot(side) => (-stride * side * walk * 0.13 + air * 0.15, 0.0),
+            Self::Arm(side) => (
+                -stride * side * walk * 0.47 + air * if rise { 0.84 } else { 0.34 } + idle * 0.035,
+                -side * (0.04 + air * 0.56),
+            ),
+            Self::Elbow(side) => (
+                0.1 + (stride * side).max(0.0) * walk * 0.26 + air * 0.26,
+                0.0,
+            ),
+            Self::Follow => (0.0, 0.0),
+        }
+    }
+}
+
+impl Rig {
+    fn new(dom: &Dom, character: InstanceId) -> Option<Self> {
+        // A game's own rig or explicitly posed rig owns its animation.
+        if dom
+            .find_service("StarterPlayer")
+            .and_then(|starter| dom.find_first_child(starter, "StarterCharacter", false))
+            .is_some()
+        {
+            return None;
+        }
+        let root = dom.find_first_child(character, "HumanoidRootPart", false)?;
+        let humanoid = dom.find_first_child_of_class(character, "Humanoid")?;
+        let candidates: Vec<_> = dom
+            .descendants(character)
+            .into_iter()
+            .filter_map(|id| active_joint(dom, id))
+            .filter(|joint| {
+                joint.kind.is_rigid()
+                    && dom.is_ancestor_of(character, joint.part0)
+                    && dom.is_ancestor_of(character, joint.part1)
+            })
+            .collect();
+        let mut rig = Self {
+            humanoid,
+            grip_parent: dom.find_first_child(character, "RightHand", false)
+                .or_else(|| dom.find_first_child(character, "Right Arm", false))
+                .map(|hand| (hand, dom.children_version(hand))),
+            parts: vec![Part::new(root)],
+            indices: FxHashMap::default(),
+            joints: Vec::new(),
+        };
+        rig.indices.insert(root, 0);
+        let mut parent = 0;
+        // Visit outward from the root. Passive welds let accessories follow
+        // their limb, and the part index keeps cycles out of the pose graph.
+        while let Some(part) = rig.parts.get(parent) {
+            let id = part.id;
+            for &joint in candidates.iter().filter(|j| j.part0 == id || j.part1 == id) {
+                let child = joint.other(id);
+                if rig.indices.contains_key(&child) {
+                    continue;
+                }
+                let motion = if joint.kind == JointKind::Motor6D {
+                    Motion::of(dom.name(child))
+                } else {
+                    Motion::Follow
+                };
+                let index = rig.parts.len();
+                rig.parts.push(Part::new(child));
+                rig.indices.insert(child, index);
+                rig.joints.push(Bone {
+                    joint,
+                    parent,
+                    child: index,
+                    pivot: if id == joint.part0 { "C0" } else { "C1" },
+                    motion,
+                    pose: CFrame::IDENTITY,
+                });
+            }
+            parent += 1;
+        }
+        rig.joints
+            .iter()
+            .any(|j| matches!(j.motion, Motion::Leg(_)))
+            .then_some(rig)
+    }
+}
+
+impl Part {
+    fn new(id: InstanceId) -> Self {
+        Self {
+            id,
+            base: CFrame::IDENTITY,
+            posed: CFrame::IDENTITY,
+        }
+    }
+}
+
+impl Locomotion {
+    pub(crate) fn new(resolver: Option<Arc<Resolver>>) -> Self {
+        Self {
+            resolver,
+            ..Self::default()
+        }
+    }
+
+    pub(crate) fn apply(
+        &mut self,
+        dom: &Dom,
+        physics: &Physics,
+        drawn: &mut Vec<(InstanceId, CFrame)>,
+        dt: f32,
+    ) {
+        let character = dom
+            .local_player()
+            .and_then(|p| dom.ref_property(p, "Character"));
+        let current = character.map(|id| (id, dom.children_version(id)));
+        // A server grip may arrive after the client's local Tool move.
+        let grip_changed = self.rig.as_ref().and_then(|rig| rig.grip_parent)
+            .is_some_and(|(hand, version)| dom.children_version(hand) != version);
+        if current != self.character || grip_changed {
+            let respawned = self.character.map(|(id, _)| id) != character || self.rig.is_none();
+            self.character = current;
+            self.rig = character.and_then(|id| Rig::new(dom, id));
+            if respawned {
+                self.player = match (character, &self.rig) {
+                    (Some(id), Some(_)) => {
+                        let r15 = dom.find_first_child(id, "UpperTorso", false).is_some();
+                        Player::load(self.resolver.as_ref(), dom, id, r15)
+                    }
+                    _ => Player::default(),
+                };
+                self.phase = 0.0;
+            }
+        }
+        let Some(rig) = &mut self.rig else {
+            return;
+        };
+        let state = physics
+            .humanoid_state(rig.humanoid)
+            .unwrap_or(State::Running);
+        if dom
+            .float_property(rig.humanoid, "Health")
+            .is_some_and(|health| health <= 0.0)
+            || rig.joints.iter().any(|bone| {
+                let joint = bone.joint;
+                dom.is_destroyed(joint.id)
+                    || dom.bool_property(joint.id, "Enabled") == Some(false)
+                    || (joint.kind == JointKind::Motor6D
+                        && dom
+                            .cframe_property(joint.id, "Transform")
+                            .is_some_and(|pose| pose != CFrame::IDENTITY))
+            })
+        {
+            return;
+        }
+        let root = rig.parts[0].id;
+        let velocity = dom
+            .vector3_property(root, "AssemblyLinearVelocity")
+            .unwrap_or_default();
+        let speed = velocity.x.hypot(velocity.z);
+        if !speed.is_finite() {
+            return;
+        }
+        let dt = dt.clamp(0.0, 0.08);
+        let Some(action) = Action::select(state, speed) else {
+            return;
+        };
+        let clip = self.player.sample(action, speed, velocity.y, dt);
+        if clip.is_none()
+            && matches!(
+                action,
+                Action::Climb | Action::Sit | Action::Swim | Action::SwimIdle
+            )
+        {
+            return;
+        }
+        let airborne = matches!(state, State::Jumping | State::Freefall);
+        let walk = if airborne {
+            0.0
+        } else {
+            ((speed - 0.2) / 9.0).clamp(0.0, 1.0)
+        };
+        self.phase = (self.phase + (1.6 + speed.min(30.0) * 0.70) * dt * walk) % TAU;
+        self.idle = (self.idle + 2.2 * dt) % TAU;
+
+        for part in &mut rig.parts {
+            let Some(base) = dom.cframe_property(part.id, "CFrame") else {
+                return;
+            };
+            part.base = base;
+        }
+        for &(id, pose) in drawn.iter() {
+            if let Some(&index) = rig.indices.get(&id) {
+                rig.parts[index].base = pose;
+            }
+        }
+
+        rig.parts[0].posed = rig.parts[0].base;
+        let blend = 1.0 - (-14.0 * dt).exp();
+        for bone in &mut rig.joints {
+            let parent = &rig.parts[bone.parent];
+            let child = &rig.parts[bone.child];
+            let relative = parent.base.inverse() * child.base;
+            let pivot = dom
+                .cframe_property(bone.joint.id, bone.pivot)
+                .unwrap_or_default();
+            let swing = if let Some((clip, time)) = clip {
+                let transform = if bone.joint.kind == JointKind::Motor6D {
+                    clip.transform(dom.name(child.id), time).unwrap_or_default()
+                } else {
+                    CFrame::IDENTITY
+                };
+                let transform = if bone.pivot == "C1" {
+                    transform.inverse()
+                } else {
+                    transform
+                };
+                pivot * transform * pivot.inverse()
+            } else {
+                let (pitch, roll) = bone.motion.angles(
+                    self.phase.sin(),
+                    self.idle.sin(),
+                    walk,
+                    f32::from(u8::from(airborne)),
+                    state == State::Jumping || velocity.y > 0.0,
+                );
+                let centre = CFrame::from_position(pivot.position);
+                centre * CFrame::angles(pitch, 0.0, roll) * centre.inverse()
+            };
+            bone.pose = bone.pose.lerp(swing, blend);
+            rig.parts[bone.child].posed = parent.posed * bone.pose * relative;
+        }
+        drawn.extend(rig.parts.iter().skip(1).map(|part| (part.id, part.posed)));
+    }
+}
