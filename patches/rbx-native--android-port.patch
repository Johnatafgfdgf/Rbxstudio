+}
+
+#[cfg(target_os = "android")]
+pub(crate) fn set_test_link(path: &Path, target: Option<crate::settings::PlaySandbox>) -> Result<(), String> {
+    let file = default_config_dir().ok_or("Pasta de configuração indisponível")?.join("test-links.json");
+    // Do not overwrite a corrupt/unreadable mapping with an empty one.
+    let mut links: Links = match std::fs::read(&file) {
+        Ok(bytes) => serde_json::from_slice(&bytes).map_err(|e| format!("Vínculos de teste inválidos: {e}"))?,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Links::new(),
+        Err(e) => return Err(e.to_string()),
+    };
+    let key = link_key(path);
+    match target {
+        Some(target) => { links.insert(key, Link { universe_id: target.universe_id, place_id: target.place_id, name: None }); }
+        None => { links.remove(&key); }
+    }
+    let bytes = serde_json::to_vec_pretty(&links).map_err(|e| e.to_string())?;
+    write_atomic(&file, &bytes).map_err(|e| e.to_string())
+}
