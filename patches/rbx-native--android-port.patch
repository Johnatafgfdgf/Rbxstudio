+//! The five vector pieces of the Rbx Studio mark, shared by chrome and splash.
+use gpui_kit::component::Icon;
+use gpui_kit::*;
+
+const OUTLINES: [&[u8]; 5] = [
+    include_bytes!("../../../assets/icons/brand/rbx-mobile-top-outline.svg"),
+    include_bytes!("../../../assets/icons/brand/rbx-mobile-bottom-outline.svg"),
+    include_bytes!("../../../assets/icons/brand/rbx-mobile-B-outline.svg"),
+    include_bytes!("../../../assets/icons/brand/rbx-mobile-R-outline.svg"),
+    include_bytes!("../../../assets/icons/brand/rbx-mobile-X-outline.svg"),
+];
+const FACES: [Option<&[u8]>; 5] = [
+    None,
+    None,
+    Some(include_bytes!("../../../assets/icons/brand/rbx-mobile-B-face.svg")),
+    Some(include_bytes!("../../../assets/icons/brand/rbx-mobile-R-face.svg")),
+    Some(include_bytes!("../../../assets/icons/brand/rbx-mobile-X-face.svg")),
+];
+
+pub(crate) fn layer(index: usize, side: Pixels, transform: Transformation) -> Div {
+    let image = |data: &[u8], color| {
+        Icon::empty().data(data).w(side).h(side).text_color(color).transform(transform)
+    };
+    let accent = crate::launcher::ui::accent();
+    let face = crate::accent::rgb(0xF1F1FB);
+    div().absolute().top_0().left_0().size(side)
+        .child(div().absolute().top_0().left_0().child(image(OUTLINES[index], accent)))
+        .children(FACES[index].map(|data| {
+            div().absolute().top_0().left_0().child(image(data, face))
+        }))
+}
+
+pub(crate) fn mark(height: f32) -> Div {
+    let side = px(height * 1.7);
+    div().relative().flex_none().size(side)
+        .children((0..5).map(|index| layer(index, side, Transformation::default())))
+}
