+pub(crate) fn remove_copy(copy: &Path) -> std::io::Result<()> {
+    if let Err(error) = std::fs::remove_file(copy)
+        && error.kind() != std::io::ErrorKind::NotFound
+    {
+        return Err(error);
+    }
+    let _ = std::fs::remove_file(preview_path(copy));
+    Ok(())
