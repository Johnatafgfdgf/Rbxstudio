+/// Shared delivery and decoding for the toolbox and the editor's asset tool.
+fn load_asset(
+    client: &Client,
+    asset_id: u64,
+    hint: Option<(&'static str, Kind)>,
+    name: Option<String>,
+    session: Option<&rbx_cloud::heartbeats::SessionCookie>,
+) -> Result<(WeakDom, &'static str, String), String> {
+    let content = client.asset(asset_id).or_else(|error| {
+        let Some(session) = session else { return Err(error) };
+        match error {
+            CloudError::AuthRequired { .. } | CloudError::KeyedAssetRefused { .. } => {
+                client.asset_for_session(asset_id, session)
+            }
+            _ => Err(error),
+        }
+    }).map_err(|err| refused(asset_id, &err))?;
+    let (asset_type, kind) =
+        Kind::of(&content, hint).ok_or_else(|| unsupported(asset_id, &content))?;
+    let name = name.unwrap_or_else(|| display_name(client, asset_id, kind));
+    let dom = build(asset_id, kind, &content.bytes, &name)?;
+    Ok((dom, asset_type, name))
+}
+
+pub(crate) fn download_toolbox_asset(
+    asset_id: u64, name: Option<String>, session: Option<&rbx_cloud::heartbeats::SessionCookie>,
+) -> Result<WeakDom, String> {
+    let client = Client::new(rbx_cloud::ApiKey::from_env_or_config());
+    load_asset(&client, asset_id, None, name, session).map(|(dom, _, _)| dom)
+}
+
 fn tag(guid: &str) -> String {
     format!("Assistant:{guid}")
 }
