+                        .on_click(cx.listener(|this, _, _, cx| { let _ = this.shell.update(cx, |shell, cx| shell.open_roblox_login(cx)); })))
+                })
+                .child(body)
+                .when(!self.status.is_empty(), |column| {
+                    column.child(
+                        div()
+                            .text_color(tokens::text2())
+                            .line_clamp(if cfg!(target_os = "android") { 2 } else { 3 })
