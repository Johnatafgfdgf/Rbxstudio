+use gpui_kit::assets::IconName;
+use gpui_kit::component::{h_flex, v_flex, Icon};
+use gpui_kit::prelude::FluentBuilder as _;
+use gpui_kit::*;
+
+use super::chrome::Document;
+use super::layout::Panel;
+use super::play::{session::StopReason, Phase};
+use super::Shell;
+use super::{menu, mobile_metrics};
+use gpui_kit::component::popover::Popover;
+use crate::{mobile_style as style, tokens};
+use crate::transform::{Action, Tool};
+
+mod dock;
+pub(super) use dock::Docks;
+
+pub(super) const TOUCH_TARGET: f32 = 48.;
+const COMPACT_HEIGHT: f32 = 480.;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum Sheet {
+    Main,
+    Tools,
+}
+
+impl Shell {
+    fn save_mobile_place(&mut self, cx: &mut Context<Self>) {
+        if self.save_in_place(cx).is_err() {
+            self.mobile_saved_at = None;
+            self.set_panel_open(Panel::Output, true, cx);
+            return;
+        }
+        let saved = std::time::Instant::now();
+        self.mobile_saved_at = Some(saved);
+        cx.spawn(async move |this, cx| {
+            cx.background_executor()
+                .timer(std::time::Duration::from_secs(2))
+                .await;
+            let _ = this.update(cx, |shell, cx| {
+                if shell.mobile_saved_at == Some(saved) {
+                    shell.mobile_saved_at = None;
+                    cx.notify();
+                }
+            });
+        })
+        .detach();
+        cx.notify();
+    }
+
+    pub(super) fn mobile_code_available(&self, window: &Window) -> bool {
+        self.document == Document::Scripts
+            && f32::from(window.viewport_size().height) < COMPACT_HEIGHT
+            && self.scripts.tabs.active().is_some_and(|reference| {
+                self.scripts.tabs.view(reference) == crate::script_editor::tabs::View::Code
+            })
+    }
+
+    pub(super) fn mobile_code_focused(&self, window: &Window) -> bool {
+        self.mobile_code_available(window)
+            && (self.mobile_code_focus || window.viewport_size().height < px(245.))
+    }
+
+    pub(super) fn close_mobile_chrome(&mut self, cx: &mut Context<Self>) -> bool {
+        if self.mobile_menu_open || self.ribbon_tools_open {
+            self.mobile_menu_open = false;
+            self.ribbon_tools_open = false;
+        } else if let Some(panel) = self.mobile_docks.foremost() {
+            self.set_panel_open(panel, false, cx);
+            return true;
+        } else {
+            return false;
+        }
+        cx.notify();
+        true
+    }
+
+    fn mobile_panel_picker(
+        &self, id: &'static str, icon_only: bool, cx: &mut Context<Self>,
+    ) -> impl IntoElement {
+        menu::dropdown(self, menu::MenuId::MobilePanels,
+            super::chrome::Trigger::with_open(move |open| {
+                compact_action(id, IconName::PanelsTopLeft, "Painéis", icon_only)
+                    .aria_expanded(open).when(open, style::selected)
+            }),
+            Panel::ALL.into_iter().map(|panel| menu::item(panel.key()).checked(self.mobile_docks.contains(panel))
+                .on_click(move |shell, cx| shell.set_panel_open(panel, !shell.mobile_docks.contains(panel), cx))).collect(), cx)
+    }
+
+    fn mobile_transform_options(&self, cx: &mut Context<Self>) -> impl IntoElement {
+        let handle = cx.entity();
+        Popover::new("mobile-transform-options").appearance(false)
+            .trigger(super::chrome::Trigger::new(compact_action("mobile-transform-options-trigger", IconName::Ellipsis, "Opções de transformação", true)))
+            .content(move |_, window, cx| handle.update(cx, |shell, cx| {
+                style::appear(v_flex().id("mobile-transform-options-body").w(px(290.))
+                    .max_w((window.viewport_size().width - px(16.)).max(px(48.)))
+                    .max_h(px((f32::from(window.viewport_size().height) - 72.).max(48.)))
+                    .overflow_y_scroll().occlude().p(px(8.)).gap(px(4.)).bg(tokens::dock())
+                    .map(style::surface)
+                    .child(action("mobile-frame-selection", IconName::Crosshair, "Focar seleção")
+                        .on_click(cx.listener(|shell, _, _, cx| shell.viewport.update(cx, |view, cx| view.focus_android_selection(cx)))))
+                    .child(action("mobile-axis-space", IconName::Axis3d, if shell.transform.local { "Eixos locais" } else { "Eixos globais" })
+                        .on_click(cx.listener(|shell, _, _, cx| shell.transform_action(Action::ToggleLocal, cx))))
+                    .child(action("mobile-camera-stick", IconName::Gamepad2, "Analógico da câmera")
+                        .when(shell.viewport.read(cx).android_stick_enabled(), selected)
+                        .on_click(cx.listener(|shell, _, _, cx| { shell.viewport.update(cx, |v, cx| v.toggle_android_stick(cx)); cx.notify(); })))
+                    .child(action("mobile-transform-combined", IconName::Move3d, "Transform combinado")
+                        .on_click(cx.listener(|shell, _, _, cx| shell.transform_action(Action::Use(Tool::Transform), cx))))
+                    .child(shell.align_control(cx)).child(shell.snap_fields_popover(cx)),
+                    "mobile-transform-options-appear")
+            }))
+    }
+
+    pub(super) fn mobile_action_bar(
+        &self,
+        window: &Window,
+        cx: &mut Context<Self>,
+    ) -> impl IntoElement {
+        let width = f32::from(window.viewport_size().width);
+        let compact = width < 720. || tokens::font_scale() > 1.2;
+        let code_available = self.mobile_code_available(window);
+        let code_focused = self.mobile_code_focused(window);
+        let mut nav = h_flex()
+            .id("mobile-actions")
+            .h_full()
+            .flex_1()
+            .min_w_0()
+            .gap(px(4.))
+            .overflow_x_scroll()
+            .child(
+                compact_action("mobile-menu", IconName::Menu, "Menu", compact)
+                    .aria_expanded(self.mobile_menu_open)
+                    .when(self.mobile_menu_open, selected)
+                    .on_click(cx.listener(|shell, _, _, cx| {
+                        shell
+                            .viewport
+                            .update(cx, |view, cx| view.cancel_android_interaction(cx));
+                        shell.mobile_menu_open = !shell.mobile_menu_open;
+                        shell.ribbon_tools_open = false;
+                        shell.open_menu = None;
+                        cx.notify();
+                    })),
+            )
+            .child(
+                compact_action("mobile-tools", IconName::Wrench, "Ferramentas", compact)
+                    .aria_expanded(self.ribbon_tools_open)
+                    .when(self.ribbon_tools_open, selected)
+                    .on_click(cx.listener(|shell, _, _, cx| {
+                        shell
+                            .viewport
+                            .update(cx, |view, cx| view.cancel_android_interaction(cx));
+                        shell.ribbon_tools_open = !shell.ribbon_tools_open;
+                        shell.mobile_menu_open = false;
+                        shell.open_menu = None;
+                        cx.notify();
+                    })),
+            )
+            .child(self.mobile_panel_picker("mobile-panels", compact, cx));
+
+        if self.document == Document::Viewport {
+            if mobile_metrics::compact_tools(width) {
+                nav = nav.child(menu::dropdown(self, menu::MenuId::MobileTool,
+                    super::chrome::Trigger::new(compact_action("mobile-active-tool", tool_icon(self.transform.tool), "Ferramenta ativa", true)),
+                    mobile_tools().into_iter().map(|(_, tool, _, label)| menu::item(label)
+                        .checked(self.transform.tool == tool)
+                        .on_click(move |shell, cx| shell.transform_action(Action::Use(tool), cx))).collect(), cx));
+            } else {
+                for (id, tool, icon, label) in mobile_tools() {
+                    let active = self.transform.tool == tool;
+                    nav = nav.child(compact_action(id, icon, label, true).aria_selected(active).when(active, selected)
+                        .on_click(cx.listener(move |shell, _, _, cx| {
+                            shell.mobile_menu_open = false; shell.ribbon_tools_open = false;
+                            shell.transform_action(Action::Use(tool), cx);
+                        })));
+                }
+            }
+            nav = nav.child(self.mobile_transform_options(cx));
+        } else {
+            nav = nav.child(
+                compact_action("mobile-scene", IconName::Box, "Cena", compact).on_click(
+                    cx.listener(|shell, _, _, cx| shell.set_document(Document::Viewport, cx)),
+                ),
+            );
+        }
+        if code_available && width >= 700. {
+            let label = if code_focused {
+                "Mostrar painéis"
+            } else {
+                "Foco no código"
+            };
+            nav = nav.child(
+                compact_action("mobile-code-focus", IconName::PanelsTopLeft, label, true)
+                    .aria_expanded(!code_focused)
+                    .on_click(cx.listener(|shell, _, _, cx| {
+                        shell.mobile_code_focus = !shell.mobile_code_focus;
+                        cx.notify();
+                    })),
+            );
+        }
+        if self.document == Document::Scripts {
+            if let Some(reference) = self.scripts.tabs.active().filter(|reference| {
+                self.scripts.tabs.view(*reference) == crate::script_editor::tabs::View::Code
+            }) {
+                nav = nav.child(
+                    compact_action("mobile-keyboard", IconName::Keyboard, "Teclado", compact)
+                        .on_click(cx.listener(move |shell, _, window, cx| {
+                            shell.focus_script(reference, window, cx);
+                            window.reopen_soft_keyboard();
+                        })),
+                );
+            }
+        }
+
+        let (label, icon) = match self.play.phase {
+            Phase::Idle => ("Play", IconName::Play),
+            Phase::Starting(step) => (step, IconName::Play),
+            Phase::Running => ("Parar", IconName::Square),
+        };
+        let play = compact_action("mobile-play", icon, label, compact)
+            .map(style::primary)
+            .when(matches!(self.play.phase, Phase::Starting(_)), |button| {
+                button.opacity(0.64).cursor_not_allowed()
+            })
+            .on_click(cx.listener(|shell, _, window, cx| {
+                shell.mobile_menu_open = false;
+                shell.ribbon_tools_open = false;
+                match shell.play.phase {
+                    Phase::Idle => shell.play_start(window, cx),
+                    Phase::Running => shell.play_stop(StopReason::Stopped, cx),
+                    Phase::Starting(_) => {}
+                }
+            }));
+        let (save_icon, save_label) = if self.mobile_saved_at.is_some() {
+            (IconName::Check, "Salvo")
+        } else {
+            (IconName::Save, "Salvar")
+        };
+
+        h_flex()
+            .id("mobile-action-bar")
+            .w_full()
+            .h(px(TOUCH_TARGET + 4.))
+            .flex_none()
+            .px(px(6.))
+            .items_center()
+            .gap(px(4.))
+            .bg(style::background())
+            .child(nav)
+            .child(
+                compact_action("mobile-save", save_icon, save_label, compact)
+                    .on_click(cx.listener(|shell, _, _, cx| shell.save_mobile_place(cx))),
+            )
+            .child(play)
+    }
+
+    pub(super) fn mobile_workspace(
+        &mut self,
+        document: AnyElement,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let mut workspace = self.mobile_dock_layout(document, window, cx);
+        let sheet = if self.mobile_menu_open {
+            Some(Sheet::Main)
+        } else if self.ribbon_tools_open {
+            Some(Sheet::Tools)
+        } else {
+            None
+        };
+        if sheet != Some(Sheet::Main) && self.mobile_sheet_motion.target() == Some(Sheet::Main)
+            && self.menu_bar.read(cx).has_mobile_dropdown_open()
+        {
+            self.menu_bar.update(cx, |bar, cx| bar.hide_mobile_dropdown(window, cx));
+        }
+        if let Some(frame) = self.mobile_sheet_motion.frame(sheet, window) {
+            let main = frame.value == Sheet::Main;
+            let contents = if main {
+                v_flex()
+                    .w_full()
+                    .children(self.credential_notice(cx))
+                    .child(self.menu_bar.clone())
+                    .into_any_element()
+            } else {
+                v_flex()
+                    .w_full()
+                    .child(self.ribbon_tabs(cx))
+                    .child(self.ribbon(cx))
+                    .into_any_element()
+            };
+            workspace = workspace.child(
+                div()
+                    .id("mobile-chrome-sheet")
+                    .absolute()
+                    .inset_0()
+                    .when(main, |sheet| sheet.child(
+                        div()
+                            .id("mobile-chrome-backdrop")
+                            .absolute()
+                            .inset_0()
+                            .occlude()
+                            .bg(tokens::veil())
+                            .opacity(frame.amount * 0.58)
+                            .when(frame.interactive, |backdrop| backdrop.on_click(cx.listener(|shell, _, _, cx| {
+                                shell.close_mobile_chrome(cx);
+                            }))),
+                    ))
+                    .child(
+                        div()
+                            .id("mobile-chrome-content")
+                            .relative()
+                            .mx(px(6.))
+                            .py(px(3.))
+                            .top(px(6. - (1. - frame.amount) * style::SHEET_SHIFT))
+                            .opacity(frame.amount)
+                            .max_h(px((f32::from(window.viewport_size().height) - 102.).max(48.)))
+                            .overflow_y_scroll()
+                            .when(frame.interactive, |sheet| sheet.on_mouse_down_out(cx.listener(|shell, _, _, cx| {
+                                if shell.ribbon_tools_open && shell.open_menu.is_none() {
+                                    shell.ribbon_tools_open = false;
+                                    cx.notify();
+                                }
+                            })))
+                            .occlude()
+                            .map(style::surface)
+                            .child(contents)
+                            .when(!frame.interactive, |sheet| sheet.child(div().absolute().inset_0().occlude())),
+                    ),
+            );
+        }
+        workspace.into_any_element()
+    }
+
+}
+
+pub(super) fn action(id: &'static str, icon: IconName, label: &'static str) -> Stateful<Div> {
+    compact_action(id, icon, label, false)
+}
+
+pub(super) fn compact_action(
+    id: &'static str,
+    icon: IconName,
+    label: &'static str,
+    icon_only: bool,
+) -> Stateful<Div> {
+    h_flex()
+        .id(id)
+        .flex_none()
+        .min_w(px(TOUCH_TARGET))
+        .h(px(TOUCH_TARGET))
+        .gap(px(5.))
+        .px(px(7.))
+        .items_center()
+        .justify_center()
+        .map(style::control)
+        .role(Role::Button)
+        .aria_label(label)
+        .cursor_pointer()
+        .text_size(tokens::text_sm())
+        .text_color(style::text())
+        .active(|button| button.bg(style::wash()))
+        .focus_visible(|button| button.shadow(tokens::focus_ring_inset()))
+        .child(Icon::new(icon).size(px(22.)))
+        .when(!icon_only, |button| button.child(label))
+        .when(icon_only, |button| {
+            button.tooltip(move |window, cx| super::tooltip::text(label, window, cx))
+        })
+}
+
+fn selected(button: Stateful<Div>) -> Stateful<Div> {
+    style::selected(button)
+}
+
+fn mobile_tools() -> [(&'static str, Tool, IconName, &'static str); 4] {
+    [("mobile-select", Tool::Select, IconName::MousePointer2, "Selecionar"),
+     ("mobile-move", Tool::Move, IconName::Move3d, "Mover"),
+     ("mobile-rotate", Tool::Rotate, IconName::Rotate3d, "Girar"),
+     ("mobile-scale", Tool::Scale, IconName::Scaling, "Escala")]
+}
+fn tool_icon(tool: Tool) -> IconName {
+    mobile_tools().into_iter().find(|(_, t, _, _)| *t == tool).map_or(IconName::Move3d, |(_, _, icon, _)| icon)
+}
diff --git a/crates/rbx_studio/src/shell/mobile/dock.rs b/crates/rbx_studio/src/shell/mobile/dock.rs
new file mode 100644
index 0000000..53f572f
--- /dev/null
+++ b/crates/rbx_studio/src/shell/mobile/dock.rs
@@ -0,0 +1,318 @@
+use gpui_kit::assets::IconName;
+use gpui_kit::component::{h_flex, v_flex};
+use gpui_kit::prelude::FluentBuilder as _;
+use gpui_kit::*;
+
+use crate::mobile_style::{self as style, Reveal, RevealFrame};
+use crate::shell::{layout::Panel, mobile_metrics, Shell};
+
+use super::{compact_action, selected};
+
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+struct Side {
+    explorer: bool,
+    inspector: Option<Panel>,
+}
+
+impl Side {
+    fn visible(self) -> bool {
+        self.explorer || self.inspector.is_some()
+    }
+
+    fn stacked(self) -> bool {
+        self.explorer && self.inspector.is_some()
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Seam {
+    Side,
+    Stack,
+    Output,
+}
+
+pub(crate) struct Docks {
+    side: Side,
+    output: bool,
+    last: Option<Panel>,
+    side_width: f32,
+    output_height: f32,
+    stack_ratio: f32,
+    side_expanded: bool,
+    output_expanded: bool,
+    resize: Option<(Seam, Point<Pixels>, f32)>,
+    side_motion: Reveal<Side>,
+    output_motion: Reveal<()>,
+}
+
+impl Default for Docks {
+    fn default() -> Self {
+        Self {
+            side: Side::default(),
+            output: false,
+            last: None,
+            side_width: 0.,
+            output_height: 124.,
+            stack_ratio: 0.54,
+            side_expanded: false,
+            output_expanded: false,
+            resize: None,
+            side_motion: Reveal::default(),
+            output_motion: Reveal::default(),
+        }
+    }
+}
+
+impl Docks {
+    pub(in crate::shell) fn contains(&self, panel: Panel) -> bool {
+        match panel {
+            Panel::Explorer => self.side.explorer,
+            Panel::Output => self.output,
+            other => self.side.inspector == Some(other),
+        }
+    }
+
+    pub(in crate::shell) fn set(&mut self, panel: Panel, open: bool) {
+        match panel {
+            Panel::Explorer => self.side.explorer = open,
+            Panel::Output => self.output = open,
+            other if open => self.side.inspector = Some(other),
+            other if self.side.inspector == Some(other) => self.side.inspector = None,
+            _ => {}
+        }
+        if open {
+            self.last = Some(panel);
+        } else if self.last == Some(panel) {
+            self.last = None;
+        }
+    }
+
+    pub(super) fn foremost(&self) -> Option<Panel> {
+        self.last
+            .filter(|&panel| self.contains(panel))
+            .or(self.side.inspector)
+            .or(self.side.explorer.then_some(Panel::Explorer))
+            .or(self.output.then_some(Panel::Output))
+    }
+}
+
+impl Shell {
+    pub(super) fn mobile_dock_layout(
+        &mut self,
+        document: AnyElement,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Div {
+        let width = f32::from(window.viewport_size().width);
+        let height = (f32::from(window.viewport_size().height) - 100.).max(0.);
+        let show = !self.mobile_code_focused(window);
+        let side = (show && self.mobile_docks.side.visible()).then_some(self.mobile_docks.side);
+        let side = self.mobile_docks.side_motion.frame(side, window).filter(|_| show);
+        let output = (show && self.mobile_docks.output).then_some(());
+        let output = self.mobile_docks.output_motion.frame(output, window).filter(|_| show);
+
+        let output_height = if self.output_collapsed {
+            height.min(60.)
+        } else {
+            mobile_metrics::output_height(
+                height, self.mobile_docks.output_height, self.mobile_docks.output_expanded,
+            )
+        };
+        let output = output.map(|motion| {
+            let dock = self.mobile_pane(Panel::Output, Side::default(), window, cx);
+            let seam = self.mobile_seam(Seam::Output, output_height, height, cx);
+            div().h(px(output_height)).w_full().flex_none().child(
+                animated_dock(v_flex().size_full().child(seam).child(dock), motion, false),
+            )
+        });
+
+        let side_height = (height - if output.is_some() { output_height } else { 0. }).max(1.);
+        let side_width = mobile_metrics::drawer_width(width, self.mobile_docks.side_width, self.mobile_docks.side_expanded);
+        let side = side.map(|motion| {
+            let visible = motion.value;
+            let explorer = visible.explorer.then(|| self.mobile_pane(Panel::Explorer, visible, window, cx));
+            let inspector = visible.inspector.map(|panel| self.mobile_pane(panel, visible, window, cx));
+            let ratio = self.mobile_docks.stack_ratio;
+            let stack = v_flex().h_full().flex_1().min_w_0().overflow_hidden()
+                .children(explorer.map(|pane| pane.flex_grow(ratio)))
+                .when(visible.stacked(), |stack| {
+                    stack.child(self.mobile_seam(Seam::Stack, ratio, side_height, cx))
+                })
+                .children(inspector.map(|pane| pane.flex_grow(1. - ratio)));
+            div().w(px(side_width)).h_full().flex_none().child(
+                animated_dock(h_flex().size_full()
+                    .child(self.mobile_seam(Seam::Side, side_width, width, cx))
+                    .child(stack), motion, true),
+            )
+        });
+
+        v_flex()
+            .relative()
+            .w_full()
+            .flex_1()
+            .min_h_0()
+            .overflow_hidden()
+            .bg(style::background())
+            .p(px(4.))
+            .gap(px(3.))
+            .child(
+                h_flex().w_full().flex_1().min_h_0().overflow_hidden()
+                    .child(div().flex_1().min_w_0().h_full().overflow_hidden()
+                        .when(self.document == super::Document::Viewport, |scene| {
+                            scene.rounded(px(style::VIEWPORT_RADIUS))
+                        })
+                        .child(document))
+                    .children(side),
+            )
+            .children(output)
+    }
+
+    fn mobile_pane(
+        &mut self,
+        panel: Panel,
+        side: Side,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Stateful<Div> {
+        let output = panel == Panel::Output;
+        let (controls, body) = self.panel_parts(panel, output && self.output_collapsed, window, cx);
+        let (tab_controls, header_controls, extra_controls) = match panel {
+            Panel::Explorer => (None, controls, None),
+            Panel::Output => (controls, None, None),
+            _ => (None, None, controls),
+        };
+        let mut tabs = h_flex()
+            .id(("mobile-panel-tabs", panel as usize))
+            .h_full()
+            .flex_1()
+            .min_w_0()
+            .items_center()
+            .gap(px(3.))
+            .overflow_x_scroll();
+        let catalog = [
+            (Panel::Explorer, IconName::ListTree, "Explorer"),
+            (Panel::Properties, IconName::SlidersHorizontal, "Propriedades"),
+            (Panel::Toolbox, IconName::Package, "Toolbox"),
+        ];
+        let known = catalog.iter().any(|&(entry, _, _)| entry == panel);
+        if known {
+            for (entry, icon, label) in catalog {
+                if side.stacked() && (entry == Panel::Explorer) != (panel == Panel::Explorer) {
+                    continue;
+                }
+                tabs = tabs.child(
+                    compact_action(entry.key(), icon, label, !side.stacked() || entry != panel)
+                        .h(px(40.))
+                        .aria_selected(entry == panel)
+                        .when(entry == panel, selected)
+                        .on_click(cx.listener(move |shell, _, _, cx| shell.set_panel_open(entry, true, cx))),
+                );
+            }
+        } else {
+            tabs = tabs.child(div().flex_none().px(px(6.)).child(panel.key()));
+        }
+        let expanded = if output { self.mobile_docks.output_expanded } else { self.mobile_docks.side_expanded };
+        let resize = compact_action(
+            "mobile-panel-resize",
+            if expanded { IconName::Minimize2 } else { IconName::Maximize2 },
+            if expanded { "Reduzir painel" } else { "Ampliar painel" },
+            true,
+        ).h(px(40.)).on_click(cx.listener(move |shell, _, _, cx| {
+            if output {
+                shell.mobile_docks.output_expanded = !shell.mobile_docks.output_expanded;
+                shell.output_collapsed = false;
+            } else {
+                shell.mobile_docks.side_expanded = !shell.mobile_docks.side_expanded;
+            }
+            cx.notify();
+        }));
+        v_flex()
+            .id(("mobile-panel-drawer", panel as usize))
+            .w_full()
+            .flex_1()
+            .min_h_0()
+            .overflow_hidden()
+            .occlude()
+            .map(style::surface)
+            .text_color(style::text())
+            .child(
+                h_flex().w_full().h(px(44.)).flex_none().px(px(3.)).gap(px(3.))
+                    .items_center().border_b_1().border_color(style::border())
+                    .child(tabs.children(tab_controls))
+                    .children(header_controls)
+                    .when(!side.stacked() || panel == Panel::Explorer, |bar| bar.child(resize))
+                    .child(compact_action("mobile-panel-close", IconName::X, "Fechar painel", true)
+                        .h(px(40.))
+                        .on_click(cx.listener(move |shell, _, _, cx| shell.set_panel_open(panel, false, cx)))),
+            )
+            .children(extra_controls.map(|controls| h_flex()
+                .id(("mobile-panel-controls", panel as usize)).w_full().flex_none()
+                .overflow_x_scroll().child(controls)))
+            .children(body.map(|body| div().flex_1().min_h_0().overflow_hidden().child(body)))
+    }
+
+    fn mobile_seam(&self, seam: Seam, current: f32, extent: f32, cx: &mut Context<Self>) -> Stateful<Div> {
+        let vertical = seam == Seam::Side;
+        let (id, label) = match seam {
+            Seam::Side => ("mobile-side-seam", "Largura do painel"),
+            Seam::Stack => ("mobile-stack-seam", "Altura do Explorer"),
+            Seam::Output => ("mobile-output-seam", "Altura da saída"),
+        };
+        div().id(id).flex_none().flex().occlude().items_center().justify_center()
+            .map(|handle| if vertical {
+                handle.w(px(15.)).h_full().cursor(CursorStyle::ResizeLeftRight)
+            } else {
+                handle.h(px(13.)).w_full().cursor(CursorStyle::ResizeUpDown)
+            })
+            .role(Role::Button).aria_label(label)
+            .child(div().rounded_full().bg(style::border()).map(|mark| {
+                if vertical { mark.w(px(3.)).h(px(32.)) }
+                else { mark.w(px(32.)).h(px(3.)) }
+            }))
+            .on_touch_drag(cx.listener(move |shell, event: &TouchDragEvent, window, cx| {
+                let docks = &mut shell.mobile_docks;
+                match event.phase {
+                    TouchPhase::Started => {
+                        docks.resize = Some((seam, event.position, current));
+                        match seam {
+                            Seam::Side => docks.side_expanded = false,
+                            Seam::Output => {
+                                docks.output_expanded = false;
+                                shell.output_collapsed = false;
+                            }
+                            Seam::Stack => {}
+                        }
+                    }
+                    phase => {
+                        let Some((active, start, initial)) = docks.resize else { return; };
+                        if active != seam { return; }
+                        if phase == TouchPhase::Moved {
+                            let delta = event.position - start;
+                            match seam {
+                                Seam::Side => docks.side_width = (initial - f32::from(delta.x)).max(1.),
+                                Seam::Stack => docks.stack_ratio =
+                                    (initial + f32::from(delta.y) / extent).clamp(0.26, 0.74),
+                                Seam::Output => docks.output_height = (initial - f32::from(delta.y)).max(1.),
+                            }
+                        } else {
+                            docks.resize = None;
+                        }
+                    }
+                }
+                window.prevent_default();
+                cx.stop_propagation();
+                cx.notify();
+            }))
+    }
+}
+
+fn animated_dock<T: Copy>(contents: Div, frame: RevealFrame<T>, horizontal: bool) -> Div {
+    // Keep the allotted space stable while animating; only user resizing
+    // changes the renderer's dimensions during a gesture.
+    div().size_full().relative().overflow_hidden()
+        .child(contents.relative().opacity(frame.amount).map(|body| {
+            let distance = px((1. - frame.amount) * style::DRAWER_SHIFT);
+            if horizontal { body.left(distance) } else { body.top(distance) }
+        }))
+        .when(!frame.interactive, |host| host.child(div().absolute().inset_0().occlude()))
+}
diff --git a/crates/rbx_studio/src/shell/mobile_metrics.rs b/crates/rbx_studio/src/shell/mobile_metrics.rs
new file mode 100644
index 0000000..129d605
--- /dev/null
+++ b/crates/rbx_studio/src/shell/mobile_metrics.rs
@@ -0,0 +1,22 @@
+//! Keep room for the scene, including when the dock is widened on a phone.
+pub(crate) fn drawer_width(width: f32, preferred: f32, expanded: bool) -> f32 {
+    let width = width.max(0.);
+    if expanded {
+        return width * 0.58;
+    }
+    let wide = width >= 700.;
+    let max = if wide { (width * 0.4).min(380.) } else { width * 0.49 };
+    let min = f32::min(max, if wide { 260. } else { 158. });
+    let wanted = if preferred > 0. { preferred } else { width * 0.36 };
+    wanted.clamp(min, max)
+}
+
+pub(crate) fn compact_tools(width: f32) -> bool {
+    width < 700.
+}
+
+pub(crate) fn output_height(height: f32, preferred: f32, expanded: bool) -> f32 {
+    if expanded { return height.max(0.) * 0.68; }
+    let min = 96_f32.min(height * 0.65);
+    preferred.clamp(min, height * 0.65)
+}
