diff --git a/crates/rbx_studio/src/shell/play/android.rs b/crates/rbx_studio/src/shell/play/android.rs
new file mode 100644
index 0000000..3f7992b
--- /dev/null
+++ b/crates/rbx_studio/src/shell/play/android.rs
@@ -0,0 +1,82 @@
+//! Route the original Play action to the installed original Rook host.
+use super::*;
+
+impl Shell {
+    pub(crate) fn engine_diagnostics_android(&mut self, cx: &mut Context<Self>) {
+        const SOURCE: &str = "Diagnóstico do motor";
+        self.set_panel_open(crate::shell::Panel::Output, true, cx);
+        self.output.push(SOURCE, Feedback::Info("Executando cenários isolados de Luau, ferramentas e física…".into()));
+        cx.spawn(async move |this, cx| {
+            let report = cx.background_spawn(async move {
+                crate::android_play::host()?.diagnostics()
+            }).await;
+            let _ = this.update(cx, |shell, cx| {
+                match report {
+                    Ok(report) => {
+                        for line in report.lines() { shell.output.push(SOURCE, Feedback::Output(line.to_owned())); }
+                    }
+                    Err(error) => shell.output.push(SOURCE, Feedback::Error(error)),
+                }
+                cx.notify();
+            });
+        }).detach();
+    }
+
+    pub(in crate::shell) fn play_start_android_local(&mut self, cx: &mut Context<Self>) {
+        if self.play.phase != Phase::Idle { return; }
+        self.flush_script_edits(cx);
+        self.play.attempt += 1;
+        let attempt = self.play.attempt;
+        let dom = self.dom.clone();
+        let title = self.title.to_string();
+        let color = crate::launcher::ui::accent();
+        let channel = |value: f32| (value.clamp(0., 1.) * 255.).round() as u32;
+        let accent = 0xff000000 | channel(color.r) << 16 | channel(color.g) << 8 | channel(color.b);
+        self.play.phase = Phase::Starting("Preparando Play local…");
+        cx.notify();
+        cx.spawn(async move |this, cx| {
+            let result = cx.background_spawn(async move {
+                let bytes = crate::save::Format::Binary.encode(&dom)?;
+                crate::android_play::host()?.start(bytes, title, accent)
+            }).await;
+            let _ = this.update(cx, |shell, cx| {
+                if shell.play.attempt != attempt {
+                    if let Ok(session) = result {
+                        if let Ok(host) = crate::android_play::host() { host.stop(session); }
+                    }
+                    return;
+                }
+                match result {
+                    Ok(session) => {
+                        shell.play.local = Some(session);
+                        shell.play.poll = Some(shell.play_poll(cx));
+                    }
+                    Err(error) => shell.play_stop(StopReason::Failed(error), cx),
+                }
+                cx.notify();
+            });
+        }).detach();
+    }
+
+    pub(super) fn play_tick_android(&mut self, cx: &mut Context<Self>) -> bool {
+        use crate::android_play::Phase as Local;
+        let update = match crate::android_play::host() {
+            Ok(host) => host.poll(self.play.local.expect("active local Play")),
+            Err(error) => { self.play_stop(StopReason::Failed(error), cx); return false; }
+        };
+        let changed = !update.output.is_empty();
+        for line in update.output { self.output.push(PLAY_SOURCE, Feedback::Output(line)); }
+        match update.phase {
+            Local::Running if self.play.phase != Phase::Running => {
+                self.play.phase = Phase::Running;
+                self.device_play_changed(cx);
+                cx.notify();
+            }
+            Local::Stopped => { self.play_stop(StopReason::ClientExited, cx); return false; }
+            Local::Failed(error) => { self.play_stop(StopReason::Failed(error), cx); return false; }
+            _ => {}
+        }
+        if changed { cx.notify(); }
+        true
+    }
+}
diff --git a/crates/rbx_studio/src/shell/play/destination.rs b/crates/rbx_studio/src/shell/play/destination.rs
new file mode 100644
index 0000000..75d3bd4
--- /dev/null
+++ b/crates/rbx_studio/src/shell/play/destination.rs
@@ -0,0 +1,50 @@
+/// Validate the configured private start place against the linked project.
+pub(in crate::shell) fn check(
+    test: (u64, u64),
+    linked: Option<(u64, u64)>,
+    root_place: u64,
+    private: bool,
+) -> Result<(), &'static str> {
+    let (universe, place) = test;
+    if universe == 0 || place == 0 || i64::try_from(place).is_err() {
+        return Err("O ID do destino de teste é inválido.");
+    }
+    if linked
+        .is_some_and(|(live_universe, live_place)| universe == live_universe || place == live_place)
+    {
+        return Err("Escolha uma experiência de teste separada do projeto vinculado.");
+    }
+    if !private {
+        return Err("Mantenha a experiência de teste como Privada no Creator Dashboard.");
+    }
+    if place != root_place {
+        return Err("Use o ID do lugar inicial da experiência de teste.");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::check;
+
+    #[test]
+    fn accepts_a_distinct_private_start_place() {
+        assert!(check((42, 87), Some((2, 8)), 87, true).is_ok());
+        assert!(check((42, 87), None, 87, true).is_ok());
+    }
+
+    #[test]
+    fn rejects_the_linked_experience_and_place() {
+        assert!(check((42, 87), Some((42, 8)), 87, true).is_err());
+        assert!(check((42, 87), Some((2, 87)), 87, true).is_err());
+    }
+
+    #[test]
+    fn rejects_public_secondary_and_invalid_places() {
+        assert!(check((42, 87), None, 88, true).is_err());
+        assert!(check((42, 87), None, 87, false).is_err());
+        assert!(check((42, 0), None, 0, true).is_err());
+        assert!(check((0, 87), None, 87, true).is_err());
+        assert!(check((42, u64::MAX), None, u64::MAX, true).is_err());
+    }
+}
diff --git a/crates/rbx_studio/src/shell/play/external.rs b/crates/rbx_studio/src/shell/play/external.rs
new file mode 100644
index 0000000..e755a6a
--- /dev/null
+++ b/crates/rbx_studio/src/shell/play/external.rs
@@ -0,0 +1,368 @@
+//! The Android Play action publishes a saved snapshot and opens Roblox externally.
+use super::*;
+use crate::home;
+use rbx_cloud::{CloudError, Universe, Visibility};
+
+const INSTALL: &str = "https://play.google.com/store/apps/details?id=com.roblox.client";
+static TEST_UPLOAD: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+#[derive(Default)]
+pub(super) struct ExternalPlay {
+    notice: Option<Notice>,
+    pub(super) approved: Option<PlaySandbox>,
+}
+
+enum Notice {
+    Setup,
+    Install(&'static str),
+    Confirm {
+        sandbox: PlaySandbox,
+        name: String,
+    },
+    Error {
+        message: String,
+        manage_key: bool,
+    },
+    Published {
+        place: u64,
+        version: u64,
+        detail: String,
+    },
+}
+
+fn failure(message: impl Into<String>) -> Notice {
+    Notice::Error {
+        message: message.into(),
+        manage_key: false,
+    }
+}
+
+fn linked_place(path: &std::path::Path) -> Option<(u64, u64)> {
+    home::link_of(path).map(|link| (link.universe_id, link.place_id))
+}
+
+fn client() -> Result<Client, Notice> {
+    ApiKey::from_env_or_config()
+        .map(|key| Client::new(Some(key)))
+        .ok_or_else(|| Notice::Error {
+            message: "Adicione a chave Open Cloud que dá acesso à experiência de teste.".into(),
+            manage_key: true,
+        })
+}
+
+fn cloud_error(error: CloudError, uploading: bool) -> Notice {
+    let status = match &error {
+        CloudError::Http { status, .. } | CloudError::Refused { status, .. } => Some(*status),
+        _ => None,
+    };
+    match (&error, status) {
+        (_, Some(401 | 403)) | (CloudError::MissingScope { .. } | CloudError::NoApiKey, _) =>
+            Notice::Error {
+                message: "Confira a validade da chave. Autorize Universe: Read e universe-places: Write na experiência de teste.".into(),
+                manage_key: true,
+            },
+        (_, Some(404)) => failure("Destino de teste não encontrado. Confira o ID do lugar inicial."),
+        (CloudError::RateLimited { retry_after }, _) => failure(format!(
+            "O Roblox limitou as solicitações. Tente novamente em {} s.",
+            retry_after.unwrap_or(60)
+        )),
+        (CloudError::Transport(_), _) | (_, Some(500..=599)) if uploading => failure(
+            "O envio não foi confirmado. Confira o histórico do lugar de teste antes de reenviar."
+        ),
+        (CloudError::Transport(_), _) => failure(
+            "A conexão com o Open Cloud falhou. Confira a rede e tente novamente."
+        ),
+        _ => failure(error.to_string()),
+    }
+}
+
+fn check_test(
+    client: &Client,
+    sandbox: PlaySandbox,
+    linked: Option<(u64, u64)>,
+) -> Result<Universe, Notice> {
+    let ids = (sandbox.universe_id, sandbox.place_id);
+    destination::check(ids, linked, sandbox.place_id, true).map_err(failure)?;
+    let universe = client
+        .universe(sandbox.universe_id)
+        .map_err(|err| cloud_error(err, false))?;
+    destination::check(
+        ids,
+        linked,
+        universe.root_place_id,
+        universe.visibility == Visibility::Private,
+    )
+    .map_err(failure)?;
+    Ok(universe)
+}
+
+fn check_app(place: u64) -> Result<(), Notice> {
+    match gpui_mobile::android::roblox_link(place, false) {
+        Ok(0) => Ok(()),
+        Ok(1) => Err(Notice::Install(
+            "Instale o Roblox oficial e entre com a conta que pode editar a experiência de teste."
+        )),
+        Ok(2) => Err(Notice::Install(
+            "O Roblox instalado não aceitou os links de experiência. Atualize o app e tente de novo."
+        )),
+        _ => Err(failure("O Android não conseguiu verificar o Roblox instalado.")),
+    }
+}
+
+impl Shell {
+    fn configure_test_picker(&mut self, create: bool, cx: &mut Context<Self>) {
+        self.close_external_play();
+        if create && self.roblox_session().is_none() {
+            self.open_roblox_login(cx);
+            self.output.push_warning("Conecte sua conta e volte ao Play para criar o destino de teste.");
+            cx.notify();
+            return;
+        }
+        let weak = cx.entity().downgrade();
+        let picker_shell = weak.clone();
+        let project = self.path.clone();
+        cx.defer(move |cx| {
+            crate::launcher::open_test_game_picker(move |experience, note, cx| {
+                let _ = weak.update(cx, |shell, cx| {
+                    if shell.path != project { return; }
+                    let target = PlaySandbox { universe_id: experience.universe_id, place_id: experience.root_place_id };
+                    if let Err(message) = destination::check(
+                        (target.universe_id, target.place_id), linked_place(&shell.path), target.place_id, true,
+                    ) {
+                        shell.show_external_notice(failure(message), cx);
+                        return;
+                    }
+                    shell.set_play_sandbox(Some(target), cx);
+                    if let Some(note) = note { shell.output.push_warning(&note); }
+                    // Actual privacy, root place and grants are checked by Open Cloud
+                    // before publishing; a picker result is not proof of permission.
+                    if shell.play.sandbox == Some(target) { shell.play_start_external(cx); }
+                });
+            }, Some(picker_shell), create, cx);
+        });
+        cx.notify();
+    }
+
+    pub(super) fn play_start_external(&mut self, cx: &mut Context<Self>) {
+        if self.play.phase != Phase::Idle {
+            return;
+        }
+        let Some(sandbox) = self.play.sandbox else {
+            self.show_external_notice(Notice::Setup, cx);
+            return;
+        };
+        let linked = linked_place(&self.path);
+        let path = self.path.clone();
+        self.play.external.notice = None;
+        self.play.attempt += 1;
+        let attempt = self.play.attempt;
+        self.play.phase = Phase::Starting("Verificando destino…");
+        cx.notify();
+        cx.spawn(async move |this, cx| {
+            let verified = cx
+                .background_spawn(async move {
+                    check_app(sandbox.place_id)?;
+                    let client = client()?;
+                    let universe = check_test(&client, sandbox, linked)?;
+                    Ok::<_, Notice>((client, universe.display_name))
+                })
+                .await;
+            let _ = this.update(cx, |shell, cx| {
+                if shell.play.attempt != attempt {
+                    return;
+                }
+                if shell.path != path || shell.play.sandbox != Some(sandbox) {
+                    shell.show_external_notice(
+                        failure("O projeto ou o destino mudou. Toque em Play novamente."),
+                        cx,
+                    );
+                    return;
+                }
+                match verified {
+                    Ok((client, _)) if shell.play.external.approved == Some(sandbox) => {
+                        shell.publish_test(client, sandbox, attempt, cx)
+                    }
+                    Ok((_, name)) => {
+                        shell.show_external_notice(Notice::Confirm { sandbox, name }, cx)
+                    }
+                    Err(notice) => shell.show_external_notice(notice, cx),
+                }
+            });
+        })
+        .detach();
+    }
+
+    fn publish_test(
+        &mut self,
+        client: Client,
+        sandbox: PlaySandbox,
+        attempt: u64,
+        cx: &mut Context<Self>,
+    ) {
+        // Uses the same local save as Ctrl+S, including pending script edits.
+        if let Err(message) = self.save_in_place(cx) {
+            self.show_external_notice(failure(format!("O salvamento local falhou. {message}")), cx);
+            return;
+        }
+        let path = self.path.clone();
+        let dom = self.edit_dom().clone();
+        let strip = self.strip_on_publish();
+        self.play.phase = Phase::Starting("Publicando teste…");
+        cx.notify();
+        cx.spawn(async move |this, cx| {
+            let result = cx.background_spawn(async move {
+                let _upload = TEST_UPLOAD.try_lock().map_err(|_| failure("Já existe um envio de teste em andamento."))?;
+                let warning = super::super::roblox_publish::upload_limitations(&dom);
+                let bytes = if strip {
+                    crate::save::Format::Binary.encode(&crate::strip::stripped(&dom))
+                } else {
+                    crate::save::Format::Binary.encode(&dom)
+                }.map_err(failure)?;
+                check_test(&client, sandbox, linked_place(&path))?;
+                let version = client.publish_place(
+                    sandbox.universe_id, sandbox.place_id, &bytes, PublishMode::Published,
+                ).map_err(|err| cloud_error(err, true))?;
+                let stale = client.restart_place_servers(sandbox.universe_id, sandbox.place_id).is_err();
+                Ok::<_, Notice>((version, warning, stale, path))
+            }).await;
+            let _ = this.update(cx, |shell, cx| {
+                if shell.play.attempt != attempt {
+                    return;
+                }
+                let (version, warning, stale, path) = match result {
+                    Ok(result) => result,
+                    Err(notice) => {
+                        shell.show_external_notice(notice, cx);
+                        return;
+                    }
+                };
+                if let Some(warning) = warning {
+                    shell.output.push(PLAY_SOURCE, Feedback::Warning(warning));
+                }
+                let place = sandbox.place_id;
+                let launched = shell.path == path && shell.play.sandbox == Some(sandbox)
+                    && matches!(gpui_mobile::android::roblox_link(place, true), Ok(0));
+                let mut detail = if launched {
+                    "O link foi entregue ao Roblox. Volte pelo seletor de apps do Android.".to_owned()
+                } else {
+                    "O envio terminou. Toque em Abrir Roblox para tentar o link de novo.".to_owned()
+                };
+                if stale {
+                    detail.push_str(" Uma sessão existente pode continuar na versão anterior. Reinicie os servidores de teste no Creator Dashboard se necessário.");
+                }
+                shell.output.push(PLAY_SOURCE, Feedback::Output(format!(
+                    "Versão de teste {version} publicada no lugar {place}."
+                )));
+                shell.show_external_notice(Notice::Published { place, version, detail }, cx);
+            });
+        }).detach();
+    }
+
+    fn show_external_notice(&mut self, notice: Notice, cx: &mut Context<Self>) {
+        self.play.phase = Phase::Idle;
+        self.play.external.notice = Some(notice);
+        cx.notify();
+    }
+
+    pub(in crate::shell) fn close_external_play(&mut self) -> bool {
+        self.play.external.notice.take().is_some()
+    }
+
+    pub(in crate::shell) fn external_play_dialog(
+        &self,
+        window: &Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        let notice = self.play.external.notice.as_ref()?;
+        let action = |id, label, listener: Box<dyn Fn(&mut Shell, &mut Context<Shell>)>| {
+            ui::button(id, label, Weight::Primary, false)
+                .min_h(px(48.))
+                .on_click(cx.listener(move |shell, _, _, cx| listener(shell, cx)))
+                .into_any_element()
+        };
+        let configure = |id, label| {
+            action(
+                id,
+                label,
+                Box::new(|shell, cx| {
+                    shell.close_external_play();
+                    shell.open_settings_on("account", cx);
+                }),
+            )
+        };
+        let (title, message, primary) = match notice {
+            Notice::Setup => (
+                "Configurar experiência de teste".to_owned(),
+                "Escolha um destino privado separado da publicação principal. A criação usa sua sessão Roblox; depois autorize a nova experiência na chave Open Cloud. Se o Roblox recusar a criação, use o Creator Dashboard e selecione o destino existente.".to_owned(),
+                div().flex().flex_col().gap(px(8.)).w_full()
+                    .child(action("external-play-create", "Criar experiência de teste", Box::new(|shell, cx| shell.configure_test_picker(true, cx))))
+                    .child(action("external-play-existing", "Utilizar experiência existente", Box::new(|shell, cx| shell.configure_test_picker(false, cx))))
+                    .child(action("external-play-dashboard", "Creator Dashboard", Box::new(|_, cx| cx.open_url("https://create.roblox.com/dashboard/creations"))))
+                    .into_any_element(),
+            ),
+            Notice::Install(message) => (
+                "Roblox no Android".to_owned(), (*message).to_owned(),
+                action("external-play-install", "Google Play", Box::new(|_, cx| cx.open_url(INSTALL))),
+            ),
+            Notice::Confirm { sandbox, name } => {
+                let sandbox = *sandbox;
+                (
+                    "Confirmar destino de teste".to_owned(),
+                    format!("O Play publica uma versão em {name} (lugar {}). Entre no Roblox com acesso de edição a essa experiência.", sandbox.place_id),
+                    action("external-play-confirm", "Publicar e abrir", Box::new(move |shell, cx| {
+                        if shell.play.sandbox == Some(sandbox) {
+                            shell.play.external.approved = Some(sandbox);
+                            shell.play_start_external(cx);
+                        }
+                    })),
+                )
+            }
+            Notice::Error { message, manage_key } => (
+                "Play não concluído".to_owned(), message.clone(),
+                if *manage_key {
+                    action("external-play-key", "Gerenciar chave", Box::new(|shell, cx| {
+                        shell.close_external_play();
+                        cx.defer(|cx| crate::launcher::open_publishing(|_| {}, cx));
+                        cx.notify();
+                    }))
+                } else {
+                    configure("external-play-target", "Configurar teste")
+                },
+            ),
+            Notice::Published { place, version, detail } => {
+                let (place, version) = (*place, *version);
+                (
+                    format!("Teste publicado · v{version}"), detail.clone(),
+                    action("external-play-reopen", "Abrir Roblox", Box::new(move |shell, cx| {
+                        if !matches!(gpui_mobile::android::roblox_link(place, true), Ok(0)) {
+                            shell.show_external_notice(Notice::Published {
+                                place, version,
+                                detail: "O Android não abriu o link. Instale ou atualize o Roblox e tente de novo aqui.".into(),
+                            }, cx);
+                        }
+                    })),
+                )
+            }
+        };
+        Some(
+            ui::dialog(
+                (f32::from(window.viewport_size().width) - 24.).clamp(250., 520.),
+                ui::dialog_glyph("play", ui::accent(), ui::wash()),
+                title,
+                message,
+                None,
+                vec![
+                    ui::button("external-play-dismiss", "Voltar", Weight::Secondary, false)
+                        .min_h(px(48.))
+                        .on_click(cx.listener(|shell, _, _, cx| {
+                            shell.close_external_play();
+                            cx.notify();
+                        }))
+                        .into_any_element(),
+                    primary,
+                ],
+            )
+            .into_any_element(),
+        )
+    }
+}
diff --git a/crates/rbx_studio/src/shell/playtests/dock.rs b/crates/rbx_studio/src/shell/playtests/dock.rs
