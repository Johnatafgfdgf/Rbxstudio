@@ -0,0 +1,52 @@
+//! Resolution of the rendered scene, independent of its on-screen bounds.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum Resolution {
+    P480,
+    #[default]
+    P720,
+    P1080,
+    Native,
+}
+
+impl Resolution {
+    pub(crate) const MOBILE_OPTIONS: [Self; 4] = [Self::P480, Self::P720, Self::P1080, Self::Native];
+
+    pub(crate) fn value(self) -> &'static str {
+        match self {
+            Self::P480 => "480p",
+            Self::P720 => "720p",
+            Self::P1080 => "1080p",
+            Self::Native => "native",
+        }
+    }
+
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Native => "Nativa",
+            capped => capped.value(),
+        }
+    }
+
+    pub(crate) fn from_value(value: &str) -> Option<Self> {
+        Self::MOBILE_OPTIONS.iter().copied().find(|option| option.value() == value)
+    }
+
+    /// Fit within the preset and the actual view. Picking still uses the
+    /// full on-screen rectangle, and smaller views never need an upscale.
+    pub(crate) fn fit(self, (width, height): (u32, u32)) -> (u32, u32) {
+        let (limit_width, limit_height) = match self {
+            Self::P480 => (854., 480.),
+            Self::P720 => (1280., 720.),
+            Self::P1080 => (1920., 1080.),
+            Self::Native => return (width, height),
+        };
+        if width == 0 || height == 0 {
+            return (width, height);
+        }
+        let width = f64::from(width);
+        let height = f64::from(height);
+        let scale = f64::min(1., f64::min(limit_width / width, limit_height / height));
+        ((width * scale).floor().max(1.) as u32, (height * scale).floor().max(1.) as u32)
+    }
+}
