@@ -0,0 +1,15 @@
+//! Reuse derived immutable rows across camera/hover redraws.
+use std::rc::Rc;
+pub(crate) struct RevisionCache<T> { revision: Option<u64>, value: Option<Rc<T>> }
+impl<T> Default for RevisionCache<T> {
+    fn default() -> Self { Self { revision: None, value: None } }
+}
+impl<T> RevisionCache<T> {
+    pub(crate) fn get(&mut self, revision: u64, build: impl FnOnce() -> T) -> Rc<T> {
+        if self.revision != Some(revision) {
+            self.value = Some(Rc::new(build()));
+            self.revision = Some(revision);
+        }
+        self.value.as_ref().expect("cache initialized").clone()
+    }
+}
