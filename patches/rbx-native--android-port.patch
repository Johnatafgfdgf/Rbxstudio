+/// Original APK lookup over a seekable file; no whole-APK read per texture.
+pub(crate) fn extract_from_archive<R:Read+Seek>(archive:&mut zip::ZipArchive<R>,relative_path:&str)->Result<Vec<u8>,SoberError>{
+ let path=relative_path.replace('\\',"/");
+ if path.starts_with('/')||path.split('/').any(|s|s==".."||s=="."){return Err(SoberError::NotFound(relative_path.into()));}
+ for prefix in ["assets/content/","assets/ExtraContent/","content/","ExtraContent/",""]{
+  let candidate=format!("{prefix}{path}");let name=archive.file_names().find(|n|n.replace('\\',"/").eq_ignore_ascii_case(&candidate)).map(str::to_owned);
+  if let Some(name)=name{
+   let entry=archive.by_name(&name).map_err(|e|SoberError::Zip(e.to_string()))?;
+   if entry.size()>64*1024*1024{return Err(SoberError::Zip("resource entry exceeds 64 MiB".into()));}
+   let mut buf=Vec::new();entry.take(64*1024*1024+1).read_to_end(&mut buf).map_err(|e|SoberError::Io(e.to_string()))?;
+   if buf.len()>64*1024*1024{return Err(SoberError::Zip("resource entry exceeds 64 MiB".into()));}return Ok(buf);
+  }
+ }Err(SoberError::NotFound(relative_path.into()))
 }
 
