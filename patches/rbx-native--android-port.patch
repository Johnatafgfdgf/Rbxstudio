+//! Local Android adapter over the original seekable APK reader.
+use std::{collections::{HashMap,HashSet},fs::File,path::PathBuf,sync::Mutex,time::SystemTime};
+use crate::{AssetError,SoberError};
+type Fallback = dyn Fn(&str)->Option<Vec<u8>>+Send+Sync;
+static FALLBACK:std::sync::OnceLock<std::sync::Arc<Fallback>>=std::sync::OnceLock::new();
+pub fn set_android_resource_fallback(read:impl Fn(&str)->Option<Vec<u8>>+Send+Sync+'static)->bool{FALLBACK.set(std::sync::Arc::new(read)).is_ok()}
+struct OpenArchive{stamp:(u64,Option<SystemTime>),archive:zip::ZipArchive<File>}
+pub struct AndroidContent{paths:Vec<PathBuf>,open:Mutex<HashMap<PathBuf,OpenArchive>>,reported:Mutex<HashSet<String>>}
+impl AndroidContent{
+ pub fn new(paths:Vec<PathBuf>)->Self{Self{paths,open:Mutex::new(HashMap::new()),reported:Mutex::new(HashSet::new())}}
+ pub fn from_env()->Self{Self::new(std::env::var_os("RBX_NATIVE_ANDROID_APKS").map(|s|std::env::split_paths(&s).collect()).unwrap_or_default())}
+ pub fn read(&self,path:&str)->Result<Option<Vec<u8>>,AssetError>{
+  match self.read_local(path)?{Some(bytes)=>Ok(Some(bytes)),None=>Ok(FALLBACK.get().and_then(|read|read(path)))}
+ }
+ /// Archives only: a resolver with networking disabled must not enter the
+ /// process-wide rbx-native download fallback through its local provider.
+ pub fn read_local(&self,path:&str)->Result<Option<Vec<u8>>,AssetError>{
+  let mut paths=Vec::new();for configured in &self.paths{if configured.is_dir(){let mut entries=std::fs::read_dir(configured).map_err(|e|AssetError::LocalContent(e.to_string()))?.filter_map(Result::ok).map(|e|e.path()).filter(|p|p.extension().is_some_and(|e|e.eq_ignore_ascii_case("apk")||e.eq_ignore_ascii_case("zip"))).collect::<Vec<_>>();entries.sort();paths.extend(entries);}else{paths.push(configured.clone());}}
+  if paths.len()>64{return Err(AssetError::LocalContent("more than 64 local resource archives".into()));}
+  let mut open=self.open.lock().map_err(|_|AssetError::LocalContent("archive cache lock poisoned".into()))?;
+  for file in paths{
+   let meta=match std::fs::metadata(&file){Ok(m)=>m,Err(e)if e.kind()==std::io::ErrorKind::NotFound=>continue,Err(e)=>return Err(AssetError::LocalContent(e.to_string()))};let stamp=(meta.len(),meta.modified().ok());
+   if open.get(&file).is_none_or(|c|c.stamp!=stamp){let f=File::open(&file).map_err(|e|AssetError::LocalContent(e.to_string()))?;let archive=zip::ZipArchive::new(f).map_err(|e|AssetError::LocalContent(e.to_string()))?;if archive.len()>50000{return Err(AssetError::LocalContent("more than 50000 archive entries".into()));}open.insert(file.clone(),OpenArchive{stamp,archive});}
+   match crate::sober::apk::extract_from_archive(&mut open.get_mut(&file).unwrap().archive,path){Ok(b)=>return Ok(Some(b)),Err(SoberError::NotFound(_))=>{},Err(e)=>return Err(AssetError::LocalContent(e.to_string()))}
+  }drop(open);Ok(None)
+ }
+ pub(crate) fn optional(&self,path:&str)->Option<Vec<u8>>{match self.read(path){Ok(b)=>b,Err(e)=>{let msg=e.to_string();if self.reported.lock().map_or(true,|mut s|s.insert(msg.clone())){log::warn!("{msg}; trying the existing cache/CDN providers");}None}}}
+ pub fn validate(path:&std::path::Path)->Result<usize,AssetError>{
+  let f=File::open(path).map_err(|e|AssetError::LocalContent(e.to_string()))?;let zip=zip::ZipArchive::new(f).map_err(|e|AssetError::LocalContent(e.to_string()))?;
+  if zip.len()>50000{return Err(AssetError::LocalContent("more than 50000 archive entries".into()));}
+  let count=zip.file_names().filter(|n|{let n=n.replace('\\',"/").to_ascii_lowercase();!n.ends_with('/')&&["assets/content/","assets/extracontent/","content/","extracontent/","textures/","avatar/","fonts/","sky/","models/","sounds/"].iter().any(|p|n.starts_with(p))}).count();
+  if count==0{return Err(AssetError::LocalContent("archive contains no recognized Roblox resource paths".into()));}Ok(count)
+ }
+}
