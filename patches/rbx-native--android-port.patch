diff --git a/crates/rbx_studio/src/shell/toolbox.rs b/crates/rbx_studio/src/shell/toolbox.rs
new file mode 100644
index 0000000..092620b
--- /dev/null
+++ b/crates/rbx_studio/src/shell/toolbox.rs
@@ -0,0 +1,1153 @@
+//! The docked Creator Store and local model importer.
+use std::collections::HashMap;
+use std::io::Cursor;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use gpui_kit::assets::IconName;
+use gpui_kit::component::{
+    h_flex,
+    input::{Input, InputEvent, InputState},
+    v_flex, Icon,
+};
+use gpui_kit::prelude::FluentBuilder;
+use gpui_kit::*;
+use rbx_audit::model_review::{self, Coverage, ScriptReview};
+use rbx_cloud::{Client, StoreAsset, StoreCategory, StoreCreator, StorePage, StoreSearch};
+use rbx_dom::{Ref, WeakDom};
+
+use crate::launcher::ui::{self, Weight};
+use crate::mobile_style as style;
+use crate::tokens;
+
+use super::{chrome, freeze::read_model, Shell};
+
+const MODEL_BYTES: u64 = 64 * 1024 * 1024;
+const PAGE_SIZE: u32 = 20;
+const RESULTS_LIMIT: usize = 100;
+const RECENT_LIMIT: usize = 20;
+const CATEGORIES: [(StoreCategory, &str); 5] = [
+    (StoreCategory::Model, "Modelos"),
+    (StoreCategory::MeshPart, "Malhas"),
+    (StoreCategory::Decal, "Imagens"),
+    (StoreCategory::Audio, "Áudio"),
+    (StoreCategory::Video, "Vídeos"),
+];
+
+impl Shell {
+    pub(super) fn toolbox_dock(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> (Option<AnyElement>, Option<AnyElement>) {
+        let shell = cx.entity().downgrade();
+        let toolbox = self
+            .toolbox
+            .get_or_insert_with(|| cx.new(|cx| Toolbox::new(shell, window, cx)));
+        (None, Some(toolbox.clone().into_any_element()))
+    }
+
+    fn toolbox_workspace(&self) -> Option<Ref> {
+        self.dom
+            .root_refs()
+            .iter()
+            .copied()
+            .find(|&id| self.dom.get(id).is_some_and(|i| i.class() == "Workspace"))
+    }
+
+    fn finish_toolbox_review(&mut self, choice: ImportChoice, cx: &mut Context<Self>) {
+        let Some(mut review) = self.toolbox_review.take() else {
+            return;
+        };
+        let result = match choice {
+            ImportChoice::Cancel => Ok(0),
+            _ if self.path != review.path || self.toolbox_workspace() != Some(review.workspace) => {
+                Err("O projeto mudou durante a revisão.".into())
+            }
+            _ => {
+                if matches!(choice, ImportChoice::WithoutScripts) {
+                    model_review::remove_model_scripts(&mut review.content, &review.scripts);
+                }
+                self.graft_imported(&review.content, review.workspace, true, cx)
+                    .map(|roots| roots.len())
+            }
+        };
+        let _ = review.toolbox.update(cx, |toolbox, cx| {
+            toolbox.finish_import(result, review.recent, cx)
+        });
+        cx.notify();
+    }
+}
+
+/// Put the new sky where both the editor and Play read it. Old skies stay
+/// in the document under an archive folder, and the import undoes as one step.
+pub(super) fn apply_imported_sky(dom: &mut WeakDom, roots: &[Ref]) {
+    let mut visit: Vec<_> = roots.iter().rev().copied().collect();
+    let sky = loop {
+        let Some(instance) = visit.pop().and_then(|id| dom.get(id)) else {
+            return;
+        };
+        if instance.class() == "Sky" {
+            break instance.referent();
+        }
+        visit.extend(instance.children().iter().rev());
+    };
+    let lighting = dom
+        .root_refs()
+        .iter()
+        .copied()
+        .find(|&id| {
+            dom.get(id)
+                .is_some_and(|instance| instance.class() == "Lighting")
+        })
+        .unwrap_or_else(|| dom.new_instance("Lighting", "Lighting", None));
+    let children = dom.get(lighting).map(|i| i.children()).unwrap_or_default();
+    let previous: Vec<_> = children
+        .iter()
+        .copied()
+        .filter(|&id| {
+            id != sky
+                && dom
+                    .get(id)
+                    .is_some_and(|instance| instance.class() == "Sky")
+        })
+        .collect();
+    if !previous.is_empty() {
+        let archive = children
+            .iter()
+            .copied()
+            .find(|&id| {
+                dom.get(id)
+                    .is_some_and(|i| i.class() == "Folder" && i.name() == "Skyboxes anteriores")
+            })
+            .unwrap_or_else(|| dom.new_instance("Folder", "Skyboxes anteriores", Some(lighting)));
+        for id in previous {
+            dom.set_parent(id, Some(archive));
+        }
+    }
+    dom.set_parent(sky, Some(lighting));
+}
+
+enum Source {
+    Local(PathBuf),
+    Store(u64, Option<StoreAsset>),
+}
+
+impl Source {
+    fn load(
+        self,
+        session: Option<&rbx_cloud::heartbeats::SessionCookie>,
+    ) -> Result<WeakDom, String> {
+        match self {
+            Self::Local(path) => {
+                let ext = path
+                    .extension()
+                    .and_then(|ext| ext.to_str())
+                    .unwrap_or_default();
+                if !ext.eq_ignore_ascii_case("rbxm") && !ext.eq_ignore_ascii_case("rbxmx") {
+                    return Err("Choose a Roblox model file (.rbxm or .rbxmx).".into());
+                }
+                let size = std::fs::metadata(&path)
+                    .map_err(|error| error.to_string())?
+                    .len();
+                if size > MODEL_BYTES {
+                    return Err("The local model is larger than 64 MB.".into());
+                }
+                let bytes = std::fs::read(path).map_err(|error| error.to_string())?;
+                read_model(&bytes)
+            }
+            Self::Store(id, asset) => {
+                crate::mcp::download_toolbox_asset(id, asset.map(|asset| asset.name), session)
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Collection {
+    Store,
+    Inventory,
+    Recent,
+    Creations,
+}
+
+impl Collection {
+    const ALL: [(Self, &str, IconName); 4] = [
+        (Self::Store, "Loja do Criador", IconName::Store),
+        (Self::Inventory, "Inventário", IconName::Package),
+        (Self::Recent, "Recentes", IconName::Clock),
+        (Self::Creations, "Criações", IconName::Hammer),
+    ];
+}
+
+pub(super) struct Toolbox {
+    shell: WeakEntity<Shell>,
+    input: Entity<InputState>,
+    collection: Collection,
+    category: StoreCategory,
+    options_open: bool,
+    verified_only: bool,
+    query: String,
+    results: Vec<StoreAsset>,
+    recent: Vec<StoreAsset>,
+    thumbnails: HashMap<u64, Arc<RenderImage>>,
+    thumbnail_job: Option<Task<()>>,
+    detail: Option<StoreAsset>,
+    page: Option<String>,
+    busy: bool,
+    status: String,
+    _input: Subscription,
+}
+
+impl Toolbox {
+    fn new(shell: WeakEntity<Shell>, window: &mut Window, cx: &mut Context<Self>) -> Self {
+        let input = cx.new(|cx| InputState::new(window, cx).placeholder("Buscar"));
+        let subscription = cx.subscribe(&input, |this, _, event: &InputEvent, cx| {
+            if matches!(event, InputEvent::PressEnter { .. }) {
+                this.search(false, cx);
+            }
+        });
+        let mut view = Self {
+            shell,
+            input,
+            collection: Collection::Store,
+            category: StoreCategory::Model,
+            options_open: false,
+            verified_only: false,
+            query: String::new(),
+            results: Vec::new(),
+            recent: Vec::new(),
+            thumbnails: HashMap::new(),
+            thumbnail_job: None,
+            detail: None,
+            page: None,
+            busy: false,
+            status: String::new(),
+            _input: subscription,
+        };
+        view.search(false, cx);
+        view
+    }
+
+    fn search(&mut self, more: bool, cx: &mut Context<Self>) {
+        if self.busy {
+            return;
+        }
+        if !more {
+            self.query = self.input.read(cx).value().trim().to_owned();
+            self.detail = None;
+            self.options_open = false;
+            self.results.clear();
+            self.page = None;
+        }
+        let collection = self.collection;
+        let request = StoreSearch {
+            query: self.query.clone(),
+            category: Some(self.category),
+            max_price_cents: (collection == Collection::Store).then_some(0),
+            verified_only: self.verified_only && collection == Collection::Store,
+            page_size: PAGE_SIZE,
+            page_token: self.page.clone(),
+            ..Default::default()
+        };
+        if collection == Collection::Recent {
+            let needle = self.query.to_lowercase();
+            self.results.extend(
+                self.recent
+                    .iter()
+                    .filter(|item| item.name.to_lowercase().contains(&needle))
+                    .cloned(),
+            );
+            self.status = if self.results.is_empty() {
+                "Nenhum item recente.".into()
+            } else {
+                String::new()
+            };
+            self.load_thumbnails(cx);
+            cx.notify();
+            return;
+        }
+        self.busy = true;
+        self.status = "Carregando…".into();
+        cx.notify();
+        cx.spawn(async move |toolbox, cx| {
+            let session = if matches!(collection, Collection::Inventory | Collection::Creations) {
+                crate::key_store::read_session(cx).await.ok().flatten()
+            } else {
+                None
+            };
+            let key = if collection == Collection::Inventory {
+                crate::key_store::read(cx).await.ok().flatten()
+            } else {
+                None
+            };
+            let found = cx
+                .background_spawn(async move {
+                    load_collection(collection, request, session.as_ref(), key)
+                })
+                .await;
+            let _ = toolbox.update(cx, |this, cx| {
+                this.busy = false;
+                match found {
+                    Ok(page) => {
+                        let count = page.assets.len();
+                        let mut seen: std::collections::HashSet<_> =
+                            this.results.iter().map(|asset| asset.id).collect();
+                        this.results.extend(
+                            page.assets
+                                .into_iter()
+                                .filter(|asset| seen.insert(asset.id)),
+                        );
+                        this.page = page.next_page_token;
+                        this.status = if this.results.is_empty() {
+                            "Nenhum item encontrado.".into()
+                        } else {
+                            String::new()
+                        };
+                        #[cfg(target_os = "android")]
+                        eprintln!("RBX_ANDROID_TOOLBOX_RESULTS {count}");
+                        #[cfg(not(target_os = "android"))]
+                        let _ = count;
+                        this.load_thumbnails(cx);
+                    }
+                    Err(error) => this.status = error,
+                }
+                cx.notify();
+            });
+        })
+        .detach();
+    }
+
+    fn load_thumbnails(&mut self, cx: &mut Context<Self>) {
+        let ids: Vec<_> = self
+            .results
+            .iter()
+            .map(|asset| asset.id)
+            .filter(|id| !self.thumbnails.contains_key(id))
+            .collect();
+        if ids.is_empty() {
+            return;
+        }
+        self.thumbnail_job = Some(cx.spawn(async move |toolbox, cx| {
+            let decoded = cx
+                .background_spawn(async move {
+                    Client::new(None)
+                        .asset_thumbnails(&ids)
+                        .unwrap_or_default()
+                        .into_iter()
+                        .filter_map(|(id, bytes)| Some((id, decode_thumbnail(&bytes)?)))
+                        .collect::<Vec<_>>()
+                })
+                .await;
+            let _ = toolbox.update(cx, |this, cx| {
+                // The renderer's texture atlas must lose the entries along with this cache.
+                if this.thumbnails.len() + decoded.len() > RESULTS_LIMIT + RECENT_LIMIT {
+                    let visible: std::collections::HashSet<_> = this
+                        .results
+                        .iter()
+                        .chain(&this.recent)
+                        .map(|asset| asset.id)
+                        .collect();
+                    this.thumbnails.retain(|id, image| {
+                        if visible.contains(id) {
+                            return true;
+                        }
+                        cx.drop_image(image.clone(), None);
+                        false
+                    });
+                }
+                this.thumbnails.extend(decoded);
+                cx.notify();
+            });
+        }));
+    }
+
+    fn show_collection(&mut self, collection: Collection, cx: &mut Context<Self>) {
+        if self.busy || self.collection == collection {
+            return;
+        }
+        self.collection = collection;
+        self.options_open = false;
+        self.search(false, cx);
+    }
+
+    fn insert_id(&mut self, cx: &mut Context<Self>) {
+        match self.input.read(cx).value().trim().parse::<u64>() {
+            Ok(id) if id > 0 => self.import(Source::Store(id, None), cx),
+            _ => {
+                self.status = "Digite o ID numérico no campo de busca.".into();
+                cx.notify();
+            }
+        }
+    }
+
+    fn import(&mut self, source: Source, cx: &mut Context<Self>) {
+        if self.busy {
+            return;
+        }
+        let Some(shell) = self.shell.upgrade() else {
+            return;
+        };
+        let Some(workspace) = shell.read(cx).toolbox_workspace() else {
+            self.status = "O projeto não tem Workspace.".into();
+            cx.notify();
+            return;
+        };
+        let path = shell.read(cx).path.clone();
+        self.busy = true;
+        self.status = "Carregando e analisando o item…".into();
+        let recent = match &source {
+            Source::Store(id, asset) => Some(asset.clone().unwrap_or_else(|| asset_by_id(*id))),
+            Source::Local(_) => None,
+        };
+        let label = match &source {
+            Source::Store(id, _) => recent
+                .as_ref()
+                .map_or_else(|| id.to_string(), |item| item.name.clone()),
+            Source::Local(path) => path
+                .file_name()
+                .unwrap_or_default()
+                .to_string_lossy()
+                .into_owned(),
+        };
+        let shell = shell.downgrade();
+        cx.notify();
+        cx.spawn(async move |toolbox, cx| {
+            let session = if matches!(&source, Source::Store(..)) {
+                crate::key_store::read_session(cx).await.ok().flatten()
+            } else {
+                None
+            };
+            let scanned = cx
+                .background_spawn(async move {
+                    let content = source.load(session.as_ref())?;
+                    let scripts = model_review::review_model(&content);
+                    Ok::<_, String>((content, scripts))
+                })
+                .await;
+            let result = scanned.and_then(|(content, scripts)| {
+                shell
+                    .update(cx, |shell, cx| {
+                        if shell.path != path
+                            || shell.toolbox_workspace() != Some(workspace)
+                            || shell.live_shown()
+                        {
+                            return Err("Volte ao projeto em edição para inserir o item.".into());
+                        }
+                        shell.toolbox_review = Some(ImportReview {
+                            content,
+                            scripts,
+                            label,
+                            workspace,
+                            path,
+                            recent,
+                            toolbox: toolbox.clone(),
+                            selected: None,
+                            page: 0,
+                        });
+                        cx.notify();
+                        Ok(())
+                    })
+                    .map_err(|_| "O projeto foi fechado.".to_owned())?
+            });
+            if let Err(error) = result {
+                let _ = toolbox.update(cx, |this, cx| this.finish_import(Err(error), None, cx));
+            }
+        })
+        .detach();
+    }
+
+    fn finish_import(
+        &mut self,
+        result: Result<usize, String>,
+        recent: Option<StoreAsset>,
+        cx: &mut Context<Self>,
+    ) {
+        self.busy = false;
+        self.status = match result {
+            Ok(0) => "Importação cancelada.".into(),
+            Ok(count) => {
+                if let Some(asset) = recent {
+                    self.recent.retain(|item| item.id != asset.id);
+                    self.recent.insert(0, asset);
+                    self.recent.truncate(RECENT_LIMIT);
+                    if self.collection == Collection::Recent {
+                        self.search(false, cx);
+                    }
+                }
+                #[cfg(target_os = "android")]
+                eprintln!("RBX_ANDROID_TOOLBOX_INSERTED {count}");
+                self.options_open = false;
+                format!("{count} item(ns) inserido(s).")
+            }
+            Err(error) => format!("Falha ao inserir. {error}"),
+        };
+        cx.notify();
+    }
+
+    fn import_asset(&mut self, asset: StoreAsset, cx: &mut Context<Self>) {
+        self.import(Source::Store(asset.id, Some(asset)), cx);
+    }
+
+    fn choose_model(&mut self, cx: &mut Context<Self>) {
+        if self.busy {
+            return;
+        }
+        let chosen = cx.prompt_for_paths(PathPromptOptions {
+            files: true,
+            directories: false,
+            multiple: false,
+            prompt: Some("Insert Roblox model (.rbxm or .rbxmx)".into()),
+        });
+        self.busy = true;
+        cx.notify();
+        cx.spawn(async move |toolbox, cx| {
+            let result = chosen.await;
+            let _ = toolbox.update(cx, |this, cx| {
+                this.busy = false;
+                match result {
+                    Ok(Ok(Some(paths))) => {
+                        if let Some(path) = paths.into_iter().next() {
+                            this.import(Source::Local(path), cx);
+                        }
+                    }
+                    Ok(Err(error)) => this.status = format!("Couldn't open files. {error}"),
+                    _ => {}
+                }
+                cx.notify();
+            });
+        })
+        .detach();
+    }
+}
+
+fn load_collection(
+    collection: Collection,
+    mut request: StoreSearch,
+    session: Option<&rbx_cloud::heartbeats::SessionCookie>,
+    key: Option<rbx_cloud::ApiKey>,
+) -> Result<StorePage, String> {
+    if collection == Collection::Store {
+        return Client::new(None)
+            .search_creator_store(&request)
+            .map_err(|error| format!("Falha na busca. {error}"));
+    }
+    let session = session.ok_or("Conecte sua conta para ver esta seção.")?;
+    let user = rbx_cloud::heartbeats::authenticated_user_id(session)
+        .map_err(|_| "A sessão precisa ser reconectada.")?;
+    if collection == Collection::Creations {
+        request.creator = Some(StoreCreator::User(user));
+        return Client::new(None)
+            .search_creator_store(&request)
+            .map_err(|error| format!("Falha ao buscar suas criações públicas. {error}"));
+    }
+
+    let key =
+        key.ok_or("O inventário requer uma chave Open Cloud com acesso de leitura ao inventário.")?;
+    let client = Client::new(Some(key));
+    let asset_type = match request.category {
+        Some(StoreCategory::MeshPart) => "MESH_PART",
+        Some(StoreCategory::Decal) => "DECAL",
+        Some(StoreCategory::Audio) => "AUDIO",
+        Some(StoreCategory::Video) => "VIDEO",
+        _ => "MODEL",
+    };
+    let page = client
+        .inventory_assets(
+            user,
+            &[asset_type],
+            PAGE_SIZE,
+            request.page_token.as_deref(),
+        )
+        .map_err(|error| format!("Falha ao ler o inventário. {error}"))?;
+    let ids: Vec<_> = page.assets.iter().map(|asset| asset.asset_id).collect();
+    let needle = request.query.to_lowercase();
+    let assets = ids
+        .iter()
+        .zip(Client::new(None).creator_store_assets(&ids))
+        .map(|(&id, asset)| asset.unwrap_or_else(|_| asset_by_id(id)))
+        .filter(|asset| {
+            asset.name.to_lowercase().contains(&needle) || asset.id.to_string().contains(&needle)
+        })
+        .collect();
+    Ok(StorePage {
+        assets,
+        next_page_token: page.next_page_token,
+        total_results: None,
+        available_facets: Vec::new(),
+    })
+}
+
+fn asset_by_id(id: u64) -> StoreAsset {
+    StoreAsset {
+        id,
+        name: format!("Item {id}"),
+        description: String::new(),
+        asset_type_id: 0,
+        creator_name: String::new(),
+        creator: None,
+        verified: false,
+        purchasable: false,
+        price_cents: None,
+        currency: String::new(),
+        up_vote_percent: None,
+        vote_count: 0,
+        update_time: String::new(),
+    }
+}
+
+fn decode_thumbnail(bytes: &[u8]) -> Option<Arc<RenderImage>> {
+    if bytes.len() > 512 * 1024 {
+        return None;
+    }
+    let mut reader = image::ImageReader::with_format(Cursor::new(bytes), image::ImageFormat::Png);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(256);
+    limits.max_image_height = Some(256);
+    limits.max_alloc = Some(1024 * 1024);
+    reader.limits(limits);
+    let rgba = reader.decode().ok()?.into_rgba8();
+    let (width, height) = rgba.dimensions();
+    crate::render_image::to_render_image(rgba.into_raw(), width, height)
+}
