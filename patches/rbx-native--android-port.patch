new file mode 100644
index 0000000..d79ea99
--- /dev/null
+++ b/crates/rbx_studio/src/mobile_style.rs
@@ -0,0 +1,192 @@
+//! Shared Android chrome for the launcher and editor. The preview reads these
+//! same constants so changes to color, shape or motion stay visible there.
+use std::time::{Duration, Instant};
+
+use gpui_kit::*;
+
+use crate::{theme, tokens};
+
+pub(crate) const BACKGROUND: u32 = 0x0B1322;
+pub(crate) const SURFACE_TOP: u32 = 0x19263C;
+pub(crate) const SURFACE_BOTTOM: u32 = 0x101A2B;
+pub(crate) const CONTROL_TOP: u32 = 0x283B56;
+pub(crate) const CONTROL_BOTTOM: u32 = 0x19273F;
+pub(crate) const BORDER: u32 = 0x3C526E;
+pub(crate) const FIELD: u32 = 0x142338;
+pub(crate) const ACCENT: u32 = 0x42DBEF;
+pub(crate) const INK: u32 = 0xF2F7FF;
+pub(crate) const MUTED: u32 = 0xADBED2;
+pub(crate) const HERO_TOP: u32 = 0x133D51;
+pub(crate) const HERO_BOTTOM: u32 = 0x102438;
+pub(crate) const PRIMARY_TOP: u32 = 0x59E6F7;
+pub(crate) const PRIMARY_BOTTOM: u32 = 0x24BBD8;
+pub(crate) const PRIMARY_INK: u32 = 0x082437;
+pub(crate) const CONTROL_RADIUS: f32 = 12.;
+pub(crate) const SURFACE_RADIUS: f32 = 18.;
+pub(crate) const ROW_RADIUS: f32 = 10.;
+pub(crate) const VIEWPORT_RADIUS: f32 = 16.;
+pub(crate) const OPEN_MS: u64 = 180;
+pub(crate) const CLOSE_MS: u64 = 140;
+pub(crate) const SHEET_SHIFT: f32 = 8.;
+pub(crate) const DRAWER_SHIFT: f32 = 14.;
+
+// Honor light, high contrast and installed themes. A custom accent on the
+// built-in dark palette also stays in use.
+fn default_dark() -> bool {
+    let active = theme::active();
+    let default = theme::Palette::builtin();
+    active.mode == default.mode
+        && active.color("dock") == default.color("dock")
+        && active.color("black") == default.color("black")
+}
+
+pub(crate) fn background() -> Rgba {
+    if default_dark() { rgb(BACKGROUND) } else { tokens::black() }
+}
+
+pub(crate) fn border() -> Rgba {
+    if default_dark() { rgb(BORDER) } else { tokens::border2() }
+}
+
+pub(crate) fn text() -> Rgba {
+    if default_dark() { rgb(INK) } else { tokens::text_strong() }
+}
+
+pub(crate) fn muted() -> Rgba {
+    if default_dark() { rgb(MUTED) } else { tokens::text_label() }
+}
+
+pub(crate) fn accent() -> Rgba {
+    let chosen = tokens::check_on();
+    if default_dark() && chosen == theme::Palette::builtin().color("check_on") {
+        rgb(ACCENT)
+    } else {
+        chosen
+    }
+}
+
+pub(crate) fn wash() -> Rgba {
+    Rgba { a: 0.16, ..accent() }
+}
+
+fn gradient(top: u32, bottom: u32) -> Background {
+    linear_gradient(180., linear_color_stop(rgb(top), 0.), linear_color_stop(rgb(bottom), 1.))
+}
+
+pub(crate) fn surface<T: Styled>(element: T) -> T {
+    let element = element.rounded(px(SURFACE_RADIUS)).border_1().border_color(border());
+    if default_dark() {
+        element.bg(gradient(SURFACE_TOP, SURFACE_BOTTOM))
+    } else {
+        element.bg(tokens::dock())
+    }
+}
+
+pub(crate) fn hero<T: Styled>(element: T) -> T {
+    let element = surface(element);
+    if default_dark() { element.bg(gradient(HERO_TOP, HERO_BOTTOM)) } else { element }
+}
+
+pub(crate) fn control<T: Styled>(element: T) -> T {
+    let element = element.rounded(px(CONTROL_RADIUS)).border_1().border_color(border());
+    if default_dark() {
+        element.bg(gradient(CONTROL_TOP, CONTROL_BOTTOM))
+    } else {
+        element.bg(tokens::field_select())
+    }
+}
+
+pub(crate) fn selected<T: Styled>(element: T) -> T {
+    element.bg(wash()).border_color(accent()).text_color(accent())
+}
+
+pub(crate) fn primary<T: Styled>(element: T) -> T {
+    if default_dark() && accent() == rgb(ACCENT) {
+        element.bg(gradient(PRIMARY_TOP, PRIMARY_BOTTOM))
+            .border_color(rgb(PRIMARY_TOP))
+            .text_color(rgb(PRIMARY_INK))
+    } else {
+        selected(element)
+    }
+}
+
+pub(crate) fn field<T: Styled>(element: T) -> T {
+    element.rounded(px(CONTROL_RADIUS)).border_1().border_color(border())
+        .bg(if default_dark() { rgb(FIELD) } else { tokens::field_select() })
+}
+
+pub(crate) fn appear<T: IntoElement + Styled + 'static>(
+    element: T,
+    id: impl Into<ElementId>,
+) -> AnyElement {
+    if !cfg!(target_os = "android") || tokens::reduced_motion() {
+        return element.into_any_element();
+    }
+    element
+        .with_animation(
+            id,
+            Animation::new(Duration::from_millis(OPEN_MS)).with_easing(tokens::easing_soft),
+            |element, amount| element.opacity(amount),
+        )
+        .into_any_element()
+}
+
+/// Keeps a surface around just long enough to animate its departure. The
+/// caller disables interaction as soon as the logical state closes.
+pub(crate) struct Reveal<T> {
+    value: Option<T>,
+    open: bool,
+    from: f32,
+    changed_at: Instant,
+}
+
+impl<T> Default for Reveal<T> {
+    fn default() -> Self {
+        Self { value: None, open: false, from: 0., changed_at: Instant::now() }
+    }
+}
+
+pub(crate) struct RevealFrame<T> {
+    pub(crate) value: T,
+    pub(crate) amount: f32,
+    pub(crate) interactive: bool,
+}
+
+impl<T: Copy + PartialEq> Reveal<T> {
+    pub(crate) fn target(&self) -> Option<T> {
+        if self.open { self.value } else { None }
+    }
+
+    fn amount(&self, now: Instant) -> (f32, bool) {
+        let millis = if self.open { OPEN_MS } else { CLOSE_MS };
+        let time = (now.saturating_duration_since(self.changed_at).as_secs_f32()
+            / Duration::from_millis(millis).as_secs_f32()).min(1.);
+        let target = if self.open { 1. } else { 0. };
+        (self.from + (target - self.from) * tokens::easing_soft(time), time < 1.)
+    }
+
+    pub(crate) fn frame(&mut self, desired: Option<T>, window: &Window) -> Option<RevealFrame<T>> {
+        let now = Instant::now();
+        let open = desired.is_some();
+        if open != self.open || (open && desired != self.value) {
+            self.from = if open && desired != self.value { 0. } else { self.amount(now).0 };
+            self.value = desired.or(self.value);
+            self.open = open;
+            self.changed_at = now;
+        }
+        let (amount, running) = if tokens::reduced_motion() {
+            self.from = if open { 1. } else { 0. };
+            (self.from, false)
+        } else {
+            self.amount(now)
+        };
+        if !open && (!running || amount <= 0.) {
+            self.value = None;
+        }
+        let value = self.value?;
+        if running {
+            window.request_animation_frame();
+        }
+        Some(RevealFrame { value, amount, interactive: open })
+    }
+}
