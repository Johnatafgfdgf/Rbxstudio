index 0000000..8025b1b
--- /dev/null
+++ b/crates/rbx_audit/src/model_review.rs
@@ -0,0 +1,225 @@
+//! Bounded static review of a model before insertion.
+
+use full_moon::LuaVersion;
+use full_moon::tokenizer::{Lexer, LexerResult, Symbol, Token, TokenType};
+use rbx_dom::{Ref, Variant, WeakDom};
+
+use crate::{Target, Usage, full_name, requires, side, walk};
+
+const PER_SCRIPT_BYTES: usize = 128 * 1024;
+const MODEL_BYTES: usize = 2 * 1024 * 1024;
+// A bounded token count also limits the recursive AST walk.
+const AST_TOKENS: usize = 480;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Risk {
+    ExternalCode,
+    DynamicCode,
+    Network,
+    GameMutation,
+    Obfuscation,
+    UnresolvedRequire,
+}
+
+impl Risk {
+    pub fn description(self) -> &'static str {
+        match self {
+            Self::ExternalCode => "Pode carregar código de um asset externo.",
+            Self::DynamicCode => "Pode executar código ou acessar o ambiente dinamicamente.",
+            Self::Network => "Pode acessar serviços de rede ou dados persistentes.",
+            Self::GameMutation => "Pode alterar scripts, permissões ou objetos fora do modelo.",
+            Self::Obfuscation => "Há trechos codificados que dificultam a leitura.",
+            Self::UnresolvedRequire => "O destino de require não pôde ser verificado.",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Coverage {
+    Scanned,
+    MissingSource,
+    Partial,
+}
+
+#[derive(Debug)]
+pub struct ScriptReview {
+    pub instance: Ref,
+    pub class: String,
+    pub path: String,
+    pub coverage: Coverage,
+    pub risks: Vec<(Risk, usize)>,
+}
+
+pub fn script_source(dom: &WeakDom, script: Ref) -> Option<&str> {
+    match dom.get(script)?.properties().get("Source")? {
+        Variant::String(source) => Some(source),
+        _ => None,
+    }
+}
+
+pub fn review_model(dom: &WeakDom) -> Vec<ScriptReview> {
+    let mut remaining = MODEL_BYTES;
+    let mut scripts = Vec::new();
+    let mut pending: Vec<_> = dom.root_refs().iter().rev().copied().collect();
+    while let Some(id) = pending.pop() {
+        let Some(node) = dom.get(id) else { continue };
+        pending.extend(node.children().iter().rev());
+        let Some(side) = side(dom, id) else { continue };
+        let mut review = ScriptReview {
+            instance: id,
+            class: node.class().to_owned(),
+            path: full_name(dom, id),
+            coverage: Coverage::MissingSource,
+            risks: Vec::new(),
+        };
+        if let Some(source) = script_source(dom, id) {
+            if source.len() <= remaining && source.len() <= PER_SCRIPT_BYTES {
+                remaining -= source.len();
+                scan(dom, side, source, &mut review);
+            } else {
+                review.coverage = Coverage::Partial;
+            }
+        }
+        scripts.push(review);
+    }
+    scripts
+}
+
+fn scan(dom: &WeakDom, side: crate::Side, source: &str, review: &mut ScriptReview) {
+    let tokens = match Lexer::new(source, LuaVersion::luau()).collect() {
+        LexerResult::Ok(tokens) => tokens,
+        LexerResult::Recovered(tokens, _) => {
+            review.coverage = Coverage::Partial;
+            tokens
+        }
+        LexerResult::Fatal(_) => {
+            review.coverage = Coverage::Partial;
+            return;
+        }
+    };
+    let significant: Vec<_> = tokens
+        .iter()
+        .filter(|t| !t.token_type().is_trivia())
+        .collect();
+    let parsed = if significant.len() <= AST_TOKENS && review.coverage != Coverage::Partial {
+        let parsed = full_moon::parse_fallible(source, LuaVersion::luau());
+        parsed.errors().is_empty().then(|| parsed.into_ast())
+    } else {
+        None
+    };
+    review.coverage = if parsed.is_some() {
+        Coverage::Scanned
+    } else {
+        Coverage::Partial
+    };
+    let mut usage = Usage::default();
+    if let Some(ast) = parsed {
+        walk::script(
+            dom,
+            review.instance,
+            side,
+            &ast,
+            &Default::default(),
+            None,
+            &mut usage,
+        );
+        for call in &usage.requires {
+            match requires::target(dom, call) {
+                Target::Module(_) => {}
+                Target::Unknown("asset id") => flag(review, Risk::ExternalCode, call.line),
+                Target::Unknown(_) => flag(review, Risk::UnresolvedRequire, call.line),
+            }
+        }
+    }
+    for (index, token) in significant.iter().enumerate() {
+        let at = |i: usize| significant.get(i).map(|t| t.token_type());
+        let line = token.start_position().line();
+        let name = match token.token_type() {
+            TokenType::Identifier { identifier } => identifier.as_str(),
+            TokenType::StringLiteral { literal, .. } => {
+                let literal = literal.as_str();
+                if literal.matches("\\x").count() >= 8
+                    || literal
+                        .as_bytes()
+                        .windows(2)
+                        .filter(|pair| pair[0] == b'\\' && pair[1].is_ascii_digit())
+                        .count()
+                        >= 8
+                {
+                    flag(review, Risk::Obfuscation, line);
+                }
+                if index > 0
+                    && (symbol(at(index - 1), Symbol::LeftBracket)
+                        || matches!(
+                            literal,
+                            "HttpService" | "DataStoreService" | "InsertService"
+                        ))
+                {
+                    literal
+                } else {
+                    continue;
+                }
+            }
+            _ => continue,
+        };
+        let risk = match name {
+            "require" if symbol(at(index + 1), Symbol::LeftParen) => {
+                if matches!(at(index + 2), Some(TokenType::Number { .. })) {
+                    Some(Risk::ExternalCode)
+                } else if !usage.requires.iter().any(|call| call.line == line) {
+                    Some(Risk::UnresolvedRequire)
+                } else {
+                    None
+                }
+            }
+            "loadstring" | "getfenv" | "setfenv" => Some(Risk::DynamicCode),
+            "HttpService" | "DataStoreService" | "RequestAsync" | "PostAsync"
+            | "MessagingService" | "MemoryStoreService" => Some(Risk::Network),
+            "LoadAsset" | "LoadAssetVersion" | "GetObjects" => Some(Risk::ExternalCode),
+            "ClearAllChildren" | "Kick" | "BanAsync" | "LoadStringEnabled" | "Capabilities"
+            | "Sandboxed" => Some(Risk::GameMutation),
+            "Source" if symbol(at(index + 1), Symbol::Equal) => Some(Risk::GameMutation),
+            "char" if encoded_bytes(&significant[index + 1..]) => Some(Risk::Obfuscation),
+            _ => None,
+        };
+        if let Some(risk) = risk {
+            flag(review, risk, line);
+        }
+    }
+}
+
+fn symbol(token: Option<&TokenType>, expected: Symbol) -> bool {
+    matches!(token, Some(TokenType::Symbol { symbol }) if *symbol == expected)
+}
+
+fn encoded_bytes(tokens: &[&Token]) -> bool {
+    let mut types = tokens.iter().map(|t| t.token_type());
+    if !symbol(types.next(), Symbol::LeftParen) {
+        return false;
+    }
+    (0..12).all(|i| {
+        matches!(types.next(), Some(TokenType::Number { .. }))
+            && (i == 11 || symbol(types.next(), Symbol::Comma))
+    })
+}
+
+fn flag(review: &mut ScriptReview, risk: Risk, line: usize) {
+    if !review.risks.iter().any(|(seen, _)| *seen == risk) {
+        review.risks.push((risk, line));
+    }
+}
+
+/// Keep the art and other non-script descendants of removed code containers.
+pub fn remove_model_scripts(dom: &mut WeakDom, scripts: &[ScriptReview]) {
+    for script in scripts {
+        let Some(node) = dom.get(script.instance) else {
+            continue;
+        };
+        let children = node.children().to_vec();
+        let parent = dom.parent(script.instance);
+        for child in children {
+            dom.set_parent(child, parent);
+        }
+        dom.remove(script.instance);
+    }
+}
