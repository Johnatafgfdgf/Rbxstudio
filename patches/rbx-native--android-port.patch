@@ -0,0 +1,117 @@
+//! Home images from Roblox's public documentation and thumbnail API.
+//! The account is taken from the authorized Open Cloud key check.
+
+use std::io::Cursor;
+use std::sync::Arc;
+
+use gpui_kit::*;
+use rbx_cloud::Client;
+
+use super::HomeWindow;
+
+// Same order as Template::ALL. The originals are fetched on demand.
+const TEMPLATE_IMAGES: [&str; 3] = [
+    "https://prod.docsiteassets.roblox.com/assets/resources/templates/Baseplate-Template.png",
+    "https://prod.docsiteassets.roblox.com/assets/resources/templates/Classic-Baseplate-Template.png",
+    "https://prod.docsiteassets.roblox.com/assets/resources/templates/Flat-Terrain-Template.png",
+];
+
+impl HomeWindow {
+    pub(super) fn load_template_images(&self, cx: &mut Context<Self>) {
+        cx.spawn(async move |home, cx| {
+            for (index, url) in TEMPLATE_IMAGES.into_iter().enumerate() {
+                let image = cx
+                    .background_spawn(async move { template_image(index, url) })
+                    .await;
+                if let Some(image) = image {
+                    if home
+                        .update(cx, |home, cx| {
+                            home.template_images[index] = Some(image);
+                            cx.notify();
+                        })
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+            }
+        })
+        .detach();
+    }
+
+    pub(super) fn load_account_headshot(
+        &self,
+        user_id: u64,
+        check_id: u64,
+        cx: &mut Context<Self>,
+    ) {
+        cx.spawn(async move |home, cx| {
+            let image = cx
+                .background_spawn(async move {
+                    let client = Client::new(None);
+                    let (_, url) = client
+                        .user_headshot_urls(&[user_id])
+                        .ok()?
+                        .into_iter()
+                        .find(|(id, _)| *id == user_id)?;
+                    let png = client.download_image(&url).ok()?;
+                    render_image(decode(&png, 96)?)
+                })
+                .await;
+            let _ = home.update(cx, |home, cx| {
+                if home.key_check_id == check_id && home.user_id == Some(user_id) {
+                    home.account_headshot = image;
+                    cx.notify();
+                }
+            });
+        })
+        .detach();
+    }
+}
+
+fn template_image(index: usize, url: &str) -> Option<Arc<RenderImage>> {
+    let path = rbx_assets::cache_root().map(|root| {
+        root.join("launcher")
+            .join(format!("template-preview-v1-{index}.png"))
+    });
+    if let Some(image) = path
+        .as_ref()
+        .and_then(|path| std::fs::read(path).ok())
+        .and_then(|png| decode(&png, 192))
+    {
+        return render_image(image);
+    }
+    let png = Client::new(None).download_image(url).ok()?;
+    let image = decode(&png, 192)?;
+    if let Some(path) = path {
+        let mut small = Cursor::new(Vec::new());
+        if image.write_to(&mut small, image::ImageFormat::Png).is_ok() {
+            let _ = crate::launcher::cache::write(&path, &small.into_inner());
+        }
+    }
+    render_image(image)
+}
+
+fn decode(bytes: &[u8], size: u32) -> Option<image::DynamicImage> {
+    if bytes.len() > 6 * 1024 * 1024 {
+        return None;
+    }
+    let mut reader = image::ImageReader::with_format(Cursor::new(bytes), image::ImageFormat::Png);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(3072);
+    limits.max_image_height = Some(3072);
+    limits.max_alloc = Some(48 * 1024 * 1024);
+    reader.limits(limits);
+    let decoded = reader.decode().ok()?;
+    Some(if decoded.width() > size || decoded.height() > size {
+        decoded.thumbnail(size, size)
+    } else {
+        decoded
+    })
+}
+
+fn render_image(image: image::DynamicImage) -> Option<Arc<RenderImage>> {
+    let rgba = image.into_rgba8();
+    let (width, height) = rgba.dimensions();
+    crate::render_image::to_render_image(rgba.into_raw(), width, height)
+}
