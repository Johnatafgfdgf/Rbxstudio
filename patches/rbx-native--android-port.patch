@@ -0,0 +1,92 @@
+//! Pick the visible projection of a rotation ring, including edge-on views.
+use glam::Vec2;
+
+#[derive(Clone, Copy)]
+pub(super) struct RingHit {
+    pub(super) distance: f32,
+    pub(super) depth: f32,
+    pub(super) angle: f32,
+    pub(super) tangent: Vec2,
+    pub(super) radians_per_pixel: f32,
+}
+
+impl RingHit {
+    pub(super) fn nearer_than(self, other: Self) -> bool {
+        if (self.distance - other.distance).abs() < 1. {
+            self.depth < other.depth
+        } else {
+            self.distance < other.distance
+        }
+    }
+}
+
+pub(super) fn hit_ring(
+    touch: Vec2,
+    radius: f32,
+    project: impl Fn(f32) -> Option<(Vec2, f32)>,
+) -> Option<RingHit> {
+    const SEGMENTS: usize = 48;
+    const STEP: f32 = std::f32::consts::TAU / SEGMENTS as f32;
+    let mut best = None;
+    let mut previous = project(0.);
+    for segment in 1..=SEGMENTS {
+        let angle = segment as f32 * STEP;
+        let current = project(angle);
+        let pair = previous.zip(current);
+        previous = current;
+        let Some(((a, near), (b, far))) = pair else {
+            continue;
+        };
+        let chord = b - a;
+        let length = chord.length();
+        if length < 0.25 {
+            continue;
+        }
+        let tangent = chord / length;
+        let along = ((touch - a).dot(tangent) / length).clamp(0., 1.);
+        let distance = (touch - (a + along * chord)).length();
+        if distance > radius {
+            continue;
+        }
+        let hit = RingHit {
+            distance,
+            depth: near + along * (far - near),
+            angle: angle - (1. - along) * STEP,
+            tangent,
+            radians_per_pixel: STEP / length.max(STEP * 36.),
+        };
+        if best.is_none_or(|old| hit.nearer_than(old)) {
+            best = Some(hit);
+        }
+    }
+    best
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_tap_in_the_touch_band_finds_the_projected_ring() {
+        let project = |a: f32| Some((Vec2::new(a.cos(), a.sin()) * 65., 0.5));
+        let hit = hit_ring(Vec2::new(74., 0.), 12., project).unwrap();
+        assert!(hit.distance < 10.);
+        assert!(hit.tangent.y.abs() > 0.95);
+        assert!(hit.angle.sin().abs() < 0.01);
+        assert!(hit_ring(Vec2::new(90., 0.), 12., project).is_none());
+    }
+
+    #[test]
+    fn an_edge_on_ring_still_has_a_finite_drag_tangent() {
+        let project = |a: f32| Some((Vec2::new(a.cos() * 65., 0.), (a.sin() + 1.) / 2.));
+        let hit = hit_ring(Vec2::new(20., 5.), 12., project).unwrap();
+        assert!(hit.depth < 0.1);
+        assert!(hit.tangent.x.abs() > 0.95);
+        assert!((0.0..=1. / 36.).contains(&hit.radians_per_pixel));
+    }
+
+    #[test]
+    fn behind_camera_segments_cannot_be_picked() {
+        assert!(hit_ring(Vec2::ZERO, 12., |_| None).is_none());
+    }
+}
