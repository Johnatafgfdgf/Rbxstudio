+            .min_h_0()
+            .flex_1()
+            .overflow_y_scroll()
+            .gap(px(6.))
+            .px(px(12.))
+            .py(px(4.));
+        if let Some(script) = review.selected.and_then(|index| scripts.get(index)) {
+            body = body
+                .child(
+                    ui::button(
+                        "toolbox-review-list",
+                        "Voltar aos scripts",
+                        Weight::Secondary,
+                        false,
+                    )
+                    .min_h(px(40.))
+                    .on_click(cx.listener(|shell, _, _, cx| {
+                        if let Some(review) = &mut shell.toolbox_review {
+                            review.page = review.selected.take().unwrap_or(0) / SCRIPTS_PER_PAGE;
+                        }
+                        cx.notify();
+                    })),
+                )
+                .child(div().child(script.path.clone()))
+                .children(script.risks.iter().map(|(risk, line)| {
+                    div()
+                        .text_color(tokens::text2())
+                        .child(format!("Linha {line} · {}", risk.description()))
+                }));
+            if let Some(source) = model_review::script_source(&review.content, script.instance) {
+                let offset = review.page.saturating_mul(SOURCE_PAGE_BYTES);
+                let start = source.floor_char_boundary(offset.min(source.len()));
+                let end = source.floor_char_boundary(
+                    offset.saturating_add(SOURCE_PAGE_BYTES).min(source.len()),
+                );
+                body = body
+                    .child(review_pages(
+                        "toolbox-source",
+                        review.page,
+                        start > 0,
+                        end < source.len(),
+                        cx,
+                    ))
+                    .child(
+                        div()
+                            .text_color(tokens::text2())
+                            .child(format!("Bytes {start}–{end} de {}", source.len())),
+                    )
+                    .child(
+                        div()
+                            .id("toolbox-code-lines")
+                            .w_full()
+                            .overflow_x_scroll()
+                            .p(px(8.))
+                            .bg(ui::panel2())
+                            .font_family(tokens::font_mono())
+                            .child(
+                                div()
+                                    .whitespace_nowrap()
+                                    .child(source[start..end].to_owned()),
+                            ),
+                    );
+            } else {
+                body = body.child(
+                    div().child("O modelo não trouxe código-fonte legível para este script."),
+                );
+            }
+        } else {
+            let start = review.page * SCRIPTS_PER_PAGE;
+            let end = (start + SCRIPTS_PER_PAGE).min(scripts.len());
+            body = body.child(div().text_color(tokens::text2()).child(if scripts.is_empty() {
+                "Nenhum Script, LocalScript ou ModuleScript encontrado."
+            } else {
+                "Os alertas são indícios. A análise estática não garante a segurança do modelo."
+            }))
+            .children((scripts.len() > SCRIPTS_PER_PAGE).then(|| {
+                review_pages("toolbox-script-page", review.page, start > 0, end < scripts.len(), cx)
+            }))
+            .children(scripts[start..end].iter().enumerate().map(|(index, script)| {
+                let index = start + index;
+                let coverage = match script.coverage {
+                    Coverage::MissingSource => "Fonte indisponível",
+                    Coverage::Partial => "Análise parcial",
+                    Coverage::Scanned if script.risks.is_empty() => "Sem indícios encontrados",
+                    Coverage::Scanned => "Requer revisão",
+                };
+                div().id(("toolbox-review-script", index))
+                    .p(px(8.)).min_h(px(44.)).cursor_pointer().rounded(px(5.)).bg(ui::panel2())
+                    .child(div().text_color(ui::accent()).child(script.path.clone()))
+                    .child(div().text_color(tokens::text2()).child(format!(
+                        "{} · {} · {} alerta(s)", script.class, coverage, script.risks.len(),
+                    )))
+                    .on_click(cx.listener(move |shell, _, _, cx| {
+                        if let Some(review) = &mut shell.toolbox_review {
+                            review.selected = Some(index);
+                            review.page = 0;
+                        }
+                        cx.notify();
+                    }))
+            }));
+        }
+        let footer = h_flex()
+            .flex_wrap()
+            .gap(px(6.))
+            .justify_end()
+            .child(action(
+                "toolbox-import-cancel",
+                "Cancelar",
+                Weight::Ghost,
+                ImportChoice::Cancel,
+                cx,
+            ))
+            .children((!scripts.is_empty()).then(|| {
+                action(
+                    "toolbox-import-no-code",
+                    "Inserir sem scripts",
+                    Weight::Secondary,
+                    ImportChoice::WithoutScripts,
+                    cx,
+                )
+            }))
+            .child(action(
+                "toolbox-import-accept",
+                if scripts.is_empty() {
+                    "Inserir"
+                } else {
+                    "Inserir com scripts"
+                },
+                if scripts.is_empty() {
+                    Weight::Primary
+                } else {
+                    Weight::Secondary
+                },
+                ImportChoice::WithScripts,
+                cx,
+            ));
+        Some(
+            div()
+                .id("toolbox-review")
+                .absolute()
+                .inset_0()
+                .bg(tokens::veil())
+                .occlude()
+                .flex()
+                .items_center()
+                .justify_center()
+                .child(
+                    v_flex()
+                        .w(px((width - 20.).min(620.)))
+                        .h(px((height - 24.).min(520.)))
+                        .rounded(px(10.))
+                        .border_1()
+                        .border_color(tokens::border())
+                        .overflow_hidden()
+                        .bg(ui::panel())
+                        .text_color(tokens::text())
+                        .text_size(px(13.))
+                        .child(
+                            v_flex()
+                                .px(px(12.))
+                                .py(px(8.))
+                                .child(div().font_weight(tokens::WEIGHT_BOLD).child(format!(
+                                    "Revisar importação · {} script(s)",
+                                    scripts.len()
+                                )))
+                                .child(
+                                    div()
+                                        .line_clamp(2)
+                                        .text_color(tokens::text2())
+                                        .child(review.label.clone()),
+                                ),
+                        )
+                        .child(body)
+                        .child(div().p(px(8.)).bg(ui::panel2()).child(footer)),
+                )
+                .into_any_element(),
+        )
+    }
+}
+
+fn review_pages(
+    id: &'static str,
+    page: usize,
+    back: bool,
+    next: bool,
+    cx: &mut Context<Shell>,
+) -> Div {
+    h_flex().gap(px(6.)).children(
+        [
+            (back, "Anterior", page.saturating_sub(1)),
+            (next, "Próxima", page + 1),
+        ]
+        .into_iter()
+        .filter(|(visible, _, _)| *visible)
+        .map(|(_, label, page)| {
+            ui::button((id, page), label, Weight::Secondary, false)
+                .min_h(px(40.))
+                .on_click(cx.listener(move |shell, _, _, cx| {
+                    if let Some(review) = &mut shell.toolbox_review {
+                        review.page = page;
+                    }
+                    cx.notify();
+                }))
+        }),
+    )
+}
