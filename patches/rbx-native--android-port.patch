+impl HomeWindow {
+    /// Android-native launcher's toolbar. The actions use the same handlers
+    /// as the original sidebar, so creating/opening a place stays functional.
+    fn mobile_home_header(
+        &self, crumb: &'static str, compact: bool, cx: &mut Context<Self>,
+    ) -> impl IntoElement {
+        let heading = match crumb {
+            "Home" => "Início",
+            "Recent" => "Recentes",
+            "My Games" => "Meus jogos",
+            other => other,
+        };
+        h_flex()
+            .id("mobile-home-header")
+            .h(px(56.))
+            .flex_none()
+            .items_center()
+            .gap(px(8.))
+            .px(px(12.))
+            .bg(style::background())
+            .child(crate::shell::chrome::logo(20.).text_color(style::accent()))
+            .when(!compact, |header| header.child(
+                ui::text(16., 23.).font_weight(FontWeight::BOLD).child("Rbx Studio"),
+            ).child(div().h(px(24.)).w(px(1.)).bg(style::border())))
+            .child(
+                ui::text(15., 23.)
+                    .font_weight(FontWeight::SEMIBOLD)
+                    .text_color(style::text())
+                    .child(heading),
+            )
+            .child(div().flex_1())
+            .child(
+                self.mobile_header_button("mobile-home-notifications", "Notificações")
+                    .child(ui::icon("bell", 19.))
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.dialog = Some(Dialog::Notifications);
+                        cx.notify();
+                    })),
+            )
+            .child(
+                self.mobile_header_button("mobile-home-account", "Conta Roblox")
+                    .child(self.mobile_avatar(30.))
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.dialog = Some(Dialog::Account);
+                        cx.notify();
+                    })),
+            )
+    }
+
+    fn mobile_header_button(&self, id: &'static str, label: &'static str) -> Stateful<Div> {
+        h_flex()
+            .id(id)
+            .size(px(48.))
+            .flex_none()
+            .items_center()
+            .justify_center()
+            .map(style::control)
+            .cursor_pointer()
+            .role(Role::Button)
+            .aria_label(label)
+    }
+
+    fn mobile_avatar(&self, size: f32) -> Div {
+        h_flex()
+            .size(px(size))
+            .flex_none()
+            .rounded_full()
+            .overflow_hidden()
+            .bg(tokens::avatar())
+            .items_center()
+            .justify_center()
+            .map(|frame| match &self.account_headshot {
+                Some(image) => frame.child(img(image.clone()).size_full().object_fit(ObjectFit::Cover)),
+                None => frame.child(ui::icon("user", size * 0.54).text_color(style::muted())),
+            })
+
+    }
+
+    /// One row of thumb-friendly navigation, present on all launcher pages.
+    /// It replaces the left desktop navigation while keeping every route.
+    fn mobile_home_nav(&self, compact: bool, cx: &mut Context<Self>) -> impl IntoElement {
+        let item = |id: &'static str,
+                    glyph: &'static str,
+                    title: &'static str,
+                    page: Page,
+                    cx: &mut Context<Self>| {
+            let active = self.page == page;
+            h_flex()
+                .id(id)
+                .flex_1()
+                .h(px(48.))
+                .min_w(px(48.))
+                .items_center()
+                .justify_center()
+                .gap(px(8.))
+                .rounded(px(style::CONTROL_RADIUS))
+                .border_1()
+                .border_color(transparent_black())
+                .cursor_pointer()
+                .role(Role::Button).aria_label(title).aria_selected(active)
+                .text_color(style::muted())
+                .when(active, style::selected)
+                .child(ui::icon(glyph, 17.))
+                .when(!compact, |item| item.child(title))
+                .on_click(cx.listener(move |this, _, _, cx| {
+                    this.page = page;
+                    cx.notify();
+                }))
+        };
+        h_flex()
+            .id("mobile-home-bottom-navigation")
+            .h(px(56.))
+            .flex_none()
+            .items_center()
+            .gap(px(8.))
+            .px(px(8.))
+            .my(px(6.))
+            .mx(px(14.))
+            .map(style::surface)
+            .child(item("mobile-home-nav", "house", "Início", Page::Home, cx))
+            .child(item("mobile-recent-nav", "clock", "Recentes", Page::Recent, cx))
+            .child(item("mobile-games-nav", "gamepad-2", "Meus jogos", Page::MyGames, cx))
+            .child(
+                h_flex()
+                    .id("mobile-account-nav")
+                    .flex_1()
+                    .h(px(48.))
+                    .min_w(px(48.))
+                    .items_center()
+                    .justify_center()
+                    .gap(px(8.))
+                    .rounded(px(style::CONTROL_RADIUS))
+                    .cursor_pointer()
+                    .role(Role::Button).aria_label("Configurações de chave")
+                    .text_color(style::muted())
+                    .child(ui::icon("key-round", 17.))
+                    .when(!compact, |item| item.child("Configurações de chave"))
+                    .on_click(cx.listener(|this, _, window, cx| {
+                        if this.has_key() { this.manage_key(cx); }
+                        else { this.set_up_key(window, cx); }
+                    })),
+            )
+    }
