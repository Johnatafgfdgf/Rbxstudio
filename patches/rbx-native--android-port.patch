@@ -0,0 +1,19 @@
+//! Installed by the Android host; the original editor snapshots its current
+//! document and observes the local player's lifecycle without publishing it.
+use std::sync::OnceLock;
+
+pub enum Phase { Starting, Running, Stopped, Failed(String) }
+pub struct Update { pub phase: Phase, pub output: Vec<String> }
+pub trait Host: Send + Sync {
+    fn start(&self, place: Vec<u8>, title: String, accent: u32) -> Result<u64, String>;
+    fn poll(&self, session: u64) -> Update;
+    fn stop(&self, session: u64);
+    fn diagnostics(&self) -> Result<String, String> {
+        Err("Diagnóstico não disponível neste host".into())
+    }
+}
+static HOST: OnceLock<Box<dyn Host>> = OnceLock::new();
+pub fn install(host: Box<dyn Host>) -> Result<(), Box<dyn Host>> { HOST.set(host) }
+pub(crate) fn host() -> Result<&'static dyn Host, String> {
+    HOST.get().map(Box::as_ref).ok_or_else(|| "O player Android não foi inicializado".to_owned())
+}
