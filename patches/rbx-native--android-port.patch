diff --git a/crates/rbx_studio/src/workspace_view/android_input.rs b/crates/rbx_studio/src/workspace_view/android_input.rs
new file mode 100644
index 0000000..db7d022
--- /dev/null
+++ b/crates/rbx_studio/src/workspace_view/android_input.rs
@@ -0,0 +1,442 @@
+//! Android gestures use the same camera, picking and gizmo actions as the
+//! desktop viewport. Only the gesture's starting panel claims it.
+use super::*;
+use crate::transform::Tool;
+use glam::Vec2;
+use rbx_viewer::gizmo::{self, Axis};
+
+pub(super) enum TouchMode {
+    Tap(Point<Pixels>),
+    Look(Point<Pixels>),
+    Pan,
+    Tool(Point<Pixels>),
+}
+
+pub(super) struct ScreenTurn {
+    start: Vec2,
+    tangent: Vec2,
+    radians_per_pixel: f32,
+}
+
+impl ScreenTurn {
+    pub(super) fn at(&self, position: Point<Pixels>) -> f32 {
+        (touch_point(position) - self.start).dot(self.tangent) * self.radians_per_pixel
+    }
+}
+
+fn touch_point(position: Point<Pixels>) -> Vec2 {
+    Vec2::new(position.x.into(), position.y.into())
+}
+
+pub(super) struct Stick {
+    offset: glam::Vec2,
+    contact: Point<Pixels>,
+    look: Option<Point<Pixels>>,
+}
+
+impl WorkspaceView {
+    pub(super) fn android_touch_drag(
+        &mut self,
+        event: &TouchDragEvent,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let modifiers = Modifiers::default();
+        let scale = window.scale_factor();
+        if event.phase == TouchPhase::Started {
+            self.cancel_android_interaction(cx);
+            self.note_input();
+            window.focus(&self.focus, cx);
+            let plugin = self.plugin_press(event.position, scale, cx)
+                || self.plugin_mouse_press(1, event.position, scale, cx);
+            self.android_touch = Some(
+                if plugin || self.android_rotate_start(event.position, scale, cx) {
+                    TouchMode::Tool(Point::default())
+                } else if let Some(grab) = self.android_handle_point(event.position, scale) {
+                    self.press(grab, modifiers, scale, cx);
+                    TouchMode::Tool(grab - event.position)
+                } else {
+                    TouchMode::Tap(event.position)
+                },
+            );
+            return true;
+        }
+        let Some(mode) = self.android_touch.take() else {
+            return false;
+        };
+        match (event.phase, mode) {
+            (TouchPhase::Moved, TouchMode::Tap(start)) => {
+                if (event.position - start).magnitude() > 6.0 {
+                    self.touch_look(event.position - start);
+                    self.android_touch = Some(TouchMode::Look(event.position));
+                    eprintln!("RBX_ANDROID_TOUCH_LOOK");
+                } else {
+                    self.android_touch = Some(TouchMode::Tap(start));
+                }
+            }
+            (TouchPhase::Moved, TouchMode::Look(previous)) => {
+                self.touch_look(event.position - previous);
+                self.android_touch = Some(TouchMode::Look(event.position));
+            }
+            (TouchPhase::Moved, TouchMode::Tool(offset)) => {
+                self.note_input();
+                if !self.plugin_move(event.position, scale, cx) {
+                    if self.dragging() {
+                        self.drag_pending = Some((event.position + offset, modifiers));
+                    } else {
+                        self.plugin_mouse_move(event.position, scale, cx);
+                    }
+                }
+                self.android_touch = Some(TouchMode::Tool(offset));
+            }
+            (TouchPhase::Ended, TouchMode::Tap(start)) => {
+                if (event.position - start).magnitude() <= 6.0 {
+                    self.press(start, modifiers, scale, cx);
+                    self.finish_drag(window, cx, false);
+                } else {
+                    self.touch_look(event.position - start);
+                    eprintln!("RBX_ANDROID_TOUCH_LOOK");
+                }
+            }
+            (TouchPhase::Ended, TouchMode::Look(previous)) => {
+                self.touch_look(event.position - previous);
+            }
+            (TouchPhase::Ended, TouchMode::Tool(offset)) => {
+                if !self.plugin_release(cx) {
+                    self.plugin_mouse_release(1, event.position, scale, cx);
+                }
+                self.drag_pending = self
+                    .dragging()
+                    .then_some((event.position + offset, modifiers));
+                self.finish_drag(window, cx, false);
+                self.android_turn = None;
+            }
+            (TouchPhase::Cancelled, TouchMode::Tool(_)) => {
+                if !self.plugin_release(cx) {
+                    self.plugin_mouse_release(1, event.position, scale, cx);
+                }
+                self.android_turn = None;
+                self.cancel_drag(cx);
+            }
+            (TouchPhase::Cancelled, TouchMode::Tap(_) | TouchMode::Look(_)) => {
+                self.android_pinch_origin = Some(event.position);
+            }
+            _ => {}
+        }
+        true
+    }
+
+    fn android_handle_point(&self, position: Point<Pixels>, scale: f32) -> Option<Point<Pixels>> {
+        if self.android_manipulator_at(position, scale) {
+            return Some(position);
+        }
+        if !matches!(
+            self.transform.tool,
+            Tool::Move | Tool::Scale | Tool::Transform | Tool::Pivot
+        ) {
+            return None;
+        }
+        // Keep the initial offset while dragging so the object does not
+        // jump from the visible handle to the finger.
+        for reach in [6., 12.] {
+            for n in 0..8 {
+                let angle = n as f32 * std::f32::consts::FRAC_PI_4;
+                let candidate = position + point(px(angle.cos() * reach), px(angle.sin() * reach));
+                if self.in_android_viewport(candidate, scale)
+                    && self.android_manipulator_at(candidate, scale)
+                {
+                    return Some(candidate);
+                }
+            }
+        }
+        None
+    }
+
+    fn android_rotate_start(
+        &mut self,
+        position: Point<Pixels>,
+        scale: f32,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        if self.ref_picking || self.transform.tool != Tool::Rotate {
+            return false;
+        }
+        let (Some(handles), Some(anchor), Some(pose), Some(ray)) = (
+            self.handles(),
+            self.targets.anchor(),
+            self.view,
+            self.cursor_ray(position, scale),
+        ) else {
+            return false;
+        };
+        let viewport = self.viewport.get();
+        let extent = Vec2::new(viewport.size.0 as f32, viewport.size.1 as f32);
+        let origin_px = Vec2::new(viewport.origin.0 as f32, viewport.origin.1 as f32);
+        let projection = pose.view_projection(self.orthographic, extent.x / extent.y);
+        let project = |world: Vec3| {
+            let clip = projection * world.extend(1.);
+            if !clip.is_finite() || clip.w <= 0. {
+                return None;
+            }
+            let ndc = clip.truncate() / clip.w;
+            let pixels = Vec2::new(ndc.x + 1., 1. - ndc.y) * extent * 0.5;
+            (0.0..=1.0)
+                .contains(&ndc.z)
+                .then_some(((pixels + origin_px) / scale, ndc.z))
+        };
+        let origin = handles.origin();
+        let radius = handles.ring_radius();
+        let mut best = None;
+        for axis in Axis::ALL {
+            let frame = handles.ring_frame(axis);
+            let hit = super::touch_geometry::hit_ring(touch_point(position), 13., |angle| {
+                project(origin + (frame.1 * angle.cos() + frame.2 * angle.sin()) * radius)
+            });
+            if let Some(hit) = hit.filter(|hit| best.is_none_or(|(_, old)| hit.nearer_than(old))) {
+                best = Some((frame, hit));
+            }
+        }
+        let Some((frame, hit)) = best else {
+            return false;
+        };
+        let plane = (ray.direction.dot(frame.0).abs() >= 0.23)
+            .then(|| gizmo::ring_crossing(origin, frame, ray))
+            .flatten();
+        self.close_measure();
+        self.begin(
+            Drag::Ring {
+                origin,
+                frame,
+                orientation: anchor.orientation(),
+                last: plane.map_or(hit.angle, |(angle, _, _)| angle),
+                turned: 0.,
+            },
+            cx,
+        );
+        self.android_turn = plane.is_none().then_some(ScreenTurn {
+            start: touch_point(position),
+            tangent: hit.tangent,
+            radians_per_pixel: hit.radians_per_pixel,
+        });
+        cx.notify();
+        true
+    }
+
+    fn in_android_viewport(&self, position: Point<Pixels>, scale: f32) -> bool {
+        let bounds = self.viewport.get();
+        let pixel = touch_point(position) * scale
+            - Vec2::new(bounds.origin.0 as f32, bounds.origin.1 as f32);
+        pixel.x >= 0.
+            && pixel.y >= 0.
+            && pixel.x < bounds.size.0 as f32
+            && pixel.y < bounds.size.1 as f32
+    }
+
+    pub(crate) fn cancel_for_selection(&mut self, targets: &Targets, cx: &mut Context<Self>) {
+        if !self
+            .targets
+            .iter()
+            .map(|target| target.referent)
+            .eq(targets.iter().map(|target| target.referent))
+        {
+            self.cancel_android_interaction(cx);
+        }
+    }
+
+    pub(crate) fn cancel_android_interaction(&mut self, cx: &mut Context<Self>) -> bool {
+        let touch = self.android_touch.take();
+        let had_interaction = touch.is_some() || self.android_stick.is_some() || self.dragging();
+        self.android_turn = None;
+        self.android_pinch_origin = None;
+        self.android_pinch_previous = None;
+        if matches!(touch, Some(TouchMode::Tool(_))) {
+            self.plugin_release(cx);
+        }
+        self.release_android_flight();
+        self.cancel_drag(cx);
+        had_interaction
+    }
+
+    pub(crate) fn focus_android_selection(&mut self, cx: &mut Context<Self>) {
+        let (Some(bounds), Some(pose)) = (self.targets.scale_box(false), self.pose()) else {
+            return;
+        };
+        self.cancel_android_interaction(cx);
+        let target = bounds.w_axis.truncate();
+        let radius = 0.5
+            * (bounds.x_axis.length_squared()
+                + bounds.y_axis.length_squared()
+                + bounds.z_axis.length_squared())
+            .sqrt();
+        let (width, height) = self.viewport.get().size;
+        let aspect = width as f32 / height.max(1) as f32;
+        let half_fov = (pose.fov_degrees * 0.5).to_radians().tan() * aspect.clamp(0.1, 1.);
+        let distance = (radius * 1.35 / half_fov).max(4.);
+        let eye = target - pose.basis().0 * distance;
+        self.look_at(eye.to_array(), target.to_array());
+    }
+
+    /// A finger pan synthesized by GPUI remains an orbit over the scene.
+    /// The surrounding panes retain their usual finger scrolling.
+    pub(super) fn android_touch_pan(&mut self, event: &ScrollWheelEvent) -> bool {
+        match event.touch_phase {
+            TouchPhase::Started => {
+                self.android_touch = Some(TouchMode::Pan);
+                eprintln!("RBX_ANDROID_TOUCH_LOOK");
+            }
+            _ if !matches!(self.android_touch, Some(TouchMode::Pan)) => return false,
+            TouchPhase::Ended | TouchPhase::Cancelled => self.android_touch = None,
+            _ => {}
+        }
+        if event.touch_phase != TouchPhase::Cancelled {
+            self.touch_look(event.delta.pixel_delta(px(1.)));
+        }
+        true
+    }
+
+    fn touch_look(&mut self, delta: Point<Pixels>) {
+        self.note_input();
+        self.pump.input(CameraInput::TouchLook {
+            dx: f32::from(delta.x),
+            dy: f32::from(delta.y),
+        });
+    }
+
+    pub(super) fn android_pinch(&mut self, event: &PinchEvent, scale: f32) {
+        if let Some(stick) = &mut self.android_stick {
+            // Android supplies the midpoint. With the first contact still
+            // captured by the stick, the second contact turns the camera.
+            let other = event.position + (event.position - stick.contact);
+            match event.phase {
+                TouchPhase::Started => {
+                    let bounds = self.panel.get();
+                    let (x, y) = (f32::from(other.x) * scale, f32::from(other.y) * scale);
+                    let (left, top) = (bounds.origin.0 as f32, bounds.origin.1 as f32);
+                    if x >= left
+                        && y >= top
+                        && x < left + bounds.size.0 as f32
+                        && y < top + bounds.size.1 as f32
+                    {
+                        stick.look = Some(other);
+                    }
+                }
+                TouchPhase::Moved if stick.look.is_some() => {
+                    if let Some(previous) = stick.look.replace(other) {
+                        self.touch_look(other - previous);
+                    }
+                }
+                TouchPhase::Ended | TouchPhase::Cancelled => stick.look = None,
+                _ => {}
+            }
+        } else {
+            match event.phase {
+                TouchPhase::Started => {
+                    self.android_pinch_previous = self
+                        .android_pinch_origin
+                        .take()
+                        .filter(|first| {
+                            self.in_android_viewport(event.position * 2. - *first, scale)
+                        })
+                        .map(|_| event.position);
+                }
+                TouchPhase::Moved if event.delta.is_finite() => {
+                    if let Some(previous) = self.android_pinch_previous {
+                        self.android_pinch_previous = Some(event.position);
+                        let delta = touch_point(event.position - previous).clamp_length_max(40.);
+                        self.note_input();
+                        self.pump.input(CameraInput::TouchPan {
+                            dx: delta.x,
+                            dy: delta.y,
+                        });
+                        self.pump.input(CameraInput::Wheel {
+                            notches: (event.delta * 4.0).clamp(-1.0, 1.0),
+                        });
+                    }
+                }
+                TouchPhase::Ended | TouchPhase::Cancelled => self.android_pinch_previous = None,
+                _ => {}
+            }
+        }
+    }
+
+    pub(super) fn release_android_flight(&mut self) {
+        if self.android_stick.take().is_some() {
+            gpui_mobile::android::preserve_primary_touch(false);
+            self.pump.input(CameraInput::TouchMove { x: 0.0, y: 0.0 });
+        }
+    }
+
+    pub(crate) fn android_stick_enabled(&self) -> bool {
+        self.android_stick_enabled
+    }
+
+    pub(crate) fn toggle_android_stick(&mut self, cx: &mut Context<Self>) {
+        self.cancel_android_interaction(cx);
+        self.android_stick_enabled = !self.android_stick_enabled;
+        cx.notify();
+    }
+
+    pub(super) fn android_flight_controls(&self, cx: &Context<Self>) -> impl IntoElement {
+        const DIAMETER: f32 = 72.0;
+        const RADIUS: f32 = 23.0;
+        const THUMB: f32 = 28.0;
+        let thumb = self
+            .android_stick
+            .as_ref()
+            .map_or(glam::Vec2::ZERO, |s| s.offset)
+            * RADIUS;
+        let centre = (DIAMETER - THUMB) * 0.5;
+        div()
+            .absolute()
+            .bottom(px(12.))
+            .left(px(12.))
+            .size(px(DIAMETER))
+            .rounded_full()
+            .border_1()
+            .border_color(tokens::text().opacity(0.40))
+            .bg(tokens::viewport_badge().opacity(0.65))
+            .child(
+                div()
+                    .absolute()
+                    .left(px(centre + thumb.x))
+                    .top(px(centre + thumb.y))
+                    .size(px(THUMB))
+                    .rounded_full()
+                    .bg(tokens::text().opacity(0.78)),
+            )
+            .on_touch_drag(cx.listener(|view, event: &TouchDragEvent, window, cx| {
+                match event.phase {
+                    TouchPhase::Started => {
+                        window.focus(&view.focus, cx);
+                        view.android_stick = Some(Stick {
+                            offset: glam::Vec2::ZERO,
+                            contact: event.position,
+                            look: None,
+                        });
+                        gpui_mobile::android::preserve_primary_touch(true);
+                        view.note_input();
+                    }
+                    TouchPhase::Moved => {
+                        let Some(stick) = &mut view.android_stick else {
+                            return;
+                        };
+                        let delta = event.position - event.start_position;
+                        let offset = glam::Vec2::new(delta.x.into(), delta.y.into()) / RADIUS;
+                        stick.offset = offset.clamp_length_max(1.0);
+                        stick.contact = event.position;
+                        let length = stick.offset.length();
+                        let force =
+                            stick.offset.normalize_or_zero() * ((length - 0.08) / 0.92).max(0.0);
+                        view.pump.input(CameraInput::TouchMove {
+                            x: force.x,
+                            y: -force.y,
+                        });
+                    }
+                    TouchPhase::Ended | TouchPhase::Cancelled => view.release_android_flight(),
+                }
+                cx.notify();
+                window.prevent_default();
+                cx.stop_propagation();
+            }))
+    }
+}
