index 0000000..53c010b
--- /dev/null
+++ b/src/android/ime.rs
@@ -0,0 +1,447 @@
+//! NativeActivity's key queue does not carry Android IME text transactions.
+//! Keep the GPUI input handler on its native thread and route the Activity's
+//! InputConnection requests through the same foreground queue as other UI work.
+
+use std::{
+    cell::RefCell,
+    ops::Range,
+    rc::{Rc, Weak},
+    sync::{
+        atomic::{AtomicI64, Ordering},
+        mpsc,
+    },
+    time::Duration,
+};
+
+use gpui::PlatformInputHandler;
+use jni::{
+    errors::LogErrorAndDefault,
+    objects::{JIntArray, JObject, JString, JValue},
+    sys::{jboolean, jint, jlong, jobject},
+    EnvUnowned,
+};
+
+use super::{jni as host, AndroidKeyEvent};
+use host::JniExt;
+
+type Handler = RefCell<Option<PlatformInputHandler>>;
+
+struct Session {
+    id: i64,
+    window: u64,
+    handler: Weak<Handler>,
+    dirty: bool,
+    selection: Option<[i32; 4]>,
+}
+
+thread_local! {
+    static SESSION: RefCell<Option<Session>> = const { RefCell::new(None) };
+}
+static NEXT_SESSION: AtomicI64 = AtomicI64::new(1);
+
+pub(super) fn focus(window: u64, handler: &Rc<Handler>, multiline: bool) {
+    let id = NEXT_SESSION.fetch_add(1, Ordering::Relaxed);
+    SESSION.with(|slot| {
+        *slot.borrow_mut() = Some(Session {
+            id,
+            window,
+            handler: Rc::downgrade(handler),
+            dirty: true,
+            selection: None,
+        });
+    });
+    set_connection(id, true, multiline);
+}
+
+pub(super) fn reopen(window: u64, multiline: bool) {
+    if let Some(id) = session_for_window(window) {
+        set_connection(id, true, multiline);
+    }
+}
+
+pub(super) fn blur(window: u64) {
+    if let Some(id) = session_for_window(window) {
+        SESSION.with(|slot| slot.borrow_mut().take());
+        set_connection(id, false, false);
+    }
+}
+
+pub(super) fn invalidate_selection(window: u64) {
+    SESSION.with(|slot| {
+        if let Some(session) = slot.borrow_mut().as_mut().filter(|s| s.window == window) {
+            session.dirty = true;
+        }
+    });
+}
+
+fn session_for_window(window: u64) -> Option<i64> {
+    SESSION.with(|slot| {
+        slot.borrow()
+            .as_ref()
+            .filter(|s| s.window == window)
+            .map(|s| s.id)
+    })
+}
+
+fn with_handler<T>(id: i64, f: impl FnOnce(&mut PlatformInputHandler) -> T) -> Option<T> {
+    let (window, handler) = SESSION.with(|slot| {
+        let slot = slot.borrow();
+        let session = slot.as_ref().filter(|s| s.id == id)?;
+        Some((session.window, session.handler.upgrade()?))
+    })?;
+    if host::platform()?.primary_window()?.id() != window {
+        return None;
+    }
+
+    let mut input = handler.borrow_mut().take()?;
+    let result = input.query_accepts_text_input().then(|| f(&mut input));
+    let mut slot = handler.borrow_mut();
+    if slot.is_none() {
+        *slot = Some(input);
+    }
+    result
+}
+
+fn set_connection(id: i64, show: bool, multiline: bool) {
+    let result = host::with_env(|env| {
+        let activity = host::activity(env)?;
+        env.call_method(
+            &activity,
+            jni::jni_str!("setEditorIme"),
+            jni::jni_sig!("(JZZ)V"),
+            &[
+                JValue::Long(id),
+                JValue::Bool(show),
+                JValue::Bool(multiline),
+            ],
+        )
+        .e()?;
+        Ok(())
+    });
+    if let Err(error) = result {
+        log::warn!("Could not change the Android editor input connection: {error}");
+    }
+}
+
+/// Call after GPUI has finished drawing, when its window can be borrowed again.
+pub(super) fn sync_selection(window: u64) {
+    let id = SESSION.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let session = slot.as_mut().filter(|s| s.window == window && s.dirty)?;
+        session.dirty = false;
+        Some(session.id)
+    });
+    let Some(id) = id else {
+        return;
+    };
+    let Some(Some(selection)) = with_handler(id, |input| {
+        let selection = input.selected_text_range(false)?.range;
+        let (start, end) = input
+            .marked_text_range()
+            .map_or((-1, -1), |mark| (mark.start as i32, mark.end as i32));
+        Some([selection.start as i32, selection.end as i32, start, end])
+    }) else {
+        return;
+    };
+
+    let changed = SESSION.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(session) = slot.as_mut().filter(|s| s.id == id) else {
+            return false;
+        };
+        session.selection.replace(selection) != Some(selection)
+    });
+    if changed {
+        let [start, end, marked_start, marked_end] = selection;
+        let _ = host::with_env(|env| {
+            let activity = host::activity(env)?;
+            env.call_method(
+                &activity,
+                jni::jni_str!("updateEditorImeSelection"),
+                jni::jni_sig!("(JIIII)V"),
+                &[
+                    JValue::Long(id),
+                    JValue::Int(start),
+                    JValue::Int(end),
+                    JValue::Int(marked_start),
+                    JValue::Int(marked_end),
+                ],
+            )
+            .e()?;
+            Ok(())
+        });
+    }
+}
+
+fn enqueue(f: impl FnOnce() + Send + 'static) -> bool {
+    let Some(platform) = host::platform() else {
+        return false;
+    };
+    platform.foreground_executor().dispatch_on_main_thread(f);
+    true
+}
+
+
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_gpui_mobile_GpuiActivity_nativeEditorImeBounds(
+    _env: EnvUnowned<'_>,
+    _class: JObject<'_>,
+    visible_bottom: jint,
+) {
+    enqueue(move || {
+        if let Some(window) = host::platform().and_then(|p| p.primary_window()) {
+            window.set_ime_visible_height(visible_bottom);
+        }
+    });
+}
+
+enum Edit {
+    Commit(String, i32),
+    Compose(String, i32),
+    Finish,
+    Delete {
+        before: usize,
+        after: usize,
+        code_points: bool,
+    },
+    Select(Range<usize>),
+    Mark(Range<usize>),
+}
+
+impl Edit {
+    fn apply(self, input: &mut PlatformInputHandler) {
+        let Some(selection) = input.selected_text_range(false).map(|s| s.range) else {
+            return;
+        };
+        match self {
+            Self::Commit(text, cursor) => {
+                let start = input.marked_text_range().unwrap_or(selection).start;
+                input.replace_text_in_range(None, &text);
+                if cursor != 1 {
+                    place_cursor(input, start, &text, cursor);
+                }
+            }
+            Self::Compose(text, cursor) => {
+                let start = input.marked_text_range().unwrap_or(selection).start;
+                input.replace_and_mark_text_in_range(None, &text, None);
+                if cursor != 1 {
+                    place_cursor(input, start, &text, cursor);
+                }
+            }
+            Self::Finish => input.unmark_text(),
+            Self::Delete {
+                before,
+                after,
+                code_points,
+            } => {
+                delete_around(input, selection, before, after, code_points);
+            }
+            Self::Select(range) => input.set_selected_text_range(range),
+            Self::Mark(range) => {
+                let length = input.text_length_utf16().unwrap_or(range.end);
+                let range = range.start.min(length)..range.end.min(length);
+                if range.is_empty() {
+                    input.unmark_text();
+                    return;
+                }
+                let mut adjusted = None;
+                if let Some(text) = input.text_for_range(range, &mut adjusted) {
+                    input.replace_and_mark_text_in_range(adjusted, &text, None);
+                    input.set_selected_text_range(selection);
+                }
+            }
+        }
+    }
+}
+
+fn place_cursor(input: &mut PlatformInputHandler, start: usize, text: &str, cursor: i32) {
+    // Android counts positive offsets from the end of the inserted text (1 is
+    // just after it) and non-positive offsets from the start.
+    let offset = if cursor > 0 {
+        start
+            .saturating_add(text.encode_utf16().count())
+            .saturating_add(cursor as usize - 1)
+    } else {
+        start.saturating_sub(cursor.unsigned_abs() as usize)
+    };
+    input.set_selected_text_range(offset..offset);
+}
+
+fn delete_around(
+    input: &mut PlatformInputHandler,
+    selection: Range<usize>,
+    before: usize,
+    after: usize,
+    code_points: bool,
+) {
+    let mut protected = selection.clone();
+    if let Some(marked) = input.marked_text_range() {
+        protected.start = protected.start.min(marked.start);
+        protected.end = protected.end.max(marked.end);
+    }
+    let scale = if code_points { 2 } else { 1 };
+    let limit = input.text_length_utf16().unwrap_or(usize::MAX);
+    let (mut start, mut end) = (protected.start, protected.end);
+    if before > 0 {
+        let span = protected.start.saturating_sub(before.saturating_mul(scale))..protected.start;
+        let mut adjusted = None;
+        if let Some(text) = input.text_for_range(span, &mut adjusted) {
+            start = if code_points {
+                let units = text
+                    .chars()
+                    .rev()
+                    .take(before)
+                    .map(char::len_utf16)
+                    .sum::<usize>();
+                protected.start.saturating_sub(units)
+            } else {
+                adjusted.map_or(protected.start, |r| r.start)
+            };
+        }
+    }
+    if after > 0 {
+        let span = protected.end
+            ..protected
+                .end
+                .saturating_add(after.saturating_mul(scale))
+                .min(limit);
+        let mut adjusted = None;
+        if let Some(text) = input.text_for_range(span, &mut adjusted) {
+            end = if code_points {
+                protected.end + text.chars().take(after).map(char::len_utf16).sum::<usize>()
+            } else {
+                adjusted.map_or(protected.end, |r| r.end)
+            };
+        }
+    }
+    if start == protected.start && end == protected.end {
+        return;
+    }
+    input.unmark_text();
+    if end > protected.end {
+        input.replace_text_in_range(Some(protected.end..end), "");
+    }
+    if start < protected.start {
+        input.replace_text_in_range(Some(start..protected.start), "");
+    }
+    let removed = protected.start - start;
+    input.set_selected_text_range(selection.start - removed..selection.end - removed);
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_gpui_mobile_GpuiImeView_editIme(
+    mut env: EnvUnowned<'_>,
+    _class: JObject<'_>,
+    id: jlong,
+    operation: jint,
+    first: jint,
+    second: jint,
+    text: JString<'_>,
+) -> jboolean {
+    let range = || first.min(second).max(0) as usize..first.max(second).max(0) as usize;
+    let edit = match operation {
+        0 | 1 => {
+            let Some(text) = env
+                .with_env(|env| text.try_to_string(env).map(Some))
+                .resolve::<LogErrorAndDefault>()
+            else {
+                return false;
+            };
+            if operation == 0 {
+                Edit::Commit(text, first)
+            } else {
+                Edit::Compose(text, first)
+            }
+        }
+        2 => Edit::Finish,
+        3 | 4 => Edit::Delete {
+            before: first.max(0) as usize,
+            after: second.max(0) as usize,
+            code_points: operation == 4,
+        },
+        5 => Edit::Select(range()),
+        6 => Edit::Mark(range()),
+        _ => return false,
+    };
+    enqueue(move || {
+        with_handler(id, |input| edit.apply(input));
+    })
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn Java_dev_gpui_mobile_GpuiImeView_keyIme(
+    _env: *mut jni::sys::JNIEnv,
+    _class: jobject,
+    id: jlong,
+    key_code: jint,
+    action: jint,
+    meta_state: jint,
+    unicode: jint,
+) -> jboolean {
+    enqueue(move || {
+        let Some(window) = host::platform().and_then(|p| p.primary_window()) else {
+            return;
+        };
+        if session_for_window(window.id()) == Some(id) {
+            window.handle_key_event(AndroidKeyEvent {
+                key_code,
+                action,
+                meta_state,
+                unicode_char: unicode as u32,
+            });
+        }
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_gpui_mobile_GpuiImeView_readIme<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JObject<'local>,
+    id: jlong,
+    before: jint,
+    after: jint,
+    offsets: JIntArray<'local>,
+) -> JString<'local> {
+    const CONTEXT: usize = 2048;
+    let (send, receive) = mpsc::sync_channel(1);
+    if !enqueue(move || {
+        let snapshot = with_handler(id, |input| {
+            let selection = input.selected_text_range(false)?.range;
+            // Bound queries so an IME cannot cause a copy of an entire script.
+            if selection.len() > CONTEXT {
+                return None;
+            }
+            let start = selection
+                .start
+                .saturating_sub(before.clamp(0, CONTEXT as i32) as usize);
+            let end = selection
+                .end
+                .saturating_add(after.clamp(0, CONTEXT as i32) as usize)
+                .min(input.text_length_utf16().unwrap_or(usize::MAX));
+            let mut adjusted = None;
+            let text = input.text_for_range(start..end, &mut adjusted)?;
+            let start = adjusted.map_or(start, |r| r.start);
+            let local_start = selection.start.checked_sub(start)?;
+            let local_end = selection.end.checked_sub(start)?;
+            (local_start <= local_end && local_end <= text.encode_utf16().count()).then_some((
+                text,
+                [start as i32, selection.start as i32, selection.end as i32],
+            ))
+        })
+        .flatten();
+        let _ = send.send(snapshot);
+    }) {
+        return JString::null();
+    }
+
+    // InputConnection's context getters are synchronous. Never wait
+    // indefinitely on a frame, native surface resize or Activity shutdown.
+    let Ok(Some((text, selection))) = receive.recv_timeout(Duration::from_millis(60)) else {
+        return JString::null();
+    };
+    env.with_env(|env| -> jni::errors::Result<_> {
+        offsets.set_region(env, 0, &selection)?;
+        env.new_string(text)
+    })
+    .resolve::<LogErrorAndDefault>()
+}
