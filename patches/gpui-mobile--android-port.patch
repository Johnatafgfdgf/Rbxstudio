+++ b/src/android/services.rs
@@ -0,0 +1,145 @@
+//! Host services that need the application's Android manifest / Keystore.
+use super::jni::{self, JniExt};
+use ::jni::objects::JValue;
+
+/// Resolve or open an experience in the Android Roblox application.
+pub fn roblox_link(place: u64, launch: bool) -> anyhow::Result<i32> {
+    let place = i64::try_from(place)?;
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioRoblox")?;
+        env.call_static_method(
+            &class,
+            ::jni::jni_str!("openPlace"),
+            ::jni::jni_sig!("(Landroid/app/Activity;JZ)I"),
+            &[JValue::Object(&activity), JValue::Long(place), JValue::Bool(launch)],
+        ).and_then(|value| value.i()).map_err(|_| {
+            env.exception_clear();
+            "O Android não conseguiu verificar o link do Roblox".to_owned()
+        })
+    }).map_err(anyhow::Error::msg)
+}
+
+/// Control only the app's own, non-exported original Rook player activity.
+pub fn player_control(operation: &str, path: &std::path::Path) -> anyhow::Result<bool> {
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioPlayer")?;
+        let result = match operation {
+            "start" => {
+                let path = env.new_string(path.to_string_lossy()).e()?;
+                env.call_static_method(&class, ::jni::jni_str!("start"),
+                    ::jni::jni_sig!("(Landroid/app/Activity;Ljava/lang/String;)V"),
+                    &[JValue::Object(&activity), JValue::Object(&path)]).map(|_| true)
+            }
+            "stop" => env.call_static_method(&class, ::jni::jni_str!("stop"),
+                ::jni::jni_sig!("(Landroid/app/Activity;)V"), &[JValue::Object(&activity)]).map(|_| false),
+            "alive" => env.call_static_method(&class, ::jni::jni_str!("alive"),
+                ::jni::jni_sig!("(Landroid/app/Activity;)Z"), &[JValue::Object(&activity)]).and_then(|v| v.z()),
+            _ => return Err("Operação do player inválida".into()),
+        };
+        result.map_err(|_| {
+            env.exception_clear();
+            "O Android não conseguiu controlar a sessão de Play local".to_owned()
+        })
+    }).map_err(anyhow::Error::msg)
+}
+
+pub fn resource_paths() -> anyhow::Result<String> {
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioServices")?;
+        let value = env.call_static_method(&class, ::jni::jni_str!("resourcePaths"),
+            ::jni::jni_sig!("(Landroid/app/Activity;)Ljava/lang/String;"), &[JValue::Object(&activity)])
+            .and_then(|v| v.l()).map_err(|_| {
+                env.exception_clear();
+                "O Android não conseguiu localizar os recursos instalados".to_owned()
+            })?;
+        Ok(jni::get_string(env, &value))
+    }).map_err(anyhow::Error::msg)
+}
+
+fn credential(operation: &str, service: &str, username: &str, password: &[u8]) -> anyhow::Result<Option<String>> {
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioServices")?;
+        let operation = env.new_string(operation).e()?;
+        let service = env.new_string(service).e()?;
+        let username = env.new_string(username).e()?;
+        let password = env.new_string(hex(password)).e()?;
+        let value = env.call_static_method(&class, ::jni::jni_str!("credential"),
+            ::jni::jni_sig!("(Landroid/app/Activity;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;"),
+            &[JValue::Object(&activity), JValue::Object(&operation), JValue::Object(&service),
+                JValue::Object(&username), JValue::Object(&password)])
+            .and_then(|v| v.l()).map_err(|_| {
+                // Do not describe Java exceptions: a provider may include secrets.
+                env.exception_clear();
+                "O Android não conseguiu acessar o armazenamento seguro de credenciais".to_owned()
+            })?;
+        Ok((!value.is_null()).then(|| jni::get_string(env, &value)))
+    }).map_err(anyhow::Error::msg)
+}
+
+pub fn write_credentials(service: &str, username: &str, password: &[u8]) -> anyhow::Result<()> {
+    credential("write", service, username, password).map(|_| ())
+}
+
+pub fn read_credentials(service: &str) -> anyhow::Result<Option<(String, Vec<u8>)>> {
+    credential("read", service, "", &[])?.map(|packed| {
+        let (username, password) = packed.split_once(':').ok_or_else(|| anyhow::anyhow!("Invalid credential encoding"))?;
+        Ok((String::from_utf8(unhex(username)?)?, unhex(password)?))
+    }).transpose()
+}
+
+pub fn delete_credentials(service: &str) -> anyhow::Result<()> {
+    credential("delete", service, "", &[]).map(|_| ())
+}
+
+fn hex(bytes: &[u8]) -> String {
+    const ALPHABET: &[u8] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for &byte in bytes { out.push(ALPHABET[(byte >> 4) as usize] as char); out.push(ALPHABET[(byte & 15) as usize] as char); }
+    out
+}
+
+fn unhex(value: &str) -> anyhow::Result<Vec<u8>> {
+    anyhow::ensure!(value.len() % 2 == 0, "Invalid credential encoding");
+    value.as_bytes().chunks_exact(2).map(|p| {
+        let a = (p[0] as char).to_digit(16).ok_or_else(|| anyhow::anyhow!("Invalid credential encoding"))?;
+        let b = (p[1] as char).to_digit(16).ok_or_else(|| anyhow::anyhow!("Invalid credential encoding"))?;
+        Ok(((a << 4) | b) as u8)
+    }).collect()
+}
+
+pub fn localize_document(address: &str, creating: bool) -> anyhow::Result<std::path::PathBuf> {
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioDocuments")?;
+        let address = env.new_string(address).e()?;
+        let value = env.call_static_method(&class, ::jni::jni_str!("localize"),
+            ::jni::jni_sig!("(Landroid/app/Activity;Ljava/lang/String;Z)Ljava/lang/String;"),
+            &[JValue::Object(&activity), JValue::Object(&address), JValue::Bool(creating)])
+            .and_then(|v| v.l()).map_err(|_| {
+                env.exception_clear();
+                "O Android não conseguiu abrir o documento selecionado".to_owned()
+            })?;
+        if value.is_null() { return Err("O Android não retornou um caminho para o documento".into()); }
+        Ok(std::path::PathBuf::from(jni::get_string(env, &value)))
+    }).map_err(anyhow::Error::msg)
+}
+
+pub fn commit_document(path: &std::path::Path) -> anyhow::Result<()> {
+    jni::with_env(|env| {
+        let activity = jni::activity(env)?;
+        let class = jni::find_app_class(env, "com.rbxnative.androidport.StudioDocuments")?;
+        let path = env.new_string(path.to_string_lossy()).e()?;
+        env.call_static_method(&class, ::jni::jni_str!("commit"),
+            ::jni::jni_sig!("(Landroid/app/Activity;Ljava/lang/String;)V"),
+            &[JValue::Object(&activity), JValue::Object(&path)])
+            .map_err(|_| {
+                env.exception_clear();
+                "O Android não conseguiu gravar o documento no destino escolhido; a cópia local foi preservada".to_owned()
+            })?;
+        Ok(())
+    }).map_err(anyhow::Error::msg)
+}
